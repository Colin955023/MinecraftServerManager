<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MinecraftServerManager</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>$(RepoRoot)assets\icon.ico</ApplicationIcon>
    <Product>Minecraft Server Manager</Product>
    <Company>Colin955023</Company>
    <Copyright>Copyright (C) 2025-2026 Colin955023</Copyright>
    <SatelliteResourceLanguages>zh-TW</SatelliteResourceLanguages>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <UseSharedCompilation>false</UseSharedCompilation>
    <MvvmToolkitEnableINotifyPropertyChangingSupport>false</MvvmToolkitEnableINotifyPropertyChangingSupport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>none</DebugType>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetricsSupport>false</MetricsSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MinecraftServerManager.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MinecraftServerManager.Core\MinecraftServerManager.Core.csproj" />
    <ProjectReference
      Include="..\MinecraftServerManager.Infrastructure\MinecraftServerManager.Infrastructure.csproj" />
  </ItemGroup>
  <!-- XAML 編譯器重複加入 .g.cs，僅對其去重以免 MSBuildWorkspace 警告並保留其他項目中繼資料 -->
  <Target Name="DeduplicateXamlGeneratedCompileItems"
    BeforeTargets="CoreCompile"
    DependsOnTargets="DesignTimeMarkupCompilation;IncludeGeneratedXamlCompileItemsForDesignTime">
    <ItemGroup>
      <_XamlGeneratedCompile Include="@(Compile)"
        Condition="$([System.String]::Copy('%(Identity)').EndsWith('.g.cs', StringComparison.OrdinalIgnoreCase)) or $([System.String]::Copy('%(Identity)').EndsWith('.g.i.cs', StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_XamlGeneratedCompile->'%(FullPath)')">
      <Output TaskParameter="Filtered" ItemName="_UniqueXamlGeneratedCompile" />
    </RemoveDuplicates>
    <ItemGroup>
      <Compile Remove="@(_XamlGeneratedCompile)" />
      <Compile Include="@(_UniqueXamlGeneratedCompile)" />
      <_XamlGeneratedCompile Remove="@(_XamlGeneratedCompile)" />
      <_UniqueXamlGeneratedCompile Remove="@(_UniqueXamlGeneratedCompile)" />
    </ItemGroup>
  </Target>
  <!-- 單檔打包前移除實測從未載入的檔案 -->
  <Target Name="PruneUnusedSingleFilePayload" BeforeTargets="_ComputeFilesToBundle">
    <PropertyGroup>
      <_UnusedPayload>
        ;WebView2Loader.dll
        ;Microsoft.Web.WebView2.Core.dll
        ;Microsoft.WindowsAppRuntime.Bootstrap.dll
        ;Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll
        ;PushNotificationsLongRunningTask.ProxyStub.dll
        ;RestartAgent.exe
        ;map.html
        ;Microsoft.UI.Xaml.Controls.pri
        ;packages.lock.json
        ;app.manifest
        ;Microsoft.UI.Xaml.Phone.dll.mui
        ;Microsoft.UI.Designer.dll
        ;DwmSceneI.dll
        ;Microsoft.Graphics.Display.dll
        ;
      </_UnusedPayload>
      <_UnusedPayload>$([System.Text.RegularExpressions.Regex]::Replace('$(_UnusedPayload)', '\s+',
        ''))</_UnusedPayload>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$(_UnusedPayload.Contains(';%(Filename)%(Extension);', StringComparison.OrdinalIgnoreCase))" />
      <!-- 型別中繼資料已編入組件、XAML 已編為 .pri 內的 XBF -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(Extension)').Equals('.winmd', StringComparison.OrdinalIgnoreCase)) or $([System.String]::Copy('%(Extension)').Equals('.xaml', StringComparison.OrdinalIgnoreCase))" />
      <!-- 只留 zh-TW 語系資源 -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(Extension)').Equals('.mui', StringComparison.OrdinalIgnoreCase)) and !$([System.String]::Copy('%(RelativePath)').Replace('/', '\').StartsWith('zh-TW\', StringComparison.OrdinalIgnoreCase))" />
    </ItemGroup>
  </Target>
</Project>
