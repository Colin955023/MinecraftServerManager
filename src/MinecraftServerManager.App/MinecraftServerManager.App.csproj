<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MinecraftServerManager</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>$(RepoRoot)assets\icon.ico</ApplicationIcon>
    <Product>Minecraft Server Manager</Product>
    <Company>Colin955023</Company>
    <Copyright>GPL-3.0 License</Copyright>
    <SatelliteResourceLanguages>zh-TW</SatelliteResourceLanguages>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKSingleFileVerifyConfiguration>false</WindowsAppSDKSingleFileVerifyConfiguration>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <UseSharedCompilation>false</UseSharedCompilation>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetricsSupport>false</MetricsSupport>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <StartupHookSupport>false</StartupHookSupport>
    <CustomResourceTypesSupport>false</CustomResourceTypesSupport>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MinecraftServerManager.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MinecraftServerManager.Core\MinecraftServerManager.Core.csproj" />
    <ProjectReference
      Include="..\MinecraftServerManager.Infrastructure\MinecraftServerManager.Infrastructure.csproj" />
  </ItemGroup>
  <!-- 消除 WinUI 3 XAML 編譯器於 MarkupCompilePass1、MarkupCompilePass2 與
  IncludeGeneratedXamlCompileItemsForDesignTime 重複將 .g.i.cs / .g.cs 加入 @(Compile) 導致 Roslyn
  MSBuildWorkspace 警告 -->
  <Target Name="DeduplicateXamlGeneratedCompileItems"
    BeforeTargets="CoreCompile"
    DependsOnTargets="DesignTimeMarkupCompilation;IncludeGeneratedXamlCompileItemsForDesignTime">
    <RemoveDuplicates Inputs="@(Compile->'%(FullPath)')">
      <Output TaskParameter="Filtered" ItemName="_FilteredCompile" />
    </RemoveDuplicates>
    <ItemGroup>
      <Compile Remove="@(Compile)" />
      <Compile Include="@(_FilteredCompile)" />
      <_FilteredCompile Remove="@(_FilteredCompile)" />
    </ItemGroup>
  </Target>
  <!-- 發布單一檔案前精簡移除未使用的巨型 AI / ML 模組、小工具與多餘語系 MUI 資源 -->
  <Target Name="FilterWindowsAppSdkComponents"
    BeforeTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup>
      <WindowsAppSdkComponentPackages Remove="@(WindowsAppSdkComponentPackages)"
        Condition="$([System.String]::Copy('%(Identity)').ToLowerInvariant().Contains('microsoft.windowsappsdk.ai')) or
                   $([System.String]::Copy('%(Identity)').ToLowerInvariant().Contains('microsoft.windowsappsdk.ml')) or
                   $([System.String]::Copy('%(Identity)').ToLowerInvariant().Contains('microsoft.windowsappsdk.search')) or
                   $([System.String]::Copy('%(Identity)').ToLowerInvariant().Contains('microsoft.windowsappsdk.widgets'))" />
    </ItemGroup>
  </Target>
  <Target Name="FilterUnusedMuiFiles"
    AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromComponents">
    <ItemGroup>
      <None Remove="@(None)"
        Condition="'%(None.Extension)' == '.mui' and
                   '%(None.Link)' != '' and
                   !$([System.String]::Copy('%(None.Link)').StartsWith('zh-TW'))" />
    </ItemGroup>
  </Target>
  <!-- 發布單一檔案前精簡移除未使用的巨型 AI / ML 模組與 WebView2 原生組件 -->
  <Target Name="PruneUnusedSingleFilePayload" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Filename)%(Extension)' == 'DirectML.dll' or
                   '%(Filename)%(Extension)' == 'onnxruntime.dll' or
                   '%(Filename)%(Extension)' == 'Microsoft.Windows.AI.MachineLearning.dll' or
                   '%(Filename)%(Extension)' == 'Microsoft.ML.OnnxRuntime.dll' or
                   '%(Filename)%(Extension)' == 'System.Numerics.Tensors.dll' or
                   '%(Filename)%(Extension)' == 'WebView2Loader.dll' or
                   '%(Filename)%(Extension)' == 'Microsoft.Web.WebView2.Core.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.mui' and
                   '%(RelativePath)' != '' and
                   !$([System.String]::Copy('%(RelativePath)').StartsWith('zh-TW'))" />
    </ItemGroup>
  </Target>
</Project>