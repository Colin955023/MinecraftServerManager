<ResourceDictionary
  x:Class="MinecraftServerManager.App.Resources.ConsoleLogResources"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 主控台日誌列範本（x:Bind 需具程式碼後置的資源字典） -->
  <DataTemplate x:Key="ConsoleLogItemTemplate"
    x:DataType="x:String">
    <TextBlock Text="{x:Bind}"
      FontFamily="{StaticResource ConsoleFontFamily}"
      FontSize="{StaticResource CaptionTextBlockFontSize}"
      Foreground="{StaticResource ConsoleForegroundBrush}"
      TextWrapping="NoWrap"
      IsTextSelectionEnabled="True"
      Padding="2,1" />
  </DataTemplate>
</ResourceDictionary>
