<Window x:Class="MinecraftServerManager.App.Views.ExportModListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="匯出模組清單"
        Width="440"
        Height="310"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}"
        Icon="pack://application:,,,/MinecraftServerManager.App;component/assets/icon.ico">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 標題 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="選擇匯出格式" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
      <TextBlock Text="請選擇欲匯出的模組清單檔案格式："
                 Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
    </StackPanel>

    <!-- 格式選項清單 -->
    <StackPanel Grid.Row="1" Margin="0,0,0,16">
      <RadioButton x:Name="TxtRadio" Content="純文字格式 (*.txt) — 適合快速檢閱與純文字備份"
                   IsChecked="True" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />
      <RadioButton x:Name="JsonRadio" Content="JSON 格式 (*.json) — 包含完整中繼資料與雜湊值"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />
      <RadioButton x:Name="HtmlRadio" Content="HTML 網頁報表 (*.html) — 具備視覺樣式之獨立表格"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />
      <RadioButton x:Name="XlsxRadio" Content="Excel 工作表 (*.xlsx) — 適用於電子試算表軟體"
                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />
    </StackPanel>

    <!-- 底部按鈕區 -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Click="Cancel_Click" Margin="0,0,10,0" Padding="16,6" />
      <Button Content="儲存並匯出" Click="Export_Click" Style="{DynamicResource PrimaryButtonStyle}" Padding="20,6" />
    </StackPanel>
  </Grid>
</Window>
