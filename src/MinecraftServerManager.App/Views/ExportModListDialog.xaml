<ContentDialog x:Class="MinecraftServerManager.App.Views.ExportModListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="選擇匯出格式"
    PrimaryButtonText="儲存並匯出"
    CloseButtonText="取消"
    DefaultButton="Primary">

    <StackPanel Spacing="16"
        MinWidth="380">
        <TextBlock Text="請選擇欲匯出的模組清單檔案格式："
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}" />

        <StackPanel Spacing="10">
            <RadioButton x:Name="TxtRadio"
                Content="純文字格式 (*.txt) — 適合快速檢閱與純文字備份"
                IsChecked="True" />
            <RadioButton x:Name="JsonRadio"
                Content="JSON 格式 (*.json) — 包含完整中繼資料與雜湊值" />
            <RadioButton x:Name="HtmlRadio"
                Content="HTML 網頁報表 (*.html) — 具備視覺樣式之獨立表格" />
            <RadioButton x:Name="XlsxRadio"
                Content="Excel 工作表 (*.xlsx) — 適用於電子試算表軟體" />
        </StackPanel>
    </StackPanel>
</ContentDialog>