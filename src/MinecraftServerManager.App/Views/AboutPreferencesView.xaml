<UserControl x:Class="MinecraftServerManager.App.Views.AboutPreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MinecraftServerManager.App.ViewModels">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <!-- 左右分欄佈局 -->
    <Grid Margin="12,4,16,24">
      <Grid.ColumnDefinitions>
        <!-- 左欄：關於程式 -->
        <ColumnDefinition Width="*" />
        <!-- 中間垂直分隔線 -->
        <ColumnDefinition Width="Auto" />
        <!-- 右欄：視窗偏好設定 -->
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左欄：關於程式 -->
      <StackPanel Grid.Column="0" Margin="10,0,24,0">
        <TextBlock Text="🎮 Minecraft Server Manager"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="0,0,0,6" />
        <TextBlock Text="{Binding AppDescription}"
                   FontSize="14"
                   Foreground="{DynamicResource MutedTextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4" />
        <TextBlock Text="版本 2.0.0"
                   FontSize="13"
                   Foreground="{DynamicResource MutedTextBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18" />

        <!-- 開發資訊 -->
        <TextBlock Text="👨‍💻 開發資訊" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="• 開發者: Colin955023" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
            <TextBlock Text="• 技術堆疊: .NET 10 (WPF), C# 14" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
            <TextBlock Text="• Java 管理: 自動偵測 Java，支援 Windows 註冊表與環境變數" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
            <TextBlock Text="• 架構: 分層模組化設計、MVVM" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
            <TextBlock Text="• 參考專案: PrismLauncher" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
          </StackPanel>
        </Border>

        <!-- GitHub 連結 -->
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Margin="0,0,0,14">
          <TextBlock FontSize="13">
            <Hyperlink Command="{Binding OpenGithubCommand}" Foreground="{DynamicResource AccentBrush}">
              GitHub - Minecraft Server Manager
            </Hyperlink>
          </TextBlock>
        </Border>

        <!-- 授權條款 -->
        <TextBlock Text="📄 授權條款" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="• 本專案採用 GNU General Public License v3.0 授權條款" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
            <TextBlock Text="• 部分設計理念參考 PrismLauncher" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
            <TextBlock Text="• 可依 GPLv3 條款使用、修改與散布" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
            <TextBlock Text="• 請遵守 Minecraft EULA 和當地法律法規" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
            <TextBlock Text="特別感謝 PrismLauncher 開發團隊的開源貢獻！" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <!-- 更新設定 -->
        <TextBlock Text="🔄 更新設定" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
        <TextBlock Text="更新檔僅接受 GitHub Release 提供的 SHA-256 digest 驗證"
                   FontSize="12"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Margin="0,0,0,8" />
        <CheckBox Content="自動檢查更新"
                  IsChecked="{Binding IsAutoUpdateEnabled}"
                  Foreground="{DynamicResource TextBrush}"
                  Margin="0,0,0,10" />
        <Button Content="檢查更新"
                Command="{Binding CheckForUpdatesCommand}"
                Visibility="{Binding IsManualCheckVisible, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Left"
                Width="100"
                Height="32" />
      </StackPanel>

      <!-- 中間垂直分隔線 -->
      <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="0,8" />

      <!-- 右欄：視窗偏好設定 -->
      <StackPanel Grid.Column="2" Margin="24,0,10,0">
        <TextBlock Text="🖥️ 視窗偏好設定"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}"
                   Margin="0,0,0,24" />

        <!-- 主視窗設定 -->
        <TextBlock Text="🏠 主視窗設定" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
        <Border Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,10"
                Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="{Binding ScreenResolutionInfo}" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
            <TextBlock Text="{Binding CurrentWindowSizeInfo}" Foreground="{DynamicResource TextBrush}" Margin="0,2" />
          </StackPanel>
        </Border>
        <Button Content="重設為預設大小"
                Command="{Binding ResetToDefaultSizeCommand}"
                Style="{DynamicResource DangerButtonStyle}"
                HorizontalAlignment="Left"
                Padding="14,6"
                Height="32"
                Margin="0,0,0,20" />

        <!-- 顯示設定 -->
        <TextBlock Text="🎨 顯示設定" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10" />
        <Grid Margin="0,0,0,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="主題模式:" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,0,12,0" />
          <ComboBox Grid.Column="1"
                    SelectedIndex="{Binding SelectedThemeModeIndex}"
                    ItemsSource="{x:Static vm:AboutPreferencesViewModel.ThemeModes}"
                    Width="160"
                    HorizontalAlignment="Left" />
        </Grid>

        <!-- 底部偏好設定操作按鈕 (恢復預設) -->
        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,20" />
        <Button Content="恢復預設"
                Command="{Binding ResetAllSettingsCommand}"
                Style="{DynamicResource DangerButtonStyle}"
                HorizontalAlignment="Left"
                MinWidth="100"
                Height="34" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
