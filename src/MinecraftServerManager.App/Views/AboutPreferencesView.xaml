<UserControl x:Class="MinecraftServerManager.App.Views.AboutPreferencesView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  xmlns:views="using:MinecraftServerManager.App.Views"
  mc:Ignorable="d">

  <ScrollViewer VerticalScrollBarVisibility="Auto"
    HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,16,24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0"
        Margin="10,0,24,0">
        <TextBlock Text="Minecraft Server Manager"
          FontSize="{StaticResource SubtitleTextBlockFontSize}"
          FontWeight="Bold"
          HorizontalAlignment="Center"
          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
          Margin="0,0,0,6" />
        <TextBlock Text="{x:Bind vm:AboutPreferencesViewModel.AppDescription}"
          FontSize="{StaticResource BodyTextBlockFontSize}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          HorizontalAlignment="Center"
          Margin="0,0,0,4" />
        <TextBlock
          Text="{x:Bind views:AboutPreferencesView.FormatVersion(vm:AboutPreferencesViewModel.AppVersion)}"
          FontSize="{StaticResource BodyTextBlockFontSize}"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          HorizontalAlignment="Center"
          Margin="0,0,0,18" />

        <TextBlock Text="開發資訊"
          Style="{StaticResource SectionHeaderTextStyle}"
          Margin="0,0,0,8" />
        <Border Style="{StaticResource CardBorderStyle}"
          Margin="0,0,0,14">
          <StackPanel>
            <TextBlock
              Text="{x:Bind views:AboutPreferencesView.FormatAuthor(vm:AboutPreferencesViewModel.AppAuthor)}"
              Style="{StaticResource BulletTextStyle}" />
            <TextBlock
              Text="{x:Bind views:AboutPreferencesView.FormatFramework(vm:AboutPreferencesViewModel.AppTargetFramework)}"
              Style="{StaticResource BulletTextStyle}" />
            <TextBlock Text="• Java 管理：自動偵測 Java，支援 Windows 登錄檔與環境變數"
              Style="{StaticResource BulletTextStyle}" />
            <TextBlock Text="• 架構：分層模組化設計、MVVM"
              Style="{StaticResource BulletTextStyle}" />
            <TextBlock Text="• 參考專案：PrismLauncher"
              Style="{StaticResource BulletTextStyle}" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}"
          Margin="0,0,0,14">
          <HyperlinkButton Content="GitHub - Minecraft Server Manager"
            Command="{x:Bind ViewModel.OpenGithubCommand}"
            Padding="0" />
        </Border>

        <TextBlock Text="授權條款"
          Style="{StaticResource SectionHeaderTextStyle}"
          Margin="0,0,0,8" />
        <Border Style="{StaticResource CardBorderStyle}"
          Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="• Copyright (C) 2025-2026 Colin955023"
              Style="{StaticResource BulletTextStyle}" />
            <TextBlock Text="• 本專案採用 GNU General Public License v3.0（僅限第 3 版）授權條款"
              Style="{StaticResource BulletTextStyle}" />
            <TextBlock Text="• 本程式不提供任何擔保（詳見 GPLv3 第 15、16 條）"
              Style="{StaticResource BulletTextStyle}" />
            <TextBlock Text="• 可依 GPLv3 條款使用、修改與散布"
              Style="{StaticResource BulletTextStyle}" />
            <TextBlock Text="• 版本比較引擎（FlexVersion）移植自 Prism Launcher（GPL-3.0-only），版權聲明見 COPYING.md"
              Style="{StaticResource BulletTextStyle}"
              TextWrapping="Wrap" />
            <HyperlinkButton Content="檢視 GPLv3 授權全文"
              Command="{x:Bind ViewModel.OpenLicenseCommand}"
              Padding="0"
              Margin="0,2" />
            <TextBlock Text="• 請遵守 Minecraft EULA 和相關法令"
              Style="{StaticResource BulletTextStyle}" />
            <TextBlock Text="特別感謝 Prism Launcher 開發團隊的開放原始碼貢獻！"
              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
              Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <TextBlock Text="更新設定"
          Style="{StaticResource SectionHeaderTextStyle}"
          Margin="0,0,0,6" />
        <TextBlock Text="更新檔僅接受 GitHub Release 提供的 SHA-256 digest 驗證"
          Style="{StaticResource SecondaryCaptionTextStyle}"
          TextWrapping="Wrap"
          Margin="0,0,0,8" />
        <ToggleSwitch Header="自動檢查更新"
          IsOn="{x:Bind ViewModel.IsAutoUpdateEnabled, Mode=TwoWay}"
          Margin="0,0,0,10" />
        <Button Content="檢查更新"
          Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
          Visibility="{x:Bind ViewModel.IsManualCheckVisible, Mode=OneWay}"
          HorizontalAlignment="Left"
          Width="100" />
      </StackPanel>

      <Border Grid.Column="1"
        Width="1"
        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
        Margin="0,8" />

      <StackPanel Grid.Column="2"
        Margin="24,0,10,0">
        <TextBlock Text="視窗偏好設定"
          FontSize="{StaticResource SubtitleTextBlockFontSize}"
          FontWeight="Bold"
          HorizontalAlignment="Center"
          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
          Margin="0,0,0,24" />

        <TextBlock Text="主視窗設定"
          Style="{StaticResource SectionHeaderTextStyle}"
          Margin="0,0,0,8" />
        <Border Style="{StaticResource CardBorderStyle}"
          Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="{x:Bind ViewModel.ScreenResolutionInfo, Mode=OneWay}"
              Style="{StaticResource BulletTextStyle}" />
            <TextBlock Text="{x:Bind ViewModel.CurrentWindowSizeInfo, Mode=OneWay}"
              Style="{StaticResource BulletTextStyle}" />
          </StackPanel>
        </Border>
        <Button Content="重設為預設大小"
          Command="{x:Bind ViewModel.ResetToDefaultSizeCommand}"
          Style="{StaticResource DangerButtonStyle}"
          HorizontalAlignment="Left"
          Margin="0,0,0,20" />

        <TextBlock Text="顯示設定"
          Style="{StaticResource SectionHeaderTextStyle}"
          Margin="0,0,0,10" />
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
            Text="主題模式："
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            Margin="0,0,12,0" />
          <ComboBox Grid.Column="1"
            Width="160"
            HorizontalAlignment="Left"
            ItemsSource="{x:Bind ViewModel.ThemeModes}"
            SelectedIndex="{x:Bind ViewModel.SelectedThemeModeIndex, Mode=TwoWay}"
            AutomationProperties.Name="主題模式" />
        </Grid>

        <Border Style="{StaticResource CardBorderStyle}"
          Margin="0,0,0,24">
          <StackPanel Spacing="10">
            <TextBlock Text="強調色彩（按鈕與焦點色）："
              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
              FontWeight="SemiBold" />
            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="28"
                Height="28"
                CornerRadius="{StaticResource ControlCornerRadius}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Border.Background>
                  <SolidColorBrush Color="{x:Bind ViewModel.CurrentAccentColor, Mode=OneWay}" />
                </Border.Background>
              </Border>
              <TextBlock Grid.Column="1"
                Text="{x:Bind ViewModel.AccentColorSummaryText, Mode=OneWay}"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Grid>
            <controls:WrapPanel ItemSpacing="8"
              LineSpacing="8">
              <Button Padding="{StaticResource CompactButtonPadding}"
                VerticalContentAlignment="Center">
                <controls:IconLabel Icon="{StaticResource IconColor}"
                  Text="挑選自訂顏色" />
                <Button.Flyout>
                  <Flyout x:Name="AccentColorFlyout"
                    Opening="OnAccentColorFlyoutOpening">
                    <StackPanel Spacing="12"
                      Width="260">
                      <ColorPicker x:Name="AccentPicker"
                        Color="{x:Bind ViewModel.CurrentAccentColor, Mode=OneWay}"
                        IsColorSpectrumVisible="True"
                        IsColorPreviewVisible="True"
                        IsHexInputVisible="True"
                        IsAlphaEnabled="False"
                        AutomationProperties.Name="自訂強調色" />
                      <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                        <Button Content="套用"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Padding="{StaticResource CompactButtonPadding}"
                          Click="OnApplyAccentColorClicked" />
                        <Button Content="取消"
                          Padding="{StaticResource CompactButtonPadding}"
                          Click="OnCancelAccentColorClicked" />
                      </StackPanel>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Button Content="重設為系統強調色"
                Command="{x:Bind ViewModel.ResetAccentColorCommand}"
                Style="{StaticResource DangerButtonStyle}"
                Padding="{StaticResource CompactButtonPadding}"
                VerticalContentAlignment="Center" />
            </controls:WrapPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="備份設定"
          Style="{StaticResource SectionHeaderTextStyle}"
          Margin="0,0,0,10" />
        <ToggleSwitch Header="啟動伺服器前自動備份"
          IsOn="{x:Bind ViewModel.IsAutoBackupBeforeStartEnabled, Mode=TwoWay}"
          Margin="0,0,0,10" />
        <NumberBox Header="每台伺服器保留備份份數"
          Minimum="1"
          Maximum="100"
          SpinButtonPlacementMode="Inline"
          SmallChange="1"
          Width="160"
          HorizontalAlignment="Left"
          Value="{x:Bind ViewModel.BackupRetentionCount, Mode=TwoWay}" />
        <TextBlock Text="超過份數時自動刪除最舊的備份；需先為伺服器設定備份資料夾，自動備份才會執行。"
          Style="{StaticResource SecondaryCaptionTextStyle}"
          TextWrapping="Wrap"
          Margin="0,8,0,16" />

        <Border Height="1"
          Background="{ThemeResource DividerStrokeColorDefaultBrush}"
          Margin="0,0,0,20" />
        <Button Content="還原預設"
          Command="{x:Bind ViewModel.ResetAllSettingsCommand}"
          Style="{StaticResource DangerButtonStyle}"
          HorizontalAlignment="Left"
          MinWidth="100"
          VerticalContentAlignment="Center" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
