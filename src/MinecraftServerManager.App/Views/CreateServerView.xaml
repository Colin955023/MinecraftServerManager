<UserControl x:Class="MinecraftServerManager.App.Views.CreateServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MinecraftServerManager.App.ViewModels">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,16,24">
      <!-- 頂部標題 -->
      <TextBlock Text="建立新伺服器" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16" />

      <!-- EULA 條款提示 -->
      <Border Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14,10"
              Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Grid.Column="0" Source="{StaticResource IconWarning}" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1">
            <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="20">
              <Hyperlink Command="{Binding OpenEulaCommand}" Foreground="{DynamicResource AccentBrush}">
                <Run Text="請務必閱讀並同意 Minecraft EULA 條款 (點我閱讀)" />
                <LineBreak />
                <Run Text="點擊建立即表示你同意Minecraft條款，任何違法行為本軟體不負責任" />
              </Hyperlink>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 表單 Grid -->
      <Grid Margin="0,4,0,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 伺服器名稱 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="伺服器名稱:" VerticalAlignment="Center" Margin="0,8" Foreground="{DynamicResource TextBrush}" />
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                 Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,6,0,6" />

        <!-- Java 執行檔路徑 -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Java 執行檔路徑 (可選):" VerticalAlignment="Center" Margin="0,8" Foreground="{DynamicResource TextBrush}" />
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,6,8,6" />
        <Button Grid.Row="1" Grid.Column="2"
                Content="瀏覽..."
                Command="{Binding BrowseJavaCommand}"
                Width="72"
                Margin="0,6,8,6" />
        <Button Grid.Row="1" Grid.Column="3"
                Content="自動偵測"
                Command="{Binding AutoDetectJavaCommand}"
                IsEnabled="{Binding IsNotDetectingJava}"
                Width="85"
                Margin="0,6,0,6" />

        <!-- 模組載入器 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="模組載入器:" VerticalAlignment="Center" Margin="0,8" Foreground="{DynamicResource TextBrush}" />
        <ComboBox Grid.Row="2" Grid.Column="1"
                  ItemsSource="{Binding AvailableLoaders}"
                  SelectedItem="{Binding SelectedLoader}"
                  Margin="0,6,8,6" />

        <!-- 載入器版本 -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="載入器版本:" VerticalAlignment="Center" Margin="0,8" Foreground="{DynamicResource TextBrush}" />
        <ComboBox Grid.Row="3" Grid.Column="1"
                  ItemsSource="{Binding LoaderVersions}"
                  SelectedItem="{Binding SelectedLoaderVersion}"
                  IsEnabled="{Binding IsLoaderVersionEnabled}"
                  Margin="0,6,8,6" />
        <Button Grid.Row="3" Grid.Column="2"
                Command="{Binding ReloadLoaderVersionsCommand}"
                Width="42"
                Margin="0,6,0,6"
                ToolTip="重新載入載入器版本">
          <Image Source="{StaticResource IconRefresh}" Width="14" Height="14" />
        </Button>

        <!-- Minecraft 版本 -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Minecraft 版本:" VerticalAlignment="Center" Margin="0,8" Foreground="{DynamicResource TextBrush}" />
        <ComboBox Grid.Row="4" Grid.Column="1"
                  ItemsSource="{Binding AvailableMinecraftVersions}"
                  SelectedItem="{Binding SelectedMinecraftVersion}"
                  Margin="0,6,8,6" />
        <Button Grid.Row="4" Grid.Column="2"
                Command="{Binding ReloadMinecraftVersionsCommand}"
                Width="42"
                Margin="0,6,0,6"
                ToolTip="重新載入 Minecraft 版本">
          <Image Source="{StaticResource IconRefresh}" Width="14" Height="14" />
        </Button>

        <!-- 記憶體設定 (MB) -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="記憶體設定 (MB):" VerticalAlignment="Center" Margin="0,8" Foreground="{DynamicResource TextBrush}" />
        <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="最小記憶體:" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" />
            <TextBox Text="{Binding MinMemoryMb, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="最大記憶體:" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4" />
            <TextBox Text="{Binding MaxMemoryMb, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Grid>

        <!-- 記憶體說明與警告標籤 -->
        <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6">
          <TextBlock Text="最小記憶體選填，若留空由 Java 決定" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
          <TextBlock Text="最大記憶體(必須)建議：2048MB (預設) | 4096MB (一般) | 8192MB (多人遊戲)"
                     FontSize="11"
                     Foreground="{DynamicResource MutedTextBrush}"
                     Margin="0,2,0,0" />
          <TextBlock Text="{Binding MemoryWarningText}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Margin="0,6,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMemoryError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>

      <!-- JVM 啟動參數設定 -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,28" VerticalAlignment="Center">
        <TextBlock Text="JVM 啟動參數:" Width="170" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
        <Button Content="JVM 參數設定..."
                Command="{Binding ConfigureJvmArgsCommand}"
                Padding="12,6"
                Margin="0,0,12,0" />
        <TextBlock Text="{Binding JvmArgsSummary}"
                   Foreground="{DynamicResource MutedTextBrush}"
                   VerticalAlignment="Center"
                   FontSize="12" />
      </StackPanel>

      <!-- 底部操作按鈕 (重設表單、建立伺服器) -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="重設表單"
                Command="{Binding ResetFormCommand}"
                Style="{DynamicResource DangerButtonStyle}"
                MinWidth="100"
                Height="34"
                Margin="0,0,12,0" />
        <Button Content="建立伺服器"
                Command="{Binding CreateServerCommand}"
                Style="{DynamicResource PrimaryButtonStyle}"
                MinWidth="120"
                Height="34" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
