<UserControl
  x:Class="MinecraftServerManager.App.Views.CreateServerView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels"
  mc:Ignorable="d">

  <ScrollViewer VerticalScrollBarVisibility="Auto"
    HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,16,24">
      <!-- 頂部標題與狀態 -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
          Text="建立新伺服器"
          FontSize="26"
          FontWeight="Bold"
          Foreground="{ThemeResource TextBrush}"
          Margin="0,0,16,0"
          VerticalAlignment="Center" />
        <StackPanel Grid.Column="1"
          Orientation="Horizontal"
          VerticalAlignment="Center"
          Spacing="8">
          <ProgressBar IsIndeterminate="True"
            Width="80"
            Height="4"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoadingVersions, Mode=OneWay}" />
          <TextBlock Text="{x:Bind ViewModel.LoadingStatusText, Mode=OneWay}"
            FontSize="12"
            Foreground="{ThemeResource MutedTextBrush}"
            VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- EULA 條款提示 -->
      <Border Background="{ThemeResource CardBrush}"
        BorderBrush="{ThemeResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="14,10"
        Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:ColorIcon Grid.Column="0"
            Source="{StaticResource IconWarning}"
            Width="20"
            Height="20"
            Margin="0,0,12,0"
            VerticalAlignment="Top" />
          <StackPanel Grid.Column="1">
            <HyperlinkButton Command="{x:Bind ViewModel.OpenEulaCommand}"
              Padding="0"
              HorizontalAlignment="Left">
              <TextBlock FontSize="13"
                TextWrapping="Wrap"
                LineHeight="20">
                <Run Text="請務必閱讀並同意 Minecraft EULA 條款（點此閱讀）" />
                <LineBreak />
                <Run Text="點選建立即表示您同意 Minecraft 條款，任何違法行為本軟體不負責任" />
              </TextBlock>
            </HyperlinkButton>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 表單 Grid -->
      <Grid Margin="0,4,0,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="180" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 伺服器名稱 -->
        <TextBlock Grid.Row="0"
          Grid.Column="0"
          Text="伺服器名稱："
          VerticalAlignment="Center"
          Margin="0,8"
          Foreground="{ThemeResource TextBrush}" />
        <TextBox Grid.Row="0"
          Grid.Column="1"
          Grid.ColumnSpan="3"
          Text="{x:Bind ViewModel.ServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Margin="0,6,0,6"
          PlaceholderText="請輸入伺服器名稱 (例如 Survival)..." />

        <!-- Java 執行檔路徑 -->
        <TextBlock Grid.Row="1"
          Grid.Column="0"
          Text="Java 執行檔路徑（選填）："
          VerticalAlignment="Center"
          Margin="0,8"
          Foreground="{ThemeResource TextBrush}" />
        <TextBox Grid.Row="1"
          Grid.Column="1"
          Grid.ColumnSpan="2"
          Text="{x:Bind ViewModel.JavaPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Margin="0,6,8,6"
          PlaceholderText="留空則自動探測匹配版本..." />
        <Button Grid.Row="1"
          Grid.Column="3"
          Content="管理 Java"
          Command="{x:Bind ViewModel.OpenManageJavaCommand}"
          Width="95"
          Margin="0,6,0,6" />

        <!-- 模組載入器 -->
        <TextBlock Grid.Row="2"
          Grid.Column="0"
          Text="模組載入器："
          VerticalAlignment="Center"
          Margin="0,8"
          Foreground="{ThemeResource TextBrush}" />
        <ComboBox Grid.Row="2"
          Grid.Column="1"
          ItemsSource="{x:Bind ViewModel.AvailableLoaders, Mode=OneWay}"
          SelectedItem="{x:Bind ViewModel.SelectedLoader, Mode=TwoWay}"
          HorizontalAlignment="Stretch"
          Margin="0,6,8,6" />

        <!-- 載入器版本 -->
        <TextBlock Grid.Row="3"
          Grid.Column="0"
          Text="載入器版本："
          VerticalAlignment="Center"
          Margin="0,8"
          Foreground="{ThemeResource TextBrush}" />
        <ComboBox Grid.Row="3"
          Grid.Column="1"
          ItemsSource="{x:Bind ViewModel.LoaderVersions, Mode=OneWay}"
          SelectedItem="{x:Bind ViewModel.SelectedLoaderVersion, Mode=TwoWay}"
          IsEnabled="{x:Bind ViewModel.IsLoaderVersionEnabled, Mode=OneWay}"
          HorizontalAlignment="Stretch"
          Margin="0,6,8,6" />
        <Button Grid.Row="3"
          Grid.Column="2"
          Command="{x:Bind ViewModel.ReloadLoaderVersionsCommand}"
          Width="36"
          Height="32"
          Padding="0"
          Margin="0,6,0,6"
          ToolTipService.ToolTip="重新載入載入器版本">
          <controls:ColorIcon Source="{StaticResource IconRefresh}"
            Width="16"
            Height="16" />
        </Button>

        <!-- Minecraft 版本 -->
        <TextBlock Grid.Row="4"
          Grid.Column="0"
          Text="Minecraft 版本："
          VerticalAlignment="Center"
          Margin="0,8"
          Foreground="{ThemeResource TextBrush}" />
        <ComboBox Grid.Row="4"
          Grid.Column="1"
          ItemsSource="{x:Bind ViewModel.AvailableMinecraftVersions, Mode=OneWay}"
          SelectedItem="{x:Bind ViewModel.SelectedMinecraftVersion, Mode=TwoWay}"
          HorizontalAlignment="Stretch"
          Margin="0,6,8,6" />
        <Button Grid.Row="4"
          Grid.Column="2"
          Command="{x:Bind ViewModel.ReloadMinecraftVersionsCommand}"
          IsEnabled="{x:Bind ViewModel.IsMinecraftVersionReloadEnabled, Mode=OneWay}"
          Width="36"
          Height="32"
          Padding="0"
          Margin="0,6,0,6"
          ToolTipService.ToolTip="重新載入 Minecraft 版本">
          <controls:ColorIcon Source="{StaticResource IconRefresh}"
            Width="16"
            Height="16" />
        </Button>

        <!-- 記憶體設定 (MB) -->
        <TextBlock Grid.Row="5"
          Grid.Column="0"
          Text="記憶體設定（MB）："
          VerticalAlignment="Center"
          Margin="0,8"
          Foreground="{ThemeResource TextBrush}" />
        <Grid Grid.Row="5"
          Grid.Column="1"
          Grid.ColumnSpan="3"
          Margin="0,6,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="最小記憶體："
              FontSize="11"
              Foreground="{ThemeResource MutedTextBrush}"
              Margin="0,0,0,4" />
            <TextBox
              Text="{x:Bind ViewModel.MinMemoryMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              PlaceholderText="例如 1024" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="最大記憶體："
              FontSize="11"
              Foreground="{ThemeResource MutedTextBrush}"
              Margin="0,0,0,4" />
            <TextBox
              Text="{x:Bind ViewModel.MaxMemoryMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              PlaceholderText="例如 4096" />
          </StackPanel>
        </Grid>

        <!-- 記憶體說明與警告標籤 -->
        <StackPanel Grid.Row="6"
          Grid.Column="1"
          Grid.ColumnSpan="3"
          Margin="0,0,0,6">
          <TextBlock Text="最小記憶體選填，若留空由 Java 決定"
            FontSize="11"
            Foreground="{ThemeResource MutedTextBrush}" />
          <TextBlock Text="最大記憶體（必要）建議：2048MB（預設）| 4096MB（一般）| 8192MB（多人遊戲）"
            FontSize="11"
            Foreground="{ThemeResource MutedTextBrush}"
            Margin="0,2,0,0" />
          <TextBlock Text="{x:Bind ViewModel.MemoryWarningText, Mode=OneWay}"
            FontSize="12"
            FontWeight="SemiBold"
            controls:ThemeBrush.ForegroundKey="{x:Bind controls:UiBindHelpers.ErrorBrushKey(ViewModel.IsMemoryError), Mode=OneWay}"
            Visibility="{x:Bind controls:UiBindHelpers.NullOrWhitespaceToVis(ViewModel.MemoryWarningText), Mode=OneWay}"
            Margin="0,6,0,0" />
        </StackPanel>
      </Grid>

      <!-- JVM 啟動參數設定 -->
      <StackPanel Orientation="Horizontal"
        Margin="0,0,0,28"
        VerticalAlignment="Center"
        Spacing="12">
        <TextBlock Text="JVM 啟動參數："
          Width="180"
          VerticalAlignment="Center"
          Foreground="{ThemeResource TextBrush}" />
        <Button Content="JVM 參數設定..."
          Command="{x:Bind ViewModel.ConfigureJvmArgsCommand}"
          Padding="14,6" />
        <TextBlock Text="{x:Bind ViewModel.JvmArgsSummary, Mode=OneWay}"
          Foreground="{ThemeResource MutedTextBrush}"
          VerticalAlignment="Center"
          FontSize="12" />
      </StackPanel>

      <!-- 底部操作按鈕 (重設表單、建立伺服器) -->
      <StackPanel Orientation="Horizontal"
        HorizontalAlignment="Right"
        Spacing="12">
        <Button Content="重設表單"
          Command="{x:Bind ViewModel.ResetFormCommand}"
          Style="{StaticResource DangerButtonStyle}"
          MinWidth="100"
          Height="36"
          VerticalContentAlignment="Center" />
        <Button Content="建立伺服器"
          Command="{x:Bind ViewModel.CreateServerCommand}"
          Style="{StaticResource PrimaryButtonStyle}"
          MinWidth="120"
          Height="36"
          VerticalContentAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>