<Window
  x:Class="MinecraftServerManager.App.Views.RestoreBackupWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels">

  <Grid Style="{StaticResource DialogRootGridStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 說明 -->
    <TextBlock Grid.Row="0"
      Style="{StaticResource SecondaryCaptionTextStyle}"
      Text="選擇備份存檔進行還原（具備 Staging 交易安全防護與自動復原機制）" />

    <controls:TableFrame Grid.Row="1"
      SortTarget="{x:Bind HeaderSort}"
      IsEmpty="{x:Bind controls:UiBindHelpers.IsEmpty(ViewModel.Backups.Count), Mode=OneWay}"
      EmptyText="尚無備份">
      <controls:TableFrame.Header>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:SortableTableHeader Grid.Column="0"
            Text="備份檔案名稱"
            SortPropertyName="FileName" />
          <controls:SortableTableHeader Grid.Column="1"
            Text="檔案大小"
            SortPropertyName="SizeFormatted" />
          <controls:SortableTableHeader Grid.Column="2"
            Text="建立時間"
            SortPropertyName="CreatedAtFormatted" />
        </Grid>
      </controls:TableFrame.Header>

      <ListView Style="{StaticResource TableListViewStyle}"
        ItemsSource="{x:Bind ViewModel.Backups}"
        SelectedItem="{x:Bind ViewModel.SelectedBackup, Mode=TwoWay}"
        SelectionMode="Single"
        controls:ListViewBehaviors.ClearOnOutsidePress="True"
        controls:ListViewBehaviors.InvokeCommand="{x:Bind ViewModel.RestoreCommand}"
        controls:ListViewBehaviors.DeleteCommand="{x:Bind ViewModel.DeleteCommand}"
        AutomationProperties.Name="備份清單">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="vm:BackupDisplayItem">
            <Grid>
              <controls:TableCell Grid.Column="0"
                Text="{x:Bind FileName}" />
              <controls:TableCell Grid.Column="1"
                Text="{x:Bind SizeFormatted}" />
              <controls:TableCell Grid.Column="2"
                Text="{x:Bind CreatedAtFormatted}"
                ShowRightBorder="False" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </controls:TableFrame>

    <!-- 狀態提示 -->
    <TextBlock Grid.Row="2"
      Style="{StaticResource SecondaryCaptionTextStyle}"
      Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
      AutomationProperties.LiveSetting="Polite" />

    <!-- 底部按鈕區 -->
    <Grid Grid.Row="3">
      <Button Style="{StaticResource DangerButtonStyle}"
        HorizontalAlignment="Left"
        Command="{x:Bind ViewModel.DeleteCommand}">
        <controls:IconLabel Icon="{StaticResource IconDelete}"
          Text="刪除選取備份" />
      </Button>

      <StackPanel HorizontalAlignment="Right"
        Orientation="Horizontal"
        Spacing="10">
        <Button Style="{StaticResource PrimaryButtonStyle}"
          MinWidth="100"
          Content="開始還原"
          Command="{x:Bind ViewModel.RestoreCommand}" />
        <Button MinWidth="80"
          Content="取消"
          Command="{x:Bind ViewModel.CancelCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
