<UserControl
  x:Class="MinecraftServerManager.App.Views.ModsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  xmlns:views="using:MinecraftServerManager.App.Views"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels"
  mc:Ignorable="d">

  <Grid Margin="0,0,16,16"
    Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 頂部標題 -->
    <StackPanel Grid.Row="0"
      Margin="0,0,0,16"
      Orientation="Horizontal"
      VerticalAlignment="Center"
      Spacing="10">
      <controls:ColorIcon Source="{StaticResource IconMods}"
        Width="24"
        Height="24"
        VerticalAlignment="Center" />
      <TextBlock Text="模組管理"
        FontSize="26"
        FontWeight="Bold"
        Foreground="{ThemeResource TextBrush}"
        VerticalAlignment="Center" />
      <TextBlock Text="本地模組清單與線上探索"
        FontSize="14"
        Foreground="{ThemeResource MutedTextBrush}"
        VerticalAlignment="Center" />
    </StackPanel>

    <!-- 伺服器選擇列 -->
    <Border Grid.Row="1"
      Background="{ThemeResource CardBrush}"
      BorderBrush="{ThemeResource BorderBrush}"
      BorderThickness="1"
      CornerRadius="8"
      Padding="14,10"
      Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"
          Orientation="Horizontal"
          VerticalAlignment="Center"
          Margin="0,0,12,0"
          Spacing="6">
          <controls:ColorIcon Source="{StaticResource IconFolder}"
            Width="16"
            Height="16"
            VerticalAlignment="Center" />
          <TextBlock Text="伺服器："
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextBrush}" />
        </StackPanel>
        <ComboBox Grid.Column="1"
          ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}"
          SelectedItem="{x:Bind ViewModel.SelectedServer, Mode=TwoWay}"
          HorizontalAlignment="Stretch"
          Margin="0,0,12,0" />
        <Button Grid.Column="2"
          Command="{x:Bind ViewModel.RefreshServersCommand}"
          Height="32">
          <StackPanel Orientation="Horizontal"
            Spacing="6"
            VerticalAlignment="Center">
            <controls:ColorIcon Source="{StaticResource IconRefresh}"
              Width="14"
              Height="14"
              VerticalAlignment="Center" />
            <TextBlock Text="重新整理"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextBrush}" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- 分頁內容區域 -->
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 分頁切換列 -->
      <SelectorBar Grid.Row="0"
        HorizontalAlignment="Left"
        Margin="0,0,0,12"
        SelectionChanged="OnTabSelectionChanged">
        <SelectorBarItem Text="本地模組"
          IsSelected="True" />
        <SelectorBarItem Text="線上瀏覽" />
      </SelectorBar>

      <!-- 本地模組分頁 -->
      <Grid Grid.Row="1"
        Visibility="{x:Bind GetLocalTabVisibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具列 -->
        <Grid Grid.Row="0"
          Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- 左側操作按鈕列 -->
          <controls:WrapPanel Grid.Column="0"
            ItemSpacing="8"
            LineSpacing="8">
            <Button Command="{x:Bind ViewModel.Local.ImportModsCommand}"
              Height="32">
              <StackPanel Orientation="Horizontal"
                Spacing="6">
                <controls:ColorIcon Source="{StaticResource IconCreateServer}"
                  Width="14"
                  Height="14"
                  VerticalAlignment="Center" />
                <TextBlock Text="匯入模組"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource TextBrush}" />
              </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.Local.RefreshLocalModsCommand}"
              Height="32">
              <StackPanel Orientation="Horizontal"
                Spacing="6">
                <controls:ColorIcon Source="{StaticResource IconRefresh}"
                  Width="14"
                  Height="14"
                  VerticalAlignment="Center" />
                <TextBlock Text="重新整理"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource TextBrush}" />
              </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.CheckModUpdatesCommand}"
              IsEnabled="{x:Bind ViewModel.Local.CanCheckUpdates, Mode=OneWay}"
              Height="32">
              <StackPanel Orientation="Horizontal"
                Spacing="6">
                <controls:ColorIcon Source="{StaticResource IconRefresh}"
                  Width="14"
                  Height="14"
                  VerticalAlignment="Center" />
                <TextBlock Text="檢查更新"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource TextBrush}" />
              </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.Local.ToggleSelectAllCommand}"
              Height="32">
              <TextBlock Text="全選"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextBrush}" />
            </Button>
            <Button Command="{x:Bind ViewModel.Local.BatchToggleCommand}"
              IsEnabled="{x:Bind ViewModel.Local.CanBatchToggle, Mode=OneWay}"
              Height="32">
              <TextBlock Text="批次切換"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextBrush}" />
            </Button>
            <Button Command="{x:Bind ViewModel.Local.OpenModsFolderCommand}"
              Height="32">
              <StackPanel Orientation="Horizontal"
                Spacing="6">
                <controls:ColorIcon Source="{StaticResource IconFolder}"
                  Width="14"
                  Height="14"
                  VerticalAlignment="Center" />
                <TextBlock Text="開啟模組資料夾"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource TextBrush}" />
              </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.Local.DeleteSelectedModCommand}"
              IsEnabled="{x:Bind ViewModel.Local.CanDeleteMod, Mode=OneWay}"
              Style="{StaticResource DangerButtonStyle}"
              Height="32">
              <StackPanel Orientation="Horizontal"
                Spacing="6">
                <controls:ColorIcon Source="{StaticResource IconDelete}"
                  Width="14"
                  Height="14"
                  VerticalAlignment="Center" />
                <TextBlock Text="刪除已選取模組"
                  VerticalAlignment="Center"
                  Foreground="#FFFFFF" />
              </StackPanel>
            </Button>
          </controls:WrapPanel>

          <!-- 右側搜尋與匯出 -->
          <StackPanel Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Spacing="6">
            <StackPanel Orientation="Horizontal"
              Spacing="8">
              <TextBox Width="150"
                Text="{x:Bind ViewModel.Local.LocalSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Height="32"
                PlaceholderText="搜尋本地模組..." />
              <ComboBox ItemsSource="{x:Bind vm:LocalModsViewModel.LocalFilterOptions}"
                SelectedItem="{x:Bind ViewModel.Local.SelectedLocalFilter, Mode=TwoWay}"
                Width="100"
                Height="32" />
            </StackPanel>
            <Button Command="{x:Bind ViewModel.Local.ExportModListCommand}"
              HorizontalAlignment="Right"
              Height="32"
              Padding="12,0">
              <StackPanel Orientation="Horizontal"
                Spacing="6">
                <controls:ColorIcon Source="{StaticResource IconFolder}"
                  Width="14"
                  Height="14"
                  VerticalAlignment="Center" />
                <TextBlock Text="匯出模組清單"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource TextBrush}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- 本地模組清單 -->
        <Border Grid.Row="1"
          Background="{ThemeResource CardBrush}"
          BorderBrush="{ThemeResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 標頭 -->
            <Border Grid.Row="0"
              Background="{ThemeResource CardBrush}"
              BorderBrush="{ThemeResource DataGridGridLineBrush}"
              BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.EnabledWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.NameWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.VersionWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.AuthorWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.LoaderWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.PlatformWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.SizeWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.ModifiedWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.DescriptionWidth, Mode=OneWay}" />
                </Grid.ColumnDefinitions>

                <controls:SortableTableHeader Grid.Column="0"
                  Text="啟用"
                  SortPropertyName="IsEnabled"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.EnabledWidth, Mode=TwoWay}"
                  SortRequested="OnLocalSortRequested"
                  AutoFitRequested="OnLocalAutoFitRequested" />
                <controls:SortableTableHeader Grid.Column="1"
                  Text="模組名稱"
                  SortPropertyName="Name"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.NameWidth, Mode=TwoWay}"
                  SortRequested="OnLocalSortRequested"
                  AutoFitRequested="OnLocalAutoFitRequested" />
                <controls:SortableTableHeader Grid.Column="2"
                  Text="版本"
                  SortPropertyName="Version"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.VersionWidth, Mode=TwoWay}"
                  SortRequested="OnLocalSortRequested"
                  AutoFitRequested="OnLocalAutoFitRequested" />
                <controls:SortableTableHeader Grid.Column="3"
                  Text="作者"
                  SortPropertyName="Author"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.AuthorWidth, Mode=TwoWay}"
                  SortRequested="OnLocalSortRequested"
                  AutoFitRequested="OnLocalAutoFitRequested" />
                <controls:SortableTableHeader Grid.Column="4"
                  Text="載入器"
                  SortPropertyName="LoaderType"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.LoaderWidth, Mode=TwoWay}"
                  SortRequested="OnLocalSortRequested"
                  AutoFitRequested="OnLocalAutoFitRequested" />
                <controls:SortableTableHeader Grid.Column="5"
                  Text="來源平台"
                  SortPropertyName="SourcePlatform"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.PlatformWidth, Mode=TwoWay}"
                  SortRequested="OnLocalSortRequested"
                  AutoFitRequested="OnLocalAutoFitRequested" />
                <controls:SortableTableHeader Grid.Column="6"
                  Text="檔案大小"
                  SortPropertyName="FileSize"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.SizeWidth, Mode=TwoWay}"
                  SortRequested="OnLocalSortRequested"
                  AutoFitRequested="OnLocalAutoFitRequested" />
                <controls:SortableTableHeader Grid.Column="7"
                  Text="修改時間"
                  SortPropertyName="ModifiedTime"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.ModifiedWidth, Mode=TwoWay}"
                  SortRequested="OnLocalSortRequested"
                  AutoFitRequested="OnLocalAutoFitRequested" />
                <controls:SortableTableHeader Grid.Column="8"
                  Text="描述"
                  SortPropertyName="Description"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.DescriptionWidth, Mode=TwoWay}"
                  SortRequested="OnLocalSortRequested"
                  AutoFitRequested="OnLocalAutoFitRequested" />
              </Grid>
            </Border>

            <!-- 項目清單 -->
            <Border Grid.Row="1"
              BorderBrush="{ThemeResource DataGridGridLineBrush}"
              BorderThickness="1,0,1,1">
              <ListView ItemsSource="{x:Bind ViewModel.Local.LocalMods, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Local.SelectedLocalMod, Mode=TwoWay}"
                SelectionMode="Single"
                ItemContainerStyle="{StaticResource TableListViewItemStyle}">
                <ListView.ContextFlyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Text="複製模組資訊"
                      Click="OnCopyLocalModInfoClicked" />
                    <MenuFlyoutItem Text="在資料夾中顯示"
                      Click="OnShowInFolderClicked" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="刪除模組"
                      Command="{x:Bind ViewModel.Local.DeleteSelectedModCommand}" />
                  </MenuFlyout>
                </ListView.ContextFlyout>

                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocalModRowItem">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition
                          Width="{x:Bind views:LocalModListColumns.Current.EnabledWidth, Mode=OneWay}" />
                        <ColumnDefinition
                          Width="{x:Bind views:LocalModListColumns.Current.NameWidth, Mode=OneWay}" />
                        <ColumnDefinition
                          Width="{x:Bind views:LocalModListColumns.Current.VersionWidth, Mode=OneWay}" />
                        <ColumnDefinition
                          Width="{x:Bind views:LocalModListColumns.Current.AuthorWidth, Mode=OneWay}" />
                        <ColumnDefinition
                          Width="{x:Bind views:LocalModListColumns.Current.LoaderWidth, Mode=OneWay}" />
                        <ColumnDefinition
                          Width="{x:Bind views:LocalModListColumns.Current.PlatformWidth, Mode=OneWay}" />
                        <ColumnDefinition
                          Width="{x:Bind views:LocalModListColumns.Current.SizeWidth, Mode=OneWay}" />
                        <ColumnDefinition
                          Width="{x:Bind views:LocalModListColumns.Current.ModifiedWidth, Mode=OneWay}" />
                        <ColumnDefinition
                          Width="{x:Bind views:LocalModListColumns.Current.DescriptionWidth, Mode=OneWay}" />
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="4,2">
                        <CheckBox IsChecked="{x:Bind IsEnabled, Mode=OneWay}"
                          Click="OnModToggleClicked"
                          MinWidth="0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="1"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"
                          VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="2"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind Version, Mode=OneWay}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind Version, Mode=OneWay}"
                          VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="3"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind Author, Mode=OneWay}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind Author, Mode=OneWay}"
                          VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="4"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind LoaderType, Mode=OneWay}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind LoaderType, Mode=OneWay}"
                          VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="5"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind SourcePlatform, Mode=OneWay}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind SourcePlatform, Mode=OneWay}"
                          VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="6"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind FileSize, Mode=OneWay}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind FileSize, Mode=OneWay}"
                          VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="7"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind ModifiedTime, Mode=OneWay}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind ModifiedTime, Mode=OneWay}"
                          VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="8"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}"
                          VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <!-- 線上瀏覽模組分頁 -->
      <Grid Grid.Row="1"
        Visibility="{x:Bind GetOnlineTabVisibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 頂部相容條件提示標籤 -->
        <Border Grid.Row="0"
          Background="{ThemeResource CardBrush}"
          BorderBrush="{ThemeResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="6"
          Padding="12,8"
          Margin="0,0,0,10">
          <StackPanel Orientation="Horizontal"
            Spacing="8">
            <controls:ColorIcon Source="{StaticResource IconCheck}"
              Width="15"
              Height="15"
              VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.Online.OnlineFilterHint, Mode=OneWay}"
              Foreground="{ThemeResource TextBrush}"
              FontSize="12"
              VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- 線上搜尋列 -->
        <Grid Grid.Row="1"
          Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0"
            Text="{x:Bind ViewModel.Online.OnlineSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            KeyDown="OnlineSearchBox_KeyDown"
            Height="32"
            PlaceholderText="輸入模組名稱搜尋..."
            Margin="0,0,10,0" />
          <TextBlock Grid.Column="1"
            Text="平台："
            VerticalAlignment="Center"
            Margin="0,0,6,0"
            Foreground="{ThemeResource TextBrush}" />
          <ComboBox Grid.Column="2"
            ItemsSource="{x:Bind vm:OnlineModSearchViewModel.PlatformOptions}"
            SelectedItem="{x:Bind ViewModel.Online.SelectedPlatform, Mode=TwoWay}"
            Width="120"
            Height="32"
            Margin="0,0,10,0" />
          <TextBlock Grid.Column="3"
            Text="排序："
            VerticalAlignment="Center"
            Margin="0,0,6,0"
            Foreground="{ThemeResource TextBrush}" />
          <ComboBox Grid.Column="4"
            ItemsSource="{x:Bind vm:OnlineModSearchViewModel.OnlineSortOptions}"
            SelectedItem="{x:Bind ViewModel.Online.SelectedOnlineSort, Mode=TwoWay}"
            Width="110"
            Height="32"
            Margin="0,0,10,0" />
          <Button Grid.Column="5"
            Command="{x:Bind ViewModel.Online.SearchOnlineModsCommand}"
            Style="{StaticResource PrimaryButtonStyle}"
            Height="32"
            Padding="16,0">
            <StackPanel Orientation="Horizontal"
              Spacing="6"
              VerticalAlignment="Center">
              <controls:ColorIcon Source="{StaticResource IconSearch}"
                Width="15"
                Height="15"
                VerticalAlignment="Center" />
              <TextBlock Text="搜尋模組"
                VerticalAlignment="Center"
                Foreground="#FFFFFF" />
            </StackPanel>
          </Button>
          <StackPanel Grid.Column="6"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Margin="10,0,0,0"
            Spacing="8">
            <ProgressBar IsIndeterminate="True"
              Width="80"
              Height="4"
              VerticalAlignment="Center"
              Visibility="{x:Bind ViewModel.Online.IsSearchingOnline, Mode=OneWay}" />
            <TextBlock Text="搜尋中..."
              FontSize="12"
              Foreground="{ThemeResource AccentBrush}"
              VerticalAlignment="Center"
              Visibility="{x:Bind ViewModel.Online.IsSearchingOnline, Mode=OneWay}" />
          </StackPanel>
        </Grid>

        <!-- 線上瀏覽結果清單 -->
        <Border Grid.Row="2"
          Background="{ThemeResource CardBrush}"
          BorderBrush="{ThemeResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 標頭 -->
            <Border Grid.Row="0"
              Background="{ThemeResource CardBrush}"
              BorderBrush="{ThemeResource DataGridGridLineBrush}"
              BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition
                    Width="{x:Bind views:OnlineModListColumns.Current.TitleWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:OnlineModListColumns.Current.AuthorWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:OnlineModListColumns.Current.DownloadsWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:OnlineModListColumns.Current.VersionWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:OnlineModListColumns.Current.DescriptionWidth, Mode=OneWay}" />
                </Grid.ColumnDefinitions>

                <controls:SortableTableHeader Grid.Column="0"
                  Text="模組名稱"
                  SortPropertyName="Title"
                  ColumnWidth="{x:Bind views:OnlineModListColumns.Current.TitleWidth, Mode=TwoWay}"
                  SortRequested="OnOnlineSortRequested"
                  AutoFitRequested="OnOnlineAutoFitRequested" />
                <controls:SortableTableHeader Grid.Column="1"
                  Text="作者"
                  SortPropertyName="Author"
                  ColumnWidth="{x:Bind views:OnlineModListColumns.Current.AuthorWidth, Mode=TwoWay}"
                  SortRequested="OnOnlineSortRequested"
                  AutoFitRequested="OnOnlineAutoFitRequested" />
                <controls:SortableTableHeader Grid.Column="2"
                  Text="下載量"
                  SortPropertyName="Downloads"
                  ColumnWidth="{x:Bind views:OnlineModListColumns.Current.DownloadsWidth, Mode=TwoWay}"
                  SortRequested="OnOnlineSortRequested"
                  AutoFitRequested="OnOnlineAutoFitRequested" />
                <controls:SortableTableHeader Grid.Column="3"
                  Text="最新版本"
                  SortPropertyName="LatestVersion"
                  ColumnWidth="{x:Bind views:OnlineModListColumns.Current.VersionWidth, Mode=TwoWay}"
                  SortRequested="OnOnlineSortRequested"
                  AutoFitRequested="OnOnlineAutoFitRequested" />
                <controls:SortableTableHeader Grid.Column="4"
                  Text="簡介"
                  SortPropertyName="Description"
                  ColumnWidth="{x:Bind views:OnlineModListColumns.Current.DescriptionWidth, Mode=TwoWay}"
                  SortRequested="OnOnlineSortRequested"
                  AutoFitRequested="OnOnlineAutoFitRequested" />
              </Grid>
            </Border>

            <!-- 清單 -->
            <Border Grid.Row="1"
              BorderBrush="{ThemeResource DataGridGridLineBrush}"
              BorderThickness="1,0,1,1">
              <ListView ItemsSource="{x:Bind ViewModel.Online.OnlineMods, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Online.SelectedOnlineMod, Mode=TwoWay}"
                SelectionMode="Single"
                ItemContainerStyle="{StaticResource TableListViewItemStyle}"
                DoubleTapped="OnOnlineModsDoubleTapped">
                <ListView.ItemTemplate>
                  <DataTemplate x:DataType="vm:OnlineModRowItem">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition
                          Width="{x:Bind views:OnlineModListColumns.Current.TitleWidth, Mode=OneWay}" />
                        <ColumnDefinition
                          Width="{x:Bind views:OnlineModListColumns.Current.AuthorWidth, Mode=OneWay}" />
                        <ColumnDefinition
                          Width="{x:Bind views:OnlineModListColumns.Current.DownloadsWidth, Mode=OneWay}" />
                        <ColumnDefinition
                          Width="{x:Bind views:OnlineModListColumns.Current.VersionWidth, Mode=OneWay}" />
                        <ColumnDefinition
                          Width="{x:Bind views:OnlineModListColumns.Current.DescriptionWidth, Mode=OneWay}" />
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind Title}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind Title}"
                          VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="1"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind Author}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind Author}"
                          VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="2"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind Downloads}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind Downloads}"
                          VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="3"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind LatestVersion}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind LatestVersion}"
                          VerticalAlignment="Center" />
                      </Border>
                      <Border Grid.Column="4"
                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="8,6">
                        <TextBlock Text="{x:Bind Description}"
                          TextTrimming="CharacterEllipsis"
                          ToolTipService.ToolTip="{x:Bind Description}"
                          VerticalAlignment="Center" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </Border>
          </Grid>
        </Border>

        <!-- 底部安裝操作列 -->
        <Grid Grid.Row="3"
          Margin="0,10,0,0">
          <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock Text="{x:Bind ViewModel.Online.OnlineResultHint, Mode=OneWay}"
              VerticalAlignment="Center"
              Foreground="{ThemeResource MutedTextBrush}"
              FontSize="12" />
            <TextBlock Text="{x:Bind ViewModel.Queue.InstallQueueHint, Mode=OneWay}"
              VerticalAlignment="Center"
              Foreground="{ThemeResource MutedTextBrush}"
              FontSize="12" />
          </StackPanel>
          <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="10">
            <Button Content="{x:Bind ViewModel.Online.OpenPlatformPageButtonText, Mode=OneWay}"
              Command="{x:Bind ViewModel.Online.OpenModPlatformPageCommand}"
              Padding="14,6" />
            <Button Content="檢視安裝清單"
              Command="{x:Bind ViewModel.Queue.ViewInstallQueueCommand}"
              Padding="14,6" />
            <Button Content="清空清單"
              Command="{x:Bind ViewModel.Queue.ClearInstallQueueCommand}"
              Padding="14,6" />
            <Button Content="開始安裝"
              Command="{x:Bind ViewModel.Queue.InstallQueuedModsCommand}"
              Style="{StaticResource PrimaryButtonStyle}"
              Padding="18,6" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>