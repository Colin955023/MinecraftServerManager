<UserControl
  x:Class="MinecraftServerManager.App.Views.ModsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  xmlns:views="using:MinecraftServerManager.App.Views"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels"
  mc:Ignorable="d">

  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 頂部標題 -->
    <StackPanel Grid.Row="0"
      Margin="0,0,0,16"
      Orientation="Horizontal"
      VerticalAlignment="Center"
      Spacing="10">
      <TextBlock Text="模組管理"
        Style="{StaticResource PageTitleTextStyle}"
        VerticalAlignment="Center" />
      <TextBlock Text="本地模組清單與線上探索"
        FontSize="{StaticResource BodyTextBlockFontSize}"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        VerticalAlignment="Center" />
    </StackPanel>

    <!-- 伺服器選擇列 -->
    <Border Grid.Row="1"
      Style="{StaticResource CardBorderStyle}"
      Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:IconLabel Icon="{StaticResource IconFolder}"
          Text="伺服器："
          IconSize="16"
          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
          Grid.Column="0"
          VerticalAlignment="Center"
          Margin="0,0,12,0" />
        <ComboBox AutomationProperties.Name="伺服器" Grid.Column="1"
          ItemsSource="{x:Bind ViewModel.Servers, Mode=OneWay}"
          SelectedItem="{x:Bind ViewModel.SelectedServer, Mode=TwoWay}"
          HorizontalAlignment="Stretch"
          Margin="0,0,12,0" />
        <Button Grid.Column="2"
          Command="{x:Bind ViewModel.RefreshServersCommand}"
          Height="32">
          <controls:IconLabel Icon="{StaticResource IconRefresh}"
            Text="重新整理"
            IconSize="14"
            VerticalAlignment="Center" />
        </Button>
      </Grid>
    </Border>

    <!-- 分頁內容區域 -->
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- 分頁切換列 -->
      <SelectorBar Grid.Row="0"
        HorizontalAlignment="Left"
        Margin="0,0,0,12"
        SelectionChanged="OnTabSelectionChanged">
        <SelectorBarItem Text="本地模組"
          IsSelected="True" />
        <SelectorBarItem Text="線上瀏覽" />
      </SelectorBar>

      <!-- 本地模組分頁 -->
      <Grid Grid.Row="1"
        Visibility="{x:Bind views:ModsView.GetLocalTabVisibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="160" />
        </Grid.RowDefinitions>

        <!-- 工具列 -->
        <Grid Grid.Row="0"
          Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- 左側操作按鈕列 -->
          <controls:WrapPanel Grid.Column="0"
            ItemSpacing="8"
            LineSpacing="8">
            <Button Command="{x:Bind ViewModel.Local.ImportModsCommand}"
              Height="32">
              <controls:IconLabel Icon="{StaticResource IconCreateServer}"
                Text="匯入模組"
                IconSize="14" />
            </Button>
            <Button Command="{x:Bind ViewModel.Local.RefreshLocalModsCommand}"
              Height="32">
              <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="F5" />
              </Button.KeyboardAccelerators>
              <controls:IconLabel Icon="{StaticResource IconRefresh}"
                Text="重新整理"
                IconSize="14" />
            </Button>
            <Button Command="{x:Bind ViewModel.CheckModUpdatesCommand}"
              IsEnabled="{x:Bind ViewModel.Local.CanCheckUpdates, Mode=OneWay}"
              Height="32">
              <controls:IconLabel Icon="{StaticResource IconRefresh}"
                Text="檢查更新"
                IconSize="14" />
            </Button>
            <Button Click="OnSelectAllLocalModsClicked"
              Height="32">
              <controls:IconLabel Icon="{StaticResource IconSelectAll}"
                Text="全選"
                IconSize="14" />
            </Button>
            <Button Command="{x:Bind ViewModel.Local.BatchToggleCommand}"
              IsEnabled="{x:Bind ViewModel.Local.CanBatchToggle, Mode=OneWay}"
              Height="32">
              <controls:IconLabel Icon="{StaticResource IconToggle}"
                Text="批次切換"
                IconSize="14" />
            </Button>
            <Button Command="{x:Bind ViewModel.Local.OpenModsFolderCommand}"
              Height="32">
              <controls:IconLabel Icon="{StaticResource IconFolder}"
                Text="開啟模組資料夾"
                IconSize="14" />
            </Button>
            <Button Command="{x:Bind ViewModel.Local.DeleteSelectedModCommand}"
              Style="{StaticResource DangerButtonStyle}"
              Height="32">
              <Button.KeyboardAccelerators>
                <KeyboardAccelerator x:Name="DeleteModsAccelerator"
                  Key="Delete" />
              </Button.KeyboardAccelerators>
              <controls:IconLabel Icon="{StaticResource IconDelete}"
                Text="刪除已選取模組"
                IconSize="14" />
            </Button>
          </controls:WrapPanel>

          <!-- 右側搜尋與匯出 -->
          <StackPanel Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Spacing="6">
            <StackPanel Orientation="Horizontal"
              Spacing="8">
              <TextBox x:Name="LocalSearchBox"
                AutomationProperties.Name="搜尋本地模組"
                Width="150"
                Text="{x:Bind ViewModel.Local.LocalSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Height="32"
                PlaceholderText="搜尋本地模組...">
                <TextBox.KeyboardAccelerators>
                  <KeyboardAccelerator Modifiers="Control"
                    Key="F"
                    Invoked="OnFocusSearchInvoked" />
                </TextBox.KeyboardAccelerators>
              </TextBox>
              <ComboBox AutomationProperties.Name="篩選本地模組"
                ItemsSource="{x:Bind vm:LocalModsViewModel.LocalFilterOptions}"
                SelectedItem="{x:Bind ViewModel.Local.SelectedLocalFilter, Mode=TwoWay}"
                Width="100"
                Height="32" />
            </StackPanel>
            <Button Command="{x:Bind ViewModel.Local.ExportModListCommand}"
              HorizontalAlignment="Right"
              Height="32"
              Padding="12,0">
              <controls:IconLabel Icon="{StaticResource IconFolder}"
                Text="匯出模組清單"
                IconSize="14" />
            </Button>
          </StackPanel>
        </Grid>

        <!-- 本地模組清單 -->
        <Border Grid.Row="1"
          Style="{StaticResource PanelCardStyle}">
          <controls:TableFrame SortTarget="{x:Bind LocalSort}"
            IsEmpty="{x:Bind controls:UiBindHelpers.IsIdleEmpty(ViewModel.Local.LocalMods.Count, x:False), Mode=OneWay}"
            EmptyText="沒有符合的模組">
            <controls:TableFrame.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.EnabledWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.NameWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.VersionWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.AuthorWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.LoaderWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.PlatformWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.SizeWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.ModifiedWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:LocalModListColumns.Current.DescriptionWidth, Mode=OneWay}" />
                </Grid.ColumnDefinitions>

                <controls:SortableTableHeader Grid.Column="0"
                  Text="啟用"
                  SortPropertyName="IsEnabled"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.EnabledWidth, Mode=TwoWay}" />
                <controls:SortableTableHeader Grid.Column="1"
                  Text="模組名稱"
                  SortPropertyName="Name"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.NameWidth, Mode=TwoWay}" />
                <controls:SortableTableHeader Grid.Column="2"
                  Text="版本"
                  SortPropertyName="Version"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.VersionWidth, Mode=TwoWay}" />
                <controls:SortableTableHeader Grid.Column="3"
                  Text="作者"
                  SortPropertyName="Author"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.AuthorWidth, Mode=TwoWay}" />
                <controls:SortableTableHeader Grid.Column="4"
                  Text="載入器"
                  SortPropertyName="LoaderType"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.LoaderWidth, Mode=TwoWay}" />
                <controls:SortableTableHeader Grid.Column="5"
                  Text="來源平台"
                  SortPropertyName="SourcePlatform"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.PlatformWidth, Mode=TwoWay}" />
                <controls:SortableTableHeader Grid.Column="6"
                  Text="檔案大小"
                  SortPropertyName="FileSize"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.SizeWidth, Mode=TwoWay}" />
                <controls:SortableTableHeader Grid.Column="7"
                  Text="修改時間"
                  SortPropertyName="ModifiedTime"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.ModifiedWidth, Mode=TwoWay}" />
                <controls:SortableTableHeader Grid.Column="8"
                  Text="描述"
                  SortPropertyName="Description"
                  ColumnWidth="{x:Bind views:LocalModListColumns.Current.DescriptionWidth, Mode=TwoWay}" />
              </Grid>
            </controls:TableFrame.Header>
            <ListView x:Name="LocalModsListView"
              ItemsSource="{x:Bind ViewModel.Local.LocalMods}"
              SelectedItem="{x:Bind ViewModel.Local.SelectedLocalMod, Mode=TwoWay}"
              SelectionMode="Extended"
              controls:ListSelectionBehavior.ClearOnOutsidePress="True"
              SelectionChanged="OnLocalModsSelectionChanged"
              ItemContainerStyle="{StaticResource TableListViewItemStyle}">
              <ListView.ContextFlyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="複製模組資訊"
                    Command="{x:Bind ViewModel.Local.CopyModInfoCommand}">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="{StaticResource IconCopy}" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutItem Text="在資料夾中顯示"
                    Command="{x:Bind ViewModel.Local.ShowInFolderCommand}">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="{StaticResource IconFolder}" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                  <MenuFlyoutSeparator />
                  <MenuFlyoutItem Text="刪除模組"
                    Command="{x:Bind ViewModel.Local.DeleteSelectedModCommand}">
                    <MenuFlyoutItem.Icon>
                      <FontIcon Glyph="{StaticResource IconDelete}" />
                    </MenuFlyoutItem.Icon>
                  </MenuFlyoutItem>
                </MenuFlyout>
              </ListView.ContextFlyout>

              <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:LocalModRowItem">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition
                        Width="{x:Bind views:LocalModListColumns.Current.EnabledWidth, Mode=OneWay}" />
                      <ColumnDefinition
                        Width="{x:Bind views:LocalModListColumns.Current.NameWidth, Mode=OneWay}" />
                      <ColumnDefinition
                        Width="{x:Bind views:LocalModListColumns.Current.VersionWidth, Mode=OneWay}" />
                      <ColumnDefinition
                        Width="{x:Bind views:LocalModListColumns.Current.AuthorWidth, Mode=OneWay}" />
                      <ColumnDefinition
                        Width="{x:Bind views:LocalModListColumns.Current.LoaderWidth, Mode=OneWay}" />
                      <ColumnDefinition
                        Width="{x:Bind views:LocalModListColumns.Current.PlatformWidth, Mode=OneWay}" />
                      <ColumnDefinition
                        Width="{x:Bind views:LocalModListColumns.Current.SizeWidth, Mode=OneWay}" />
                      <ColumnDefinition
                        Width="{x:Bind views:LocalModListColumns.Current.ModifiedWidth, Mode=OneWay}" />
                      <ColumnDefinition
                        Width="{x:Bind views:LocalModListColumns.Current.DescriptionWidth, Mode=OneWay}" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                      Style="{StaticResource TableCellBorderStyle}"
                      Padding="4,2">
                      <CheckBox AutomationProperties.Name="啟用模組"
                        IsChecked="{x:Bind IsEnabled, Mode=OneWay}"
                        Click="OnModToggleClicked"
                        MinWidth="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    </Border>
                    <controls:TableCell Grid.Column="1"
                      Text="{x:Bind Name}" />
                    <controls:TableCell Grid.Column="2"
                      Text="{x:Bind Version}" />
                    <controls:TableCell Grid.Column="3"
                      x:Phase="1"
                      Text="{x:Bind Author}" />
                    <controls:TableCell Grid.Column="4"
                      x:Phase="1"
                      Text="{x:Bind LoaderType}" />
                    <controls:TableCell Grid.Column="5"
                      x:Phase="1"
                      Text="{x:Bind SourcePlatform, Mode=OneWay}" />
                    <controls:TableCell Grid.Column="6"
                      x:Phase="1"
                      Text="{x:Bind FileSize}" />
                    <controls:TableCell Grid.Column="7"
                      x:Phase="1"
                      Text="{x:Bind ModifiedTime}" />
                    <controls:TableCell Grid.Column="8"
                      x:Phase="1"
                      Text="{x:Bind Description}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </controls:TableFrame>
        </Border>
      </Grid>

      <!-- 線上瀏覽模組分頁 -->
      <Grid Grid.Row="1"
        Visibility="{x:Bind views:ModsView.GetOnlineTabVisibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="160" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 頂部相容條件提示標籤 -->
        <Border Grid.Row="0"
          Style="{StaticResource CardBorderStyle}"
          Margin="0,0,0,10">
          <controls:IconLabel Icon="{StaticResource IconInfo}"
            Text="{x:Bind ViewModel.Online.OnlineFilterHint, Mode=OneWay}"
            Spacing="8"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            FontSize="{StaticResource CaptionTextBlockFontSize}" />
        </Border>

        <!-- 線上搜尋列 -->
        <Grid Grid.Row="1"
          Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="OnlineSearchBox"
            AutomationProperties.Name="搜尋線上模組"
            Grid.Column="0"
            Text="{x:Bind ViewModel.Online.OnlineSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            KeyDown="OnlineSearchBox_KeyDown"
            Height="32"
            PlaceholderText="輸入模組名稱搜尋..."
            Margin="0,0,10,0">
            <TextBox.KeyboardAccelerators>
              <KeyboardAccelerator Modifiers="Control"
                Key="F"
                Invoked="OnFocusSearchInvoked" />
            </TextBox.KeyboardAccelerators>
          </TextBox>
          <TextBlock Grid.Column="1"
            Text="平台："
            VerticalAlignment="Center"
            Margin="0,0,6,0"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
          <ComboBox AutomationProperties.Name="平台" Grid.Column="2"
            ItemsSource="{x:Bind vm:OnlineModSearchViewModel.PlatformOptions}"
            SelectedItem="{x:Bind ViewModel.Online.SelectedPlatform, Mode=TwoWay}"
            Width="120"
            Height="32"
            Margin="0,0,10,0" />
          <TextBlock Grid.Column="3"
            Text="排序："
            VerticalAlignment="Center"
            Margin="0,0,6,0"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
          <ComboBox AutomationProperties.Name="排序" Grid.Column="4"
            ItemsSource="{x:Bind vm:OnlineModSearchViewModel.OnlineSortOptions}"
            SelectedItem="{x:Bind ViewModel.Online.SelectedOnlineSort, Mode=TwoWay}"
            Width="110"
            Height="32"
            Margin="0,0,10,0" />
          <Button Grid.Column="5"
            Command="{x:Bind ViewModel.Online.SearchOnlineModsCommand}"
            Style="{StaticResource PrimaryButtonStyle}"
            Height="32"
            Padding="16,0">
            <controls:IconLabel Icon="{StaticResource IconSearch}"
              Text="搜尋模組"
              VerticalAlignment="Center" />
          </Button>
          <StackPanel Grid.Column="6"
            Orientation="Horizontal"
            VerticalAlignment="Center"
            Margin="10,0,0,0"
            Spacing="8">
            <ProgressBar Style="{StaticResource BusyProgressBarStyle}"
              VerticalAlignment="Center"
              Visibility="{x:Bind ViewModel.Online.IsSearchingOnline, Mode=OneWay}" />
            <TextBlock Text="搜尋中..."
              FontSize="{StaticResource CaptionTextBlockFontSize}"
              Foreground="{ThemeResource AccentTextBrush}"
              VerticalAlignment="Center"
              Visibility="{x:Bind ViewModel.Online.IsSearchingOnline, Mode=OneWay}" />
          </StackPanel>
        </Grid>

        <!-- 線上瀏覽結果清單 -->
        <Border Grid.Row="2"
          Style="{StaticResource PanelCardStyle}">
          <controls:TableFrame SortTarget="{x:Bind OnlineSort}"
            IsEmpty="{x:Bind controls:UiBindHelpers.IsIdleEmpty(ViewModel.Online.OnlineMods.Count, ViewModel.Online.IsSearchingOnline), Mode=OneWay}"
            EmptyText="沒有搜尋結果">
            <controls:TableFrame.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition
                    Width="{x:Bind views:OnlineModListColumns.Current.TitleWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:OnlineModListColumns.Current.AuthorWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:OnlineModListColumns.Current.DownloadsWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:OnlineModListColumns.Current.VersionWidth, Mode=OneWay}" />
                  <ColumnDefinition
                    Width="{x:Bind views:OnlineModListColumns.Current.DescriptionWidth, Mode=OneWay}" />
                </Grid.ColumnDefinitions>

                <controls:SortableTableHeader Grid.Column="0"
                  Text="模組名稱"
                  SortPropertyName="Title"
                  ColumnWidth="{x:Bind views:OnlineModListColumns.Current.TitleWidth, Mode=TwoWay}" />
                <controls:SortableTableHeader Grid.Column="1"
                  Text="作者"
                  SortPropertyName="Author"
                  ColumnWidth="{x:Bind views:OnlineModListColumns.Current.AuthorWidth, Mode=TwoWay}" />
                <controls:SortableTableHeader Grid.Column="2"
                  Text="下載量"
                  SortPropertyName="Downloads"
                  ColumnWidth="{x:Bind views:OnlineModListColumns.Current.DownloadsWidth, Mode=TwoWay}" />
                <controls:SortableTableHeader Grid.Column="3"
                  Text="最新版本"
                  SortPropertyName="LatestVersion"
                  ColumnWidth="{x:Bind views:OnlineModListColumns.Current.VersionWidth, Mode=TwoWay}" />
                <controls:SortableTableHeader Grid.Column="4"
                  Text="簡介"
                  SortPropertyName="Description"
                  ColumnWidth="{x:Bind views:OnlineModListColumns.Current.DescriptionWidth, Mode=TwoWay}" />
              </Grid>
            </controls:TableFrame.Header>
            <ListView ItemsSource="{x:Bind ViewModel.Online.OnlineMods}"
              SelectedItem="{x:Bind ViewModel.Online.SelectedOnlineMod, Mode=TwoWay}"
              SelectionMode="Single"
              controls:ListSelectionBehavior.ClearOnOutsidePress="True"
              ItemContainerStyle="{StaticResource TableListViewItemStyle}"
              DoubleTapped="OnOnlineModsDoubleTapped"
              PreviewKeyDown="OnOnlineModsKeyDown">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:OnlineModRowItem">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition
                        Width="{x:Bind views:OnlineModListColumns.Current.TitleWidth, Mode=OneWay}" />
                      <ColumnDefinition
                        Width="{x:Bind views:OnlineModListColumns.Current.AuthorWidth, Mode=OneWay}" />
                      <ColumnDefinition
                        Width="{x:Bind views:OnlineModListColumns.Current.DownloadsWidth, Mode=OneWay}" />
                      <ColumnDefinition
                        Width="{x:Bind views:OnlineModListColumns.Current.VersionWidth, Mode=OneWay}" />
                      <ColumnDefinition
                        Width="{x:Bind views:OnlineModListColumns.Current.DescriptionWidth, Mode=OneWay}" />
                    </Grid.ColumnDefinitions>

                    <controls:TableCell Grid.Column="0"
                      Text="{x:Bind Title}" />
                    <controls:TableCell Grid.Column="1"
                      x:Phase="1"
                      Text="{x:Bind Author}" />
                    <controls:TableCell Grid.Column="2"
                      x:Phase="1"
                      Text="{x:Bind Downloads}" />
                    <controls:TableCell Grid.Column="3"
                      x:Phase="1"
                      Text="{x:Bind LatestVersion}" />
                    <controls:TableCell Grid.Column="4"
                      x:Phase="1"
                      Text="{x:Bind Description}" />
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </controls:TableFrame>
        </Border>

        <!-- 底部安裝操作列 -->
        <Grid Grid.Row="3"
          Margin="0,10,0,0"
          ColumnSpacing="16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <controls:WrapPanel VerticalAlignment="Center"
            ItemSpacing="16"
            LineSpacing="2">
            <TextBlock Text="{x:Bind ViewModel.Online.OnlineResultHint, Mode=OneWay}"
              VerticalAlignment="Center"
              TextTrimming="CharacterEllipsis"
              ToolTipService.ToolTip="{x:Bind ViewModel.Online.OnlineResultHint, Mode=OneWay}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              FontSize="{StaticResource CaptionTextBlockFontSize}" />
            <TextBlock Text="{x:Bind ViewModel.Queue.InstallQueueHint, Mode=OneWay}"
              VerticalAlignment="Center"
              TextTrimming="CharacterEllipsis"
              ToolTipService.ToolTip="{x:Bind ViewModel.Queue.InstallQueueHint, Mode=OneWay}"
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              FontSize="{StaticResource CaptionTextBlockFontSize}" />
          </controls:WrapPanel>
          <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            Spacing="10">
            <Button Content="{x:Bind ViewModel.Online.OpenPlatformPageButtonText, Mode=OneWay}"
              Command="{x:Bind ViewModel.Online.OpenModPlatformPageCommand}" />
            <Button Content="檢視安裝清單"
              Command="{x:Bind ViewModel.Queue.ViewInstallQueueCommand}" />
            <Button Content="清空清單"
              Command="{x:Bind ViewModel.Queue.ClearInstallQueueCommand}" />
            <Button Content="開始安裝"
              Command="{x:Bind ViewModel.Queue.InstallQueuedModsCommand}"
              Style="{StaticResource PrimaryButtonStyle}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>