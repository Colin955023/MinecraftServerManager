<Window x:Class="MinecraftServerManager.App.Views.ModInstallQueueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MinecraftServerManager.App.Controls"
        xmlns:views="using:MinecraftServerManager.App.Views"
        xmlns:vm="using:MinecraftServerManager.App.ViewModels">

        <Grid Background="{ThemeResource WindowBrush}"
                Padding="20"
                RowSpacing="12">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 標題 -->
                <TextBlock Grid.Row="0"
                        Text="📋 待安裝模組清單"
                        Style="{ThemeResource TitleTextBlockStyle}" />

                <!-- 說明 -->
                <TextBlock Grid.Row="1"
                        Text="目前已排入安裝佇列的模組與相依項目如下："
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}" />

                <!-- 清單 ListView -->
                <Border Grid.Row="2"
                        Background="{ThemeResource CardBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <Grid>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{ThemeResource CardBrush}"
                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                        BorderThickness="1">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModQueueListColumns.Current.ActionWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModQueueListColumns.Current.TitleWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModQueueListColumns.Current.VersionWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModQueueListColumns.Current.FileNameWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModQueueListColumns.Current.ReasonWidth, Mode=OneWay}" />
                                                </Grid.ColumnDefinitions>
                                                <controls:SortableTableHeader Grid.Column="0"
                                                        Text="動作"
                                                        SortPropertyName="ActionText"
                                                        ColumnWidth="{x:Bind views:ModQueueListColumns.Current.ActionWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="1"
                                                        Text="模組名稱"
                                                        SortPropertyName="Title"
                                                        ColumnWidth="{x:Bind views:ModQueueListColumns.Current.TitleWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="2"
                                                        Text="版本"
                                                        SortPropertyName="VersionDisplay"
                                                        ColumnWidth="{x:Bind views:ModQueueListColumns.Current.VersionWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="3"
                                                        Text="檔案名稱"
                                                        SortPropertyName="FileName"
                                                        ColumnWidth="{x:Bind views:ModQueueListColumns.Current.FileNameWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="4"
                                                        Text="原因 / 說明"
                                                        SortPropertyName="Reason"
                                                        ColumnWidth="{x:Bind views:ModQueueListColumns.Current.ReasonWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                        </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                        BorderThickness="1,0,1,1">
                                        <ListView ItemsSource="{x:Bind Queue, Mode=OneWay}"
                                                SelectionMode="None"
                                                ItemContainerStyle="{StaticResource TableListViewItemStyle}">
                                                <ListView.ItemTemplate>
                                                        <DataTemplate
                                                                x:DataType="vm:ModInstallQueueItem">
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition
                                                                                        Width="{x:Bind views:ModQueueListColumns.Current.ActionWidth, Mode=OneWay}" />
                                                                                <ColumnDefinition
                                                                                        Width="{x:Bind views:ModQueueListColumns.Current.TitleWidth, Mode=OneWay}" />
                                                                                <ColumnDefinition
                                                                                        Width="{x:Bind views:ModQueueListColumns.Current.VersionWidth, Mode=OneWay}" />
                                                                                <ColumnDefinition
                                                                                        Width="{x:Bind views:ModQueueListColumns.Current.FileNameWidth, Mode=OneWay}" />
                                                                                <ColumnDefinition
                                                                                        Width="{x:Bind views:ModQueueListColumns.Current.ReasonWidth, Mode=OneWay}" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0"
                                                                                BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                                                BorderThickness="0,0,1,0"
                                                                                Padding="8,6">
                                                                                <TextBlock
                                                                                        Text="{x:Bind ActionText}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTipService.ToolTip="{x:Bind ActionText}"
                                                                                        VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <Border Grid.Column="1"
                                                                                BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                                                BorderThickness="0,0,1,0"
                                                                                Padding="8,6">
                                                                                <TextBlock
                                                                                        Text="{x:Bind Title}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTipService.ToolTip="{x:Bind Title}"
                                                                                        VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <Border Grid.Column="2"
                                                                                BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                                                BorderThickness="0,0,1,0"
                                                                                Padding="8,6">
                                                                                <TextBlock
                                                                                        Text="{x:Bind VersionDisplay}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTipService.ToolTip="{x:Bind VersionDisplay}"
                                                                                        VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <Border Grid.Column="3"
                                                                                BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                                                BorderThickness="0,0,1,0"
                                                                                Padding="8,6">
                                                                                <TextBlock
                                                                                        Text="{x:Bind FileName}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTipService.ToolTip="{x:Bind FileName}"
                                                                                        VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <Border Grid.Column="4"
                                                                                BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                                                BorderThickness="0,0,1,0"
                                                                                Padding="8,6">
                                                                                <TextBlock
                                                                                        Text="{x:Bind Reason}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTipService.ToolTip="{x:Bind Reason}"
                                                                                        VerticalAlignment="Center" />
                                                                        </Border>
                                                                </Grid>
                                                        </DataTemplate>
                                                </ListView.ItemTemplate>
                                        </ListView>
                                </Border>
                        </Grid>
                </Border>

                <!-- 底部按鈕 -->
                <Grid Grid.Row="3">
                        <Button Content="清空清單"
                                Click="ClearQueue_Click"
                                HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10">
                                <Button Content="關閉"
                                        Click="Close_Click"
                                        MinWidth="80" />
                                <Button Content="開始安裝"
                                        Click="StartInstall_Click"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        MinWidth="100" />
                        </StackPanel>
                </Grid>
        </Grid>
</Window>