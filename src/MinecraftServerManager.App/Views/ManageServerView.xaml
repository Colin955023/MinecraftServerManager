<UserControl x:Class="MinecraftServerManager.App.Views.ManageServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MinecraftServerManager.App.ViewModels">
  <Grid Margin="0,0,16,16" Background="Transparent" PreviewMouseLeftButtonDown="OnViewPreviewMouseLeftButtonDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 頂部標題 -->
    <TextBlock Grid.Row="0" Text="⚙️ 管理伺服器" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16" />

    <!-- 頂部控制區 -->
    <StackPanel Grid.Row="1" Margin="0,0,0,14">
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="偵測路徑：" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" />
        <TextBox Grid.Column="1" Text="{Binding DetectPath, Mode=OneWay}" IsReadOnly="True" />
      </Grid>

      <StackPanel Orientation="Horizontal">
        <Button Command="{Binding DetectServersCommand}"
                Height="32"
                Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource IconSearch}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="偵測現有伺服器" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding AddServerCommand}"
                Height="32"
                Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource IconCreateServer}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="手動新增" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding RefreshServersCommand}"
                Height="32">
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource IconRefresh}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="重新整理" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True"
                       Width="80"
                       Height="4"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
          <TextBlock Text="{Binding BusyStatusText}"
                     FontSize="12"
                     Foreground="{DynamicResource AccentBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <!-- 中間卡片：伺服器列表 (自動填滿 X 軸) -->
    <Border Grid.Row="2"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="伺服器列表" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Servers}"
                  SelectedItem="{Binding SelectedServer}"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  HorizontalAlignment="Stretch"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="OnDataGridMouseDoubleClick"
                  MinHeight="180">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="🧠 修改記憶體設定" Command="{Binding EditServerMemoryCommand}" />
              <MenuItem Header="🔄 重新偵測伺服器" Command="{Binding RecheckServerCommand}" />
              <Separator />
              <MenuItem Header="📂 開啟備份資料夾" Command="{Binding OpenBackupFolderCommand}" />
              <MenuItem Header="📁 修改備份路徑" Command="{Binding EditBackupPathCommand}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn Header="名稱" Binding="{Binding Name}" Width="180" />
            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="90" />
            <DataGridTextColumn Header="載入器" Binding="{Binding Loader}" Width="100" />
            <DataGridTemplateColumn Header="狀態" SortMemberPath="Status" Width="Auto" MinWidth="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Status}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasMissingFiles}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="伺服器大小" Binding="{Binding Size}" Width="100" />
            <DataGridTextColumn Header="修改日期" Binding="{Binding LastModified}" Width="140" />
            <DataGridTextColumn Header="備份狀態" Binding="{Binding BackupStatus}" Width="100" />
            <DataGridTextColumn Header="路徑" Binding="{Binding RelativePath}" Width="*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="ToolTip" Value="{Binding Path}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>

    <!-- 底部操作區 -->
    <StackPanel Grid.Row="3">
      <TextBlock Text="操作" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />

      <!-- 未選取伺服器時的提示 -->
      <TextBlock Text="請於上方列表中選取伺服器以檢視詳細資訊與執行操作"
                 Foreground="{DynamicResource MutedTextBrush}"
                 Margin="0,0,0,10">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasSelectedServer}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <!-- 選取伺服器時之橫向平均分配詳細資訊區 -->
      <Grid Margin="0,0,0,10">
        <Grid.Style>
          <Style TargetType="Grid">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasSelectedServer}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 第 1 列：基本識別資訊 (4 欄平均分配) -->
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,4" TextTrimming="CharacterEllipsis">
          <Run Text="伺服器名稱：" Foreground="{DynamicResource MutedTextBrush}" />
          <Run Text="{Binding SelectedServer.Name, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
        </TextBlock>

        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,8,4" TextTrimming="CharacterEllipsis">
          <Run Text="Minecraft 版本：" Foreground="{DynamicResource MutedTextBrush}" />
          <Run Text="{Binding SelectedServer.Version, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
        </TextBlock>

        <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,8,4" TextTrimming="CharacterEllipsis">
          <Run Text="載入器類型：" Foreground="{DynamicResource MutedTextBrush}" />
          <Run Text="{Binding SelectedServer.Loader, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
        </TextBlock>

        <TextBlock Grid.Row="0" Grid.Column="3" Margin="0,0,0,4" TextTrimming="CharacterEllipsis">
          <Run Text="目前狀態：" Foreground="{DynamicResource MutedTextBrush}" />
          <Run Text="{Binding SelectedServer.Status, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
        </TextBlock>

        <!-- 第 2 列：資源與備份資訊 (4 欄平均分配) -->
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,4" TextTrimming="CharacterEllipsis">
          <Run Text="目錄容量：" Foreground="{DynamicResource MutedTextBrush}" />
          <Run Text="{Binding SelectedServer.Size, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
        </TextBlock>

        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,8,4" TextTrimming="CharacterEllipsis">
          <Run Text="記憶體配置：" Foreground="{DynamicResource MutedTextBrush}" />
          <Run Text="{Binding SelectedServerMemory, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
        </TextBlock>

        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,8,4" TextTrimming="CharacterEllipsis">
          <Run Text="備份狀況：" Foreground="{DynamicResource MutedTextBrush}" />
          <Run Text="{Binding SelectedServer.BackupStatus, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
        </TextBlock>

        <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedServerBackupPath, Mode=OneWay}">
          <Run Text="外部備份路徑：" Foreground="{DynamicResource MutedTextBrush}" />
          <Run Text="{Binding SelectedServerBackupPath, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
        </TextBlock>

        <!-- 第 3 列：實體路徑 (橫跨 4 欄) -->
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,4" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedServer.Path, Mode=OneWay}">
          <Run Text="實體路徑：" Foreground="{DynamicResource MutedTextBrush}" />
          <Run Text="{Binding SelectedServer.Path, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
        </TextBlock>
      </Grid>

      <WrapPanel>
        <!-- 啟動按鈕 (未執行時顯示) -->
        <Button Command="{Binding StartServerCommand}"
                IsEnabled="{Binding CanStartOrMonitorServer}"
                Width="120"
                Height="32"
                Margin="0,0,8,8">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectedServerRunning}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource IconStart}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="啟動" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- 停止按鈕 (執行中時顯示，避免誤導) -->
        <Button Command="{Binding StopServerCommand}"
                IsEnabled="{Binding HasSelectedServer}"
                Width="120"
                Height="32"
                Margin="0,0,8,8">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectedServerRunning}" Value="True">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="⏹️" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#FFFFFF" />
            <TextBlock Text="停止" VerticalAlignment="Center" Foreground="#FFFFFF" />
          </StackPanel>
        </Button>
        <Button Command="{Binding MonitorServerCommand}"
                IsEnabled="{Binding CanStartOrMonitorServer}"
                Width="120"
                Height="32"
                Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource IconConsole}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="監控" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ConfigureServerCommand}"
                IsEnabled="{Binding HasSelectedServer}"
                Width="120"
                Height="32"
                Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource IconServerSettings}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="設定" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding ManagePlayersCommand}"
                IsEnabled="{Binding CanManagePlayers}"
                Width="120"
                Height="32"
                Margin="0,0,8,8">
          <Button.ToolTip>
            <ToolTip Content="管理伺服器管理員 (ops)、白名單 (whitelist) 與封鎖名單 (bans)" />
          </Button.ToolTip>
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource IconUserGroup}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="名單管理" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding OpenServerFolderCommand}"
                IsEnabled="{Binding HasSelectedServer}"
                Width="120"
                Height="32"
                Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource IconFolder}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="開啟資料夾" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding BackupServerCommand}"
                IsEnabled="{Binding HasSelectedServer}"
                Width="120"
                Height="32"
                Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource IconBackup}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="備份伺服器" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding RestoreBackupCommand}"
                IsEnabled="{Binding HasSelectedServer}"
                Width="120"
                Height="32"
                Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource IconRestore}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="還原備份" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Command="{Binding DeleteServerCommand}"
                IsEnabled="{Binding HasSelectedServer}"
                Style="{DynamicResource DangerButtonStyle}"
                Width="120"
                Height="32"
                Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal">
            <Image Source="{DynamicResource IconDelete}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="刪除" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </StackPanel>
  </Grid>
</UserControl>
