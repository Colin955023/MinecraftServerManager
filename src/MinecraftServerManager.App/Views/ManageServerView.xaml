<UserControl
    x:Class="MinecraftServerManager.App.Views.ManageServerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MinecraftServerManager.App.Controls"
    xmlns:views="using:MinecraftServerManager.App.Views"
    xmlns:vm="using:MinecraftServerManager.App.ViewModels"
    mc:Ignorable="d">

    <Grid Margin="0,0,16,16"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 頂部標題 -->
        <TextBlock Grid.Row="0"
            Text="⚙️ 管理伺服器"
            FontSize="26"
            FontWeight="Bold"
            Foreground="{ThemeResource TextBrush}"
            Margin="0,0,0,16" />

        <!-- 頂部控制區 -->
        <StackPanel Grid.Row="1"
            Margin="0,0,0,14"
            Spacing="10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                    Text="偵測路徑："
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextBrush}"
                    Margin="0,0,2,0" />
                <TextBox Grid.Column="1"
                    Text="{x:Bind ViewModel.List.DetectPath, Mode=OneWay}"
                    IsReadOnly="True" />
                <Button Grid.Column="2"
                    Command="{x:Bind ViewModel.ServersRoot.ChangeServersRootCommand}"
                    Height="32"
                    ToolTipService.ToolTip="修改伺服器存放主資料夾路徑">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ContentPresenter ContentTemplate="{StaticResource IconFolder}"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center" />
                        <TextBlock Text="修改路徑"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextBrush}" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal"
                Spacing="8">
                <Button Command="{x:Bind ViewModel.List.DetectServersCommand}"
                    Height="32">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ContentPresenter ContentTemplate="{StaticResource IconSearch}"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center" />
                        <TextBlock Text="偵測現有伺服器"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextBrush}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.List.AddServerCommand}"
                    Height="32">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ContentPresenter ContentTemplate="{StaticResource IconCreateServer}"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center" />
                        <TextBlock Text="手動新增"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextBrush}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.List.RefreshServersCommand}"
                    Height="32">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ContentPresenter ContentTemplate="{StaticResource IconRefresh}"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center" />
                        <TextBlock Text="重新整理"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextBrush}" />
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <ProgressBar IsIndeterminate="True"
                        Width="80"
                        Height="4"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.List.IsBusy, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.List.BusyStatusText, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource AccentBrush}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- 中間卡片：伺服器清單 -->
        <Border Grid.Row="2"
            Style="{StaticResource CardBorderStyle}"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                    Text="伺服器清單"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextBrush}"
                    Margin="0,0,0,12" />

                <controls:TableFrame Grid.Row="1">
                    <controls:TableFrame.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="{x:Bind views:ServerListColumns.Current.NameWidth, Mode=OneWay}" />
                                <ColumnDefinition
                                    Width="{x:Bind views:ServerListColumns.Current.VersionWidth, Mode=OneWay}" />
                                <ColumnDefinition
                                    Width="{x:Bind views:ServerListColumns.Current.LoaderWidth, Mode=OneWay}" />
                                <ColumnDefinition
                                    Width="{x:Bind views:ServerListColumns.Current.StatusWidth, Mode=OneWay}" />
                                <ColumnDefinition
                                    Width="{x:Bind views:ServerListColumns.Current.SizeWidth, Mode=OneWay}" />
                                <ColumnDefinition
                                    Width="{x:Bind views:ServerListColumns.Current.ModifiedWidth, Mode=OneWay}" />
                                <ColumnDefinition
                                    Width="{x:Bind views:ServerListColumns.Current.BackupWidth, Mode=OneWay}" />
                                <ColumnDefinition
                                    Width="{x:Bind views:ServerListColumns.Current.PathWidth, Mode=OneWay}" />
                            </Grid.ColumnDefinitions>

                            <controls:SortableTableHeader Grid.Column="0"
                                Text="名稱"
                                SortPropertyName="Name"
                                ColumnWidth="{x:Bind views:ServerListColumns.Current.NameWidth, Mode=TwoWay}"
                                SortRequested="OnHeaderSortRequested"
                                AutoFitRequested="OnHeaderAutoFitRequested" />
                            <controls:SortableTableHeader Grid.Column="1"
                                Text="版本"
                                SortPropertyName="Version"
                                ColumnWidth="{x:Bind views:ServerListColumns.Current.VersionWidth, Mode=TwoWay}"
                                SortRequested="OnHeaderSortRequested"
                                AutoFitRequested="OnHeaderAutoFitRequested" />
                            <controls:SortableTableHeader Grid.Column="2"
                                Text="載入器"
                                SortPropertyName="Loader"
                                ColumnWidth="{x:Bind views:ServerListColumns.Current.LoaderWidth, Mode=TwoWay}"
                                SortRequested="OnHeaderSortRequested"
                                AutoFitRequested="OnHeaderAutoFitRequested" />
                            <controls:SortableTableHeader Grid.Column="3"
                                Text="狀態"
                                SortPropertyName="Status"
                                ColumnWidth="{x:Bind views:ServerListColumns.Current.StatusWidth, Mode=TwoWay}"
                                SortRequested="OnHeaderSortRequested"
                                AutoFitRequested="OnHeaderAutoFitRequested" />
                            <controls:SortableTableHeader Grid.Column="4"
                                Text="目錄大小"
                                SortPropertyName="Size"
                                ColumnWidth="{x:Bind views:ServerListColumns.Current.SizeWidth, Mode=TwoWay}"
                                SortRequested="OnHeaderSortRequested"
                                AutoFitRequested="OnHeaderAutoFitRequested" />
                            <controls:SortableTableHeader Grid.Column="5"
                                Text="修改日期"
                                SortPropertyName="LastModified"
                                ColumnWidth="{x:Bind views:ServerListColumns.Current.ModifiedWidth, Mode=TwoWay}"
                                SortRequested="OnHeaderSortRequested"
                                AutoFitRequested="OnHeaderAutoFitRequested" />
                            <controls:SortableTableHeader Grid.Column="6"
                                Text="備份狀態"
                                SortPropertyName="BackupStatus"
                                ColumnWidth="{x:Bind views:ServerListColumns.Current.BackupWidth, Mode=TwoWay}"
                                SortRequested="OnHeaderSortRequested"
                                AutoFitRequested="OnHeaderAutoFitRequested" />
                            <controls:SortableTableHeader Grid.Column="7"
                                Text="相對路徑"
                                SortPropertyName="RelativePath"
                                ColumnWidth="{x:Bind views:ServerListColumns.Current.PathWidth, Mode=TwoWay}"
                                SortRequested="OnHeaderSortRequested"
                                AutoFitRequested="OnHeaderAutoFitRequested" />
                        </Grid>
                    </controls:TableFrame.Header>

                    <ListView ItemsSource="{x:Bind ViewModel.List.Servers}"
                        SelectedItem="{x:Bind ViewModel.List.SelectedServer, Mode=TwoWay}"
                        SelectionMode="Single"
                        controls:ListSelectionBehavior.ClearOnOutsidePress="True"
                        MinHeight="180"
                        ItemContainerStyle="{StaticResource TableListViewItemStyle}"
                        DoubleTapped="OnServersListViewDoubleTapped">
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="🧠 修改記憶體設定"
                                    Command="{x:Bind ViewModel.EditServerMemoryCommand}" />
                                <MenuFlyoutItem Text="🔄 重新偵測伺服器"
                                    Command="{x:Bind ViewModel.RecheckServerCommand}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="📂 開啟備份資料夾"
                                    Command="{x:Bind ViewModel.Backup.OpenBackupFolderCommand}" />
                                <MenuFlyoutItem Text="📁 修改備份路徑"
                                    Command="{x:Bind ViewModel.Backup.EditBackupPathCommand}" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServerRowItem">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="{x:Bind views:ServerListColumns.Current.NameWidth, Mode=OneWay}" />
                                        <ColumnDefinition
                                            Width="{x:Bind views:ServerListColumns.Current.VersionWidth, Mode=OneWay}" />
                                        <ColumnDefinition
                                            Width="{x:Bind views:ServerListColumns.Current.LoaderWidth, Mode=OneWay}" />
                                        <ColumnDefinition
                                            Width="{x:Bind views:ServerListColumns.Current.StatusWidth, Mode=OneWay}" />
                                        <ColumnDefinition
                                            Width="{x:Bind views:ServerListColumns.Current.SizeWidth, Mode=OneWay}" />
                                        <ColumnDefinition
                                            Width="{x:Bind views:ServerListColumns.Current.ModifiedWidth, Mode=OneWay}" />
                                        <ColumnDefinition
                                            Width="{x:Bind views:ServerListColumns.Current.BackupWidth, Mode=OneWay}" />
                                        <ColumnDefinition
                                            Width="{x:Bind views:ServerListColumns.Current.PathWidth, Mode=OneWay}" />
                                    </Grid.ColumnDefinitions>

                                    <controls:TableCell Grid.Column="0"
                                        Text="{x:Bind Name, Mode=OneWay}" />
                                    <controls:TableCell Grid.Column="1"
                                        Text="{x:Bind Version, Mode=OneWay}" />
                                    <controls:TableCell Grid.Column="2"
                                        Text="{x:Bind Loader, Mode=OneWay}" />
                                    <Border Grid.Column="3"
                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                        BorderThickness="0,0,1,0"
                                        Padding="8,6">
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                            controls:ThemeBrush.ForegroundKey="{x:Bind controls:UiBindHelpers.ErrorBrushKey(HasMissingFiles), Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <controls:TableCell Grid.Column="4"
                                        Text="{x:Bind Size, Mode=OneWay}" />
                                    <controls:TableCell Grid.Column="5"
                                        Text="{x:Bind LastModified, Mode=OneWay}" />
                                    <controls:TableCell Grid.Column="6"
                                        Text="{x:Bind BackupStatus, Mode=OneWay}" />
                                    <Border Grid.Column="7"
                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                        BorderThickness="0,0,1,0"
                                        Padding="8,6">
                                        <TextBlock Text="{x:Bind RelativePath, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </controls:TableFrame>
            </Grid>
        </Border>

        <!-- 底部操作區 -->
        <StackPanel Grid.Row="3"
            Spacing="6">
            <TextBlock Text="操作"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextBrush}" />

            <!-- 未選取伺服器時的提示 -->
            <TextBlock Text="請於上方清單中選取伺服器以檢視詳細資訊與執行操作"
                Foreground="{ThemeResource MutedTextBrush}"
                Margin="0,0,0,10"
                Visibility="{x:Bind controls:UiBindHelpers.InverseBoolToVis(ViewModel.List.HasSelectedServer), Mode=OneWay}" />

            <!-- 選取伺服器時之橫向平均分配詳細資訊區 -->
            <Grid Margin="0,0,0,10"
                Visibility="{x:Bind ViewModel.List.HasSelectedServer, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 第 1 列：基本識別資訊 -->
                <TextBlock Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,4"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="伺服器名稱："
                        Foreground="{ThemeResource MutedTextBrush}" />
                    <Run Text="{x:Bind ViewModel.List.SelectedServer.Name, Mode=OneWay}"
                        Foreground="{ThemeResource TextBrush}"
                        FontWeight="SemiBold" />
                </TextBlock>

                <TextBlock Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,8,4"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="Minecraft 版本："
                        Foreground="{ThemeResource MutedTextBrush}" />
                    <Run Text="{x:Bind ViewModel.List.SelectedServer.Version, Mode=OneWay}"
                        Foreground="{ThemeResource TextBrush}"
                        FontWeight="SemiBold" />
                </TextBlock>

                <TextBlock Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,8,4"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="載入器類型："
                        Foreground="{ThemeResource MutedTextBrush}" />
                    <Run Text="{x:Bind ViewModel.List.SelectedServer.Loader, Mode=OneWay}"
                        Foreground="{ThemeResource TextBrush}"
                        FontWeight="SemiBold" />
                </TextBlock>

                <TextBlock Grid.Row="0"
                    Grid.Column="3"
                    Margin="0,0,0,4"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="目前狀態："
                        Foreground="{ThemeResource MutedTextBrush}" />
                    <Run Text="{x:Bind ViewModel.List.SelectedServer.Status, Mode=OneWay}"
                        Foreground="{ThemeResource TextBrush}"
                        FontWeight="SemiBold" />
                </TextBlock>

                <!-- 第 2 列：資源與備份資訊 -->
                <TextBlock Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,8,4"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="目錄大小："
                        Foreground="{ThemeResource MutedTextBrush}" />
                    <Run Text="{x:Bind ViewModel.List.SelectedServer.Size, Mode=OneWay}"
                        Foreground="{ThemeResource TextBrush}" />
                </TextBlock>

                <TextBlock Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,8,4"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="記憶體配置："
                        Foreground="{ThemeResource MutedTextBrush}" />
                    <Run Text="{x:Bind ViewModel.List.SelectedServerMemory, Mode=OneWay}"
                        Foreground="{ThemeResource TextBrush}" />
                </TextBlock>

                <TextBlock Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,0,8,4"
                    TextTrimming="CharacterEllipsis">
                    <Run Text="備份狀況："
                        Foreground="{ThemeResource MutedTextBrush}" />
                    <Run Text="{x:Bind ViewModel.List.SelectedServer.BackupStatus, Mode=OneWay}"
                        Foreground="{ThemeResource TextBrush}" />
                </TextBlock>

                <TextBlock Grid.Row="1"
                    Grid.Column="3"
                    Margin="0,0,0,4"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.List.SelectedServerBackupPath, Mode=OneWay}">
                    <Run Text="外部備份路徑："
                        Foreground="{ThemeResource MutedTextBrush}" />
                    <Run Text="{x:Bind ViewModel.List.SelectedServerBackupPath, Mode=OneWay}"
                        Foreground="{ThemeResource TextBrush}" />
                </TextBlock>

                <!-- 第 3 列：實體路徑 -->
                <TextBlock Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="4"
                    Margin="0,0,0,4"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind ViewModel.List.SelectedServer.Path, Mode=OneWay}">
                    <Run Text="實體路徑："
                        Foreground="{ThemeResource MutedTextBrush}" />
                    <Run Text="{x:Bind ViewModel.List.SelectedServer.Path, Mode=OneWay}"
                        Foreground="{ThemeResource TextBrush}" />
                </TextBlock>
            </Grid>

            <controls:WrapPanel ItemSpacing="8"
                LineSpacing="8">
                <Button Command="{x:Bind ViewModel.Lifecycle.StartServerCommand}"
                    IsEnabled="{x:Bind ViewModel.List.CanStartOrMonitorServer, Mode=OneWay}"
                    Visibility="{x:Bind controls:UiBindHelpers.InverseBoolToVis(ViewModel.List.IsSelectedServerActive), Mode=OneWay}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="120"
                    Height="32">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ContentPresenter ContentTemplate="{StaticResource IconStart}"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center" />
                        <TextBlock Text="啟動"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.Lifecycle.StopServerCommand}"
                    IsEnabled="{x:Bind ViewModel.List.HasSelectedServer, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.List.IsSelectedServerActive, Mode=OneWay}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="120"
                    Height="32">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <TextBlock Text="⏹️"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Foreground="#FFFFFF" />
                        <TextBlock Text="停止"
                            VerticalAlignment="Center"
                            Foreground="#FFFFFF" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.Lifecycle.MonitorServerCommand}"
                    IsEnabled="{x:Bind ViewModel.List.CanStartOrMonitorServer, Mode=OneWay}"
                    Width="120"
                    Height="32">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ContentPresenter ContentTemplate="{StaticResource IconConsole}"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center" />
                        <TextBlock Text="監控"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.ConfigureServerCommand}"
                    IsEnabled="{x:Bind ViewModel.List.HasSelectedServer, Mode=OneWay}"
                    Width="120"
                    Height="32">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ContentPresenter ContentTemplate="{StaticResource IconServerSettings}"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center" />
                        <TextBlock Text="設定"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.ManagePlayersCommand}"
                    IsEnabled="{x:Bind ViewModel.List.CanManagePlayers, Mode=OneWay}"
                    ToolTipService.ToolTip="管理伺服器管理員 (ops)、白名單 (whitelist) 與封鎖名單 (bans)"
                    Width="120"
                    Height="32">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ContentPresenter ContentTemplate="{StaticResource IconUserGroup}"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center" />
                        <TextBlock Text="名單管理"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.OpenServerFolderCommand}"
                    IsEnabled="{x:Bind ViewModel.List.HasSelectedServer, Mode=OneWay}"
                    Width="120"
                    Height="32">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ContentPresenter ContentTemplate="{StaticResource IconFolder}"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center" />
                        <TextBlock Text="開啟資料夾"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.Backup.BackupServerCommand}"
                    IsEnabled="{x:Bind ViewModel.List.HasSelectedServer, Mode=OneWay}"
                    Width="120"
                    Height="32">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ContentPresenter ContentTemplate="{StaticResource IconBackup}"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center" />
                        <TextBlock Text="備份伺服器"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.Backup.RestoreBackupCommand}"
                    IsEnabled="{x:Bind ViewModel.List.HasSelectedServer, Mode=OneWay}"
                    Width="120"
                    Height="32">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ContentPresenter ContentTemplate="{StaticResource IconRestore}"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center" />
                        <TextBlock Text="還原備份"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.DeleteServerCommand}"
                    IsEnabled="{x:Bind ViewModel.List.HasSelectedServer, Mode=OneWay}"
                    Style="{StaticResource DangerButtonStyle}"
                    Width="120"
                    Height="32">
                    <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ContentPresenter ContentTemplate="{StaticResource IconDelete}"
                            Width="15"
                            Height="15"
                            VerticalAlignment="Center" />
                        <TextBlock Text="刪除"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </controls:WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>