<Window
  x:Class="MinecraftServerManager.App.Views.ModInstallQueueWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels">

  <Grid Style="{StaticResource DialogRootGridStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
      Style="{StaticResource SecondaryCaptionTextStyle}"
      Text="目前已排入安裝佇列的模組與相依項目如下：" />

    <controls:TableFrame Grid.Row="1"
      SortTarget="{x:Bind HeaderSort}"
      IsEmpty="{x:Bind controls:UiBindHelpers.IsEmpty(ViewModel.Queue.Count), Mode=OneWay}"
      EmptyText="待安裝清單是空的">
      <controls:TableFrame.Header>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="75" />
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:SortableTableHeader Grid.Column="0"
            Text="動作"
            SortPropertyName="ActionText" />
          <controls:SortableTableHeader Grid.Column="1"
            Text="模組名稱"
            SortPropertyName="Title" />
          <controls:SortableTableHeader Grid.Column="2"
            Text="版本"
            SortPropertyName="VersionDisplay" />
          <controls:SortableTableHeader Grid.Column="3"
            Text="檔案名稱"
            SortPropertyName="FileName" />
          <controls:SortableTableHeader Grid.Column="4"
            Text="原因 / 說明"
            SortPropertyName="Reason" />
        </Grid>
      </controls:TableFrame.Header>
      <controls:TableFrame.Body>
        <ListView Style="{StaticResource TableListViewStyle}"
          ItemsSource="{x:Bind ViewModel.Queue}"
          SelectionMode="None"
          AutomationProperties.Name="待安裝模組">
          <ListView.ItemTemplate>
            <DataTemplate
              x:DataType="vm:ModInstallQueueItem">
              <Grid>
                <controls:TableCell Grid.Column="0"
                  Text="{x:Bind ActionText}" />
                <controls:TableCell Grid.Column="1"
                  Text="{x:Bind Title}" />
                <controls:TableCell Grid.Column="2"
                  Text="{x:Bind VersionDisplay}" />
                <controls:TableCell Grid.Column="3"
                  Text="{x:Bind FileName}" />
                <controls:TableCell Grid.Column="4"
                  Text="{x:Bind Reason}"
                  ShowRightBorder="False" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </controls:TableFrame.Body>
    </controls:TableFrame>

    <Grid Grid.Row="2">
      <Button HorizontalAlignment="Left"
        Content="清空清單"
        Command="{x:Bind ViewModel.ClearQueueCommand}" />
      <StackPanel HorizontalAlignment="Right"
        Orientation="Horizontal"
        Spacing="10">
        <Button Style="{StaticResource PrimaryButtonStyle}"
          MinWidth="100"
          Content="開始安裝"
          Command="{x:Bind ViewModel.StartInstallCommand}" />
        <Button MinWidth="80"
          Content="關閉"
          Command="{x:Bind ViewModel.CloseCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
