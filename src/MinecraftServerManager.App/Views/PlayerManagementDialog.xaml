<Window x:Class="MinecraftServerManager.App.Views.PlayerManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MinecraftServerManager.App.ViewModels"
        Title="伺服器名單管理"
        Width="1020"
        Height="680"
        MinWidth="880"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 頂部標題說明 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="伺服器名單與權限管理" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
      <TextBlock Text="管理 Minecraft 伺服器之營運管理員 (ops.json)、白名單 (whitelist.json) 及封鎖清單 (banned-players.json / banned-ips.json)"
                 Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
    </StackPanel>

    <!-- 主內容雙側區域 -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 左側：曾連線玩家名冊 (usercache.json) 唯讀參考清單 -->
      <Border Grid.Column="0"
              Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="曾連線玩家名冊 (usercache)" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
          <TextBox Grid.Row="1" Text="{Binding PlayerSearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                   Margin="0,0,0,10"
                   Padding="6,4"
                   ToolTip="搜尋玩家名稱" />

          <ListBox Grid.Row="2" ItemsSource="{Binding FilteredUserCache}"
                   VirtualizingStackPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   ScrollViewer.CanContentScroll="True"
                   SelectedItem="{Binding SelectedUserCacheEntry}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   Background="{DynamicResource WindowBrush}"
                   Foreground="{DynamicResource TextBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="1">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonDefaultHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="true">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NotificationBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" FontSize="13" />
                    <TextBlock Text="{Binding Uuid}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Uuid}" />
                    <TextBlock Text="{Binding FormattedExpiresOn, StringFormat='記錄時間：{0}'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,2,0,0" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="3" Text="提示：左側為本地快取玩家，右側各分頁可直接選取加入名單"
                     Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
        </Grid>
      </Border>

      <!-- 右側：4 個分頁標籤管理設定檔案 -->
      <TabControl Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}">

        <!-- 分頁 1：👑 管理員名單 (ops.json) -->
        <TabItem Header="👑 管理員名單 (ops.json)">
          <Grid Margin="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 說明指南區 -->
            <Border Grid.Row="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="【管理員權限等級（Level）指南】" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                <TextBlock Text="• Level 4：完整控制權限，可使用 /stop、/save-all、/save-off 等伺服器維護指令。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                <TextBlock Text="• Level 3：玩家管理權限，可使用 /op、/deop、/kick、/ban、/pardon 等名單管理指令。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                <TextBlock Text="• Level 2：基礎管理員與指令方塊，可使用 /gamemode、/tp、/give、/gamerule 等指令。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                <TextBlock Text="• Level 1：僅略過出生點方塊保護，無任何作弊指令權限。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
              </StackPanel>
            </Border>

            <!-- 全玩家可控管理員名單 DataGrid -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding OperatorRows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="管理員" Width="75">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsOp, UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="玩家名稱" Binding="{Binding Name}" IsReadOnly="True" Width="140" />
                <DataGridTemplateColumn Header="權限等級" Width="95">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox ItemsSource="{x:Static vm:OperatorRowItem.AvailableLevels}"
                                SelectedItem="{Binding Level, UpdateSourceTrigger=PropertyChanged}"
                                IsEnabled="{Binding IsOp}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="略過人數限制" Width="105">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding BypassesPlayerLimit, UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="UUID" Binding="{Binding Uuid}" IsReadOnly="True" Width="*" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- 分頁 2：📋 白名單 (whitelist.json) -->
        <TabItem Header="📋 白名單 (whitelist.json)">
          <Grid Margin="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 說明區 -->
            <Border Grid.Row="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
              <TextBlock Text="白名單用途：當伺服器屬性 (server.properties) 開啟 white-list=true 時，只有被加入白名單的玩家才能連入伺服器。"
                         Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- 新增列 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="選擇玩家：" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0" />
              <ComboBox ItemsSource="{Binding AvailableCandidates}"
                        SelectedItem="{Binding SelectedWhitelistCandidate}"
                        DisplayMemberPath="Name"
                        Width="160"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center" />

              <Button Content="加入白名單"
                      Command="{Binding AddWhitelistCommand}"
                      Style="{DynamicResource PrimaryButtonStyle}"
                      Padding="14,4"
                      VerticalAlignment="Center" />
            </StackPanel>

            <!-- 白名單 DataGrid -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Whitelist}" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1">
              <DataGrid.Columns>
                <DataGridTextColumn Header="玩家名稱" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="UUID" Binding="{Binding Uuid}" Width="*" />
                <DataGridTemplateColumn Header="操作" Width="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="移除"
                              Command="{Binding DataContext.RemoveWhitelistCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              CommandParameter="{Binding}"
                              Style="{DynamicResource DangerButtonStyle}"
                              Padding="8,2"
                              FontSize="11" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- 分頁 3：🚫 封鎖玩家 (banned-players.json) -->
        <TabItem Header="🚫 封鎖玩家 (banned-players.json)">
          <Grid Margin="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 說明區 -->
            <Border Grid.Row="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
              <TextBlock Text="封鎖玩家用途：將指定的玩家帳號加入黑名單，連線時將顯示封鎖原因並予以拒絕連線。"
                         Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <!-- 新增列 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="玩家：" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0" />
              <ComboBox ItemsSource="{Binding AvailableCandidates}"
                        SelectedItem="{Binding SelectedBanCandidate}"
                        DisplayMemberPath="Name"
                        Width="140"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center" />

              <TextBlock Text="原因：" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0" />
              <TextBox Text="{Binding BanPlayerReason, UpdateSourceTrigger=PropertyChanged}"
                       Width="200"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Padding="4,2" />

              <Button Content="封鎖玩家"
                      Command="{Binding AddBannedPlayerCommand}"
                      Style="{DynamicResource DangerButtonStyle}"
                      Padding="14,4"
                      VerticalAlignment="Center" />
            </StackPanel>

            <!-- 封鎖玩家清單 DataGrid -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding BannedPlayers}" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1">
              <DataGrid.Columns>
                <DataGridTextColumn Header="玩家名稱" Binding="{Binding Name}" Width="140" />
                <DataGridTextColumn Header="封鎖原因" Binding="{Binding Reason}" Width="180" />
                <DataGridTextColumn Header="封鎖時間" Binding="{Binding FormattedCreated}" Width="150" />
                <DataGridTextColumn Header="UUID" Binding="{Binding Uuid}" Width="*" />
                <DataGridTemplateColumn Header="操作" Width="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="解除封鎖"
                              Command="{Binding DataContext.RemoveBannedPlayerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              CommandParameter="{Binding}"
                              Padding="8,2"
                              FontSize="11" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>

        <!-- 分頁 4：🌐 封鎖 IP (banned-ips.json) -->
        <TabItem Header="🌐 封鎖 IP (banned-ips.json)">
          <Grid Margin="12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 說明區 -->
            <Border Grid.Row="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="【封鎖 IP 用途與官方查詢指引】" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
                <TextBlock Text="• 封鎖指定的 IPv4 或 IPv6 位址，來自該網路位址的所有玩家均無法連線至此伺服器。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,4" />
                <TextBlock Text="• 如何查詢玩家連線 IP：" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" FontSize="11" />
                <TextBlock Text="   1. 控制台指令：於伺服器控制台直接輸入 /ban-ip &lt;玩家名稱&gt;，伺服器會自動查詢該玩家最後登入 IP 並加入封鎖。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                <TextBlock Text="   2. 記錄檔查詢：開啟伺服器 logs/latest.log 檔案，搜尋玩家名稱，尋找「[Server thread/INFO]: &lt;玩家&gt;[/&lt;IP位址&gt;:&lt;Port&gt;] logged in」即可取得真實 IP。" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
              </StackPanel>
            </Border>

            <!-- 新增列 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
              <TextBlock Text="IP 位址：" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0" />
              <TextBox Text="{Binding BanIpAddress, UpdateSourceTrigger=PropertyChanged}"
                       Width="140"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Padding="4,2" />

              <TextBlock Text="原因：" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0" />
              <TextBox Text="{Binding BanIpReason, UpdateSourceTrigger=PropertyChanged}"
                       Width="180"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Padding="4,2" />

              <Button Content="封鎖 IP"
                      Command="{Binding AddBannedIpCommand}"
                      Style="{DynamicResource DangerButtonStyle}"
                      Padding="14,4"
                      VerticalAlignment="Center" />
            </StackPanel>

            <!-- 封鎖 IP 清單 DataGrid -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding BannedIps}" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1">
              <DataGrid.Columns>
                <DataGridTextColumn Header="IP 位址" Binding="{Binding Ip}" Width="180" />
                <DataGridTextColumn Header="封鎖原因" Binding="{Binding Reason}" Width="200" />
                <DataGridTextColumn Header="封鎖時間" Binding="{Binding FormattedCreated}" Width="*" />
                <DataGridTemplateColumn Header="操作" Width="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Button Content="解除封鎖"
                              Command="{Binding DataContext.RemoveBannedIpCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                              CommandParameter="{Binding}"
                              Padding="8,2"
                              FontSize="11" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- 底部列：狀態訊息與操作按鈕 -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0"
                 Text="{Binding StatusMessage}"
                 Foreground="{DynamicResource TextBrush}"
                 FontSize="12"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" />

      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消"
                Command="{Binding CancelCommand}"
                Margin="0,0,10,0"
                Padding="16,6" />
        <Button Content="儲存變更"
                Command="{Binding SaveCommand}"
                Style="{DynamicResource PrimaryButtonStyle}"
                Padding="20,6" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
