<Window x:Class="MinecraftServerManager.App.Views.PlayerManagementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MinecraftServerManager.App.Controls"
    xmlns:views="using:MinecraftServerManager.App.Views"
    xmlns:vm="using:MinecraftServerManager.App.ViewModels"
    xmlns:servers="using:MinecraftServerManager.Domain.Servers">

    <Grid Background="{ThemeResource WindowBrush}"
        Padding="20"
        RowSpacing="12">
        <Grid.Resources>
            <DataTemplate x:Key="CandidateNameTemplate"
                x:DataType="servers:ServerUserCacheEntry">
                <TextBlock Text="{x:Bind Name}" />
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 頂部標題說明 -->
        <StackPanel Grid.Row="0"
            Spacing="4">
            <TextBlock Text="伺服器名單與權限管理"
                Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Text="管理 Minecraft 伺服器之營運管理員 (ops.json)、白名單 (whitelist.json) 及封鎖清單 (banned-players.json / banned-ips.json)"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>

        <!-- 主內容雙側區域 -->
        <Grid Grid.Row="1"
            ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左側：曾連線玩家名冊 (usercache.json) 唯讀參考清單 -->
            <Border Grid.Column="0"
                Style="{StaticResource CardBorderStyle}"
                CornerRadius="8"
                Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                        Text="曾連線玩家名冊 (usercache)"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBox Grid.Row="1"
                        Text="{x:Bind ViewModel.PlayerSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="搜尋玩家名稱..." />

                    <ListView Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.FilteredUserCache}"
                        SelectedItem="{x:Bind ViewModel.SelectedUserCacheEntry, Mode=TwoWay}"
                        SelectionMode="Single"
                        controls:ListSelectionBehavior.ClearOnOutsidePress="True">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="servers:ServerUserCacheEntry">
                                <StackPanel Padding="4,4"
                                    Spacing="2">
                                    <TextBlock Text="{x:Bind Name}"
                                        FontWeight="Bold"
                                        Style="{ThemeResource BodyTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Uuid}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Uuid}" />
                                    <TextBlock Text="{x:Bind FormattedExpiresOn}"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="3"
                        Text="提示：左側為本地快取玩家，右側各分頁可直接選取加入名單"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- 右側：4 個分頁標籤管理設定檔案 -->
            <TabView Grid.Column="1"
                CanDragTabs="False"
                CanReorderTabs="False"
                IsAddTabButtonVisible="False"
                TabWidthMode="SizeToContent">
                <TabView.TabItems>
                    <!-- 分頁 1：👑 管理員名單 (ops.json) -->
                    <TabViewItem Header="👑 管理員名單 (ops.json)"
                        IsClosable="False">
                        <Grid Margin="12"
                            RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 說明指南區 -->
                            <Border Grid.Row="0"
                                Style="{StaticResource CardBorderStyle}"
                                CornerRadius="6"
                                Padding="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="【管理員權限等級（Level）指南】"
                                        FontWeight="Bold"
                                        Style="{ThemeResource BodyTextBlockStyle}" />
                                    <TextBlock
                                        Text="• Level 4：完整控制權限，可使用 /stop、/save-all、/save-off 等伺服器維護指令。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="• Level 3：玩家管理權限，可使用 /op、/deop、/kick、/ban、/pardon 等名單管理指令。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="• Level 2：基礎管理員與指令方塊，可使用 /gamemode、/tp、/give、/gamerule 等指令。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock Text="• Level 1：僅略過出生點方塊保護，無任何作弊指令權限。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Border>

                            <!-- 全玩家可控管理員名單 ListView -->
                            <Border Grid.Row="1"
                                Style="{StaticResource CardBorderStyle}"
                                CornerRadius="6"
                                Padding="10">
                                <controls:TableFrame>
                                    <controls:TableFrame.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition
                                                    Width="{x:Bind views:OperatorListColumns.Current.IsOpWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:OperatorListColumns.Current.NameWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:OperatorListColumns.Current.LevelWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:OperatorListColumns.Current.BypassWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:OperatorListColumns.Current.UuidWidth, Mode=OneWay}" />
                                            </Grid.ColumnDefinitions>
                                            <controls:SortableTableHeader Grid.Column="0"
                                                Text="管理員"
                                                SortPropertyName="IsOp"
                                                ColumnWidth="{x:Bind views:OperatorListColumns.Current.IsOpWidth, Mode=TwoWay}"
                                                SortRequested="OnOperatorSortRequested"
                                                AutoFitRequested="OnOperatorAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="1"
                                                Text="玩家名稱"
                                                SortPropertyName="Name"
                                                ColumnWidth="{x:Bind views:OperatorListColumns.Current.NameWidth, Mode=TwoWay}"
                                                SortRequested="OnOperatorSortRequested"
                                                AutoFitRequested="OnOperatorAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="2"
                                                Text="權限等級"
                                                SortPropertyName="Level"
                                                ColumnWidth="{x:Bind views:OperatorListColumns.Current.LevelWidth, Mode=TwoWay}"
                                                SortRequested="OnOperatorSortRequested"
                                                AutoFitRequested="OnOperatorAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="3"
                                                Text="略過人數限制"
                                                SortPropertyName="BypassesPlayerLimit"
                                                ColumnWidth="{x:Bind views:OperatorListColumns.Current.BypassWidth, Mode=TwoWay}"
                                                SortRequested="OnOperatorSortRequested"
                                                AutoFitRequested="OnOperatorAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="4"
                                                Text="UUID"
                                                SortPropertyName="Uuid"
                                                ColumnWidth="{x:Bind views:OperatorListColumns.Current.UuidWidth, Mode=TwoWay}"
                                                SortRequested="OnOperatorSortRequested"
                                                AutoFitRequested="OnOperatorAutoFitRequested" />
                                        </Grid>
                                    </controls:TableFrame.Header>
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.OperatorRows}"
                                        SelectionMode="None"
                                        ItemContainerStyle="{StaticResource TableListViewItemStyle}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:OperatorRowItem">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:OperatorListColumns.Current.IsOpWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:OperatorListColumns.Current.NameWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:OperatorListColumns.Current.LevelWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:OperatorListColumns.Current.BypassWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:OperatorListColumns.Current.UuidWidth, Mode=OneWay}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                        BorderThickness="0,0,1,0"
                                                        Padding="4,2">
                                                        <CheckBox
                                                            IsChecked="{x:Bind IsOp, Mode=TwoWay}"
                                                            MinWidth="0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                    <controls:TableCell Grid.Column="1"
                                                        Text="{x:Bind Name}" />
                                                    <Border Grid.Column="2"
                                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                        BorderThickness="0,0,1,0"
                                                        Padding="6,2">
                                                        <ComboBox
                                                            ItemsSource="{x:Bind AvailableLevels}"
                                                            SelectedItem="{x:Bind Level, Mode=TwoWay}"
                                                            IsEnabled="{x:Bind IsOp, Mode=OneWay}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Stretch" />
                                                    </Border>
                                                    <Border Grid.Column="3"
                                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                        BorderThickness="0,0,1,0"
                                                        Padding="4,2">
                                                        <CheckBox
                                                            IsChecked="{x:Bind BypassesPlayerLimit, Mode=TwoWay}"
                                                            IsEnabled="{x:Bind IsOp, Mode=OneWay}"
                                                            MinWidth="0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                    <controls:TableCell Grid.Column="4"
                                                        Text="{x:Bind Uuid}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </controls:TableFrame>
                            </Border>
                        </Grid>
                    </TabViewItem>

                    <!-- 分頁 2：📋 白名單 (whitelist.json) -->
                    <TabViewItem Header="📋 白名單 (whitelist.json)"
                        IsClosable="False">
                        <Grid Margin="12"
                            RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                Style="{StaticResource CardBorderStyle}"
                                CornerRadius="6"
                                Padding="10">
                                <TextBlock
                                    Text="白名單用途：當伺服器屬性 (server.properties) 開啟 white-list=true 時，只有被加入白名單的玩家才能連入伺服器。"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock Text="選擇玩家："
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    ItemsSource="{x:Bind ViewModel.AvailableCandidates, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedWhitelistCandidate, Mode=TwoWay}"
                                    ItemTemplate="{StaticResource CandidateNameTemplate}"
                                    Width="160"
                                    VerticalAlignment="Center" />
                                <Button Content="加入白名單"
                                    Command="{x:Bind ViewModel.AddWhitelistCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Row="2"
                                Style="{StaticResource CardBorderStyle}"
                                CornerRadius="6"
                                Padding="10">
                                <controls:TableFrame>
                                    <controls:TableFrame.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition
                                                    Width="{x:Bind views:WhitelistListColumns.Current.NameWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:WhitelistListColumns.Current.UuidWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:WhitelistListColumns.Current.ActionWidth, Mode=OneWay}" />
                                            </Grid.ColumnDefinitions>
                                            <controls:SortableTableHeader Grid.Column="0"
                                                Text="玩家名稱"
                                                SortPropertyName="Name"
                                                ColumnWidth="{x:Bind views:WhitelistListColumns.Current.NameWidth, Mode=TwoWay}"
                                                SortRequested="OnWhitelistSortRequested"
                                                AutoFitRequested="OnWhitelistAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="1"
                                                Text="UUID"
                                                SortPropertyName="Uuid"
                                                ColumnWidth="{x:Bind views:WhitelistListColumns.Current.UuidWidth, Mode=TwoWay}"
                                                SortRequested="OnWhitelistSortRequested"
                                                AutoFitRequested="OnWhitelistAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="2"
                                                Text="操作"
                                                ShowSplitter="False" />
                                        </Grid>
                                    </controls:TableFrame.Header>
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.Whitelist}"
                                        SelectionMode="None"
                                        ItemContainerStyle="{StaticResource TableListViewItemStyle}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate
                                                x:DataType="servers:ServerWhitelistEntry">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:WhitelistListColumns.Current.NameWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:WhitelistListColumns.Current.UuidWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:WhitelistListColumns.Current.ActionWidth, Mode=OneWay}" />
                                                    </Grid.ColumnDefinitions>
                                                    <controls:TableCell Grid.Column="0"
                                                        Text="{x:Bind Name}" />
                                                    <controls:TableCell Grid.Column="1"
                                                        Text="{x:Bind Uuid}" />
                                                    <Border Grid.Column="2"
                                                        Padding="6,2">
                                                        <Button Content="移除"
                                                            Click="RemoveWhitelist_Click"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </controls:TableFrame>
                            </Border>
                        </Grid>
                    </TabViewItem>

                    <!-- 分頁 3：🚫 封鎖玩家 (banned-players.json) -->
                    <TabViewItem Header="🚫 封鎖玩家 (banned-players.json)"
                        IsClosable="False">
                        <Grid Margin="12"
                            RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                Style="{StaticResource CardBorderStyle}"
                                CornerRadius="6"
                                Padding="10">
                                <TextBlock Text="封鎖玩家用途：將指定的玩家帳號加入黑名單，連線時將顯示封鎖原因並予以拒絕連線。"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock Text="玩家："
                                    VerticalAlignment="Center" />
                                <ComboBox
                                    ItemsSource="{x:Bind ViewModel.AvailableCandidates, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedBanCandidate, Mode=TwoWay}"
                                    ItemTemplate="{StaticResource CandidateNameTemplate}"
                                    Width="140"
                                    VerticalAlignment="Center" />
                                <TextBlock Text="原因："
                                    VerticalAlignment="Center" />
                                <TextBox
                                    Text="{x:Bind ViewModel.BanPlayerReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="200"
                                    VerticalAlignment="Center" />
                                <Button Content="封鎖玩家"
                                    Command="{x:Bind ViewModel.AddBannedPlayerCommand}"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Row="2"
                                Style="{StaticResource CardBorderStyle}"
                                CornerRadius="6"
                                Padding="10">
                                <controls:TableFrame>
                                    <controls:TableFrame.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition
                                                    Width="{x:Bind views:BannedPlayerListColumns.Current.NameWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:BannedPlayerListColumns.Current.ReasonWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:BannedPlayerListColumns.Current.CreatedWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:BannedPlayerListColumns.Current.UuidWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:BannedPlayerListColumns.Current.ActionWidth, Mode=OneWay}" />
                                            </Grid.ColumnDefinitions>
                                            <controls:SortableTableHeader Grid.Column="0"
                                                Text="玩家名稱"
                                                SortPropertyName="Name"
                                                ColumnWidth="{x:Bind views:BannedPlayerListColumns.Current.NameWidth, Mode=TwoWay}"
                                                SortRequested="OnBannedPlayerSortRequested"
                                                AutoFitRequested="OnBannedPlayerAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="1"
                                                Text="封鎖原因"
                                                SortPropertyName="Reason"
                                                ColumnWidth="{x:Bind views:BannedPlayerListColumns.Current.ReasonWidth, Mode=TwoWay}"
                                                SortRequested="OnBannedPlayerSortRequested"
                                                AutoFitRequested="OnBannedPlayerAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="2"
                                                Text="封鎖時間"
                                                SortPropertyName="FormattedCreated"
                                                ColumnWidth="{x:Bind views:BannedPlayerListColumns.Current.CreatedWidth, Mode=TwoWay}"
                                                SortRequested="OnBannedPlayerSortRequested"
                                                AutoFitRequested="OnBannedPlayerAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="3"
                                                Text="UUID"
                                                SortPropertyName="Uuid"
                                                ColumnWidth="{x:Bind views:BannedPlayerListColumns.Current.UuidWidth, Mode=TwoWay}"
                                                SortRequested="OnBannedPlayerSortRequested"
                                                AutoFitRequested="OnBannedPlayerAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="4"
                                                Text="操作"
                                                ShowSplitter="False" />
                                        </Grid>
                                    </controls:TableFrame.Header>
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.BannedPlayers}"
                                        SelectionMode="None"
                                        ItemContainerStyle="{StaticResource TableListViewItemStyle}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate
                                                x:DataType="servers:ServerBannedPlayerEntry">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:BannedPlayerListColumns.Current.NameWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:BannedPlayerListColumns.Current.ReasonWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:BannedPlayerListColumns.Current.CreatedWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:BannedPlayerListColumns.Current.UuidWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:BannedPlayerListColumns.Current.ActionWidth, Mode=OneWay}" />
                                                    </Grid.ColumnDefinitions>
                                                    <controls:TableCell Grid.Column="0"
                                                        Text="{x:Bind Name}" />
                                                    <controls:TableCell Grid.Column="1"
                                                        Text="{x:Bind Reason}" />
                                                    <controls:TableCell Grid.Column="2"
                                                        Text="{x:Bind FormattedCreated}" />
                                                    <controls:TableCell Grid.Column="3"
                                                        Text="{x:Bind Uuid}" />
                                                    <Border Grid.Column="4"
                                                        Padding="6,2">
                                                        <Button Content="解除封鎖"
                                                            Click="RemoveBannedPlayer_Click"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </controls:TableFrame>
                            </Border>
                        </Grid>
                    </TabViewItem>

                    <!-- 分頁 4：🌐 封鎖 IP (banned-ips.json) -->
                    <TabViewItem Header="🌐 封鎖 IP (banned-ips.json)"
                        IsClosable="False">
                        <Grid Margin="12"
                            RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                Style="{StaticResource CardBorderStyle}"
                                CornerRadius="6"
                                Padding="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="【封鎖 IP 用途與官方查詢指引】"
                                        FontWeight="Bold"
                                        Style="{ThemeResource BodyTextBlockStyle}" />
                                    <TextBlock Text="• 封鎖指定的 IPv4 或 IPv6 位址，來自該網路位址的所有玩家均無法連線至此伺服器。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="• 主控台指令：於伺服器主控台輸入 /ban-ip &lt;玩家名稱&gt;，伺服器會自動查詢最後登入 IP 並加入封鎖。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock
                                        Text="• 記錄檔查詢：開啟 logs/latest.log 搜尋玩家名稱，尋找「logged in」紀錄即可取得真實 IP。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock Text="IP 位址："
                                    VerticalAlignment="Center" />
                                <TextBox
                                    Text="{x:Bind ViewModel.BanIpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140"
                                    VerticalAlignment="Center" />
                                <TextBlock Text="原因："
                                    VerticalAlignment="Center" />
                                <TextBox
                                    Text="{x:Bind ViewModel.BanIpReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="180"
                                    VerticalAlignment="Center" />
                                <Button Content="封鎖 IP"
                                    Command="{x:Bind ViewModel.AddBannedIpCommand}"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Row="2"
                                Style="{StaticResource CardBorderStyle}"
                                CornerRadius="6"
                                Padding="10">
                                <controls:TableFrame>
                                    <controls:TableFrame.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition
                                                    Width="{x:Bind views:BannedIpListColumns.Current.IpWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:BannedIpListColumns.Current.ReasonWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:BannedIpListColumns.Current.CreatedWidth, Mode=OneWay}" />
                                                <ColumnDefinition
                                                    Width="{x:Bind views:BannedIpListColumns.Current.ActionWidth, Mode=OneWay}" />
                                            </Grid.ColumnDefinitions>
                                            <controls:SortableTableHeader Grid.Column="0"
                                                Text="IP 位址"
                                                SortPropertyName="Ip"
                                                ColumnWidth="{x:Bind views:BannedIpListColumns.Current.IpWidth, Mode=TwoWay}"
                                                SortRequested="OnBannedIpSortRequested"
                                                AutoFitRequested="OnBannedIpAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="1"
                                                Text="封鎖原因"
                                                SortPropertyName="Reason"
                                                ColumnWidth="{x:Bind views:BannedIpListColumns.Current.ReasonWidth, Mode=TwoWay}"
                                                SortRequested="OnBannedIpSortRequested"
                                                AutoFitRequested="OnBannedIpAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="2"
                                                Text="封鎖時間"
                                                SortPropertyName="FormattedCreated"
                                                ColumnWidth="{x:Bind views:BannedIpListColumns.Current.CreatedWidth, Mode=TwoWay}"
                                                SortRequested="OnBannedIpSortRequested"
                                                AutoFitRequested="OnBannedIpAutoFitRequested" />
                                            <controls:SortableTableHeader Grid.Column="3"
                                                Text="操作"
                                                ShowSplitter="False" />
                                        </Grid>
                                    </controls:TableFrame.Header>
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.BannedIps}"
                                        SelectionMode="None"
                                        ItemContainerStyle="{StaticResource TableListViewItemStyle}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate
                                                x:DataType="servers:ServerBannedIpEntry">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:BannedIpListColumns.Current.IpWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:BannedIpListColumns.Current.ReasonWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:BannedIpListColumns.Current.CreatedWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                            Width="{x:Bind views:BannedIpListColumns.Current.ActionWidth, Mode=OneWay}" />
                                                    </Grid.ColumnDefinitions>
                                                    <controls:TableCell Grid.Column="0"
                                                        Text="{x:Bind Ip}" />
                                                    <controls:TableCell Grid.Column="1"
                                                        Text="{x:Bind Reason}" />
                                                    <controls:TableCell Grid.Column="2"
                                                        Text="{x:Bind FormattedCreated}" />
                                                    <Border Grid.Column="3"
                                                        Padding="6,2">
                                                        <Button Content="解除封鎖"
                                                            Click="RemoveBannedIp_Click"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </controls:TableFrame>
                            </Border>
                        </Grid>
                    </TabViewItem>
                </TabView.TabItems>
            </TabView>
        </Grid>

        <!-- 底部列：狀態訊息與操作按鈕 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10">
                <Button Content="取消"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    MinWidth="80" />
                <Button Content="儲存變更"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    MinWidth="100" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>