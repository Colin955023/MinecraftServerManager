<Window
  x:Class="MinecraftServerManager.App.Views.ServerPropertiesWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels"
  xmlns:views="using:MinecraftServerManager.App.Views"
  xmlns:controls="using:MinecraftServerManager.App.Controls">

  <Grid Style="{StaticResource DialogRootGridStyle}">
    <Grid.Resources>
      <DataTemplate x:Key="PropertyTextEditorTemplate"
        x:DataType="vm:PropertyEditItem">
        <TextBox VerticalAlignment="Center"
          Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          PlaceholderText="{x:Bind DefaultValue}"
          AutomationProperties.Name="{x:Bind Key}" />
      </DataTemplate>
      <DataTemplate x:Key="PropertyBoolEditorTemplate"
        x:DataType="vm:PropertyEditItem">
        <CheckBox VerticalAlignment="Center"
          Content="啟用"
          IsChecked="{x:Bind BoolValue, Mode=TwoWay}"
          AutomationProperties.Name="{x:Bind Key}" />
      </DataTemplate>
      <DataTemplate x:Key="PropertyOptionsEditorTemplate"
        x:DataType="vm:PropertyEditItem">
        <ComboBox HorizontalAlignment="Stretch"
          VerticalAlignment="Center"
          ItemsSource="{x:Bind Options}"
          SelectedItem="{x:Bind Value, Mode=TwoWay}"
          AutomationProperties.Name="{x:Bind Key}" />
      </DataTemplate>
      <views:PropertyEditorTemplateSelector x:Key="PropertyEditorSelector"
        TextTemplate="{StaticResource PropertyTextEditorTemplate}"
        BoolTemplate="{StaticResource PropertyBoolEditorTemplate}"
        OptionsTemplate="{StaticResource PropertyOptionsEditorTemplate}" />
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 說明 -->
    <TextBlock Grid.Row="0"
      Style="{StaticResource SecondaryCaptionTextStyle}"
      Text="修改 server.properties 設定檔，支援 60+ 項官方設定、中文說明與預設值還原" />

    <!-- 搜尋與分類過濾列 -->
    <Grid Grid.Row="1"
      ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- 快速搜尋輸入框 -->
      <TextBox Grid.Column="0"
        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        PlaceholderText="搜尋屬性名稱或中文說明..."
        controls:TextBoxShortcuts.FocusOnCtrlF="True"
        AutomationProperties.Name="搜尋屬性" />

      <!-- 分類下拉選單 -->
      <ComboBox Grid.Column="1"
        HorizontalAlignment="Stretch"
        ItemsSource="{x:Bind ViewModel.Categories}"
        SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
        AutomationProperties.Name="屬性分類" />

      <!-- 全部還原預設值按鈕 -->
      <Button Grid.Column="2"
        Content="全部還原預設值"
        Command="{x:Bind ViewModel.ResetAllToDefaultCommand}"
        Style="{StaticResource DangerButtonStyle}" />
    </Grid>

    <!-- 屬性清單區域 -->
    <Border Grid.Row="2"
      Style="{StaticResource CardBorderStyle}"
      Padding="8">
      <Grid>
        <ListView x:Name="PropertiesListView"
          ItemsSource="{x:Bind ViewModel.DisplayItems}"
          SelectionMode="None"
          AutomationProperties.Name="伺服器屬性">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:PropertyEditItem">
              <Grid Margin="0,4,0,4"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="240" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 屬性鍵名與提示說明 -->
                <StackPanel Grid.Column="0"
                  VerticalAlignment="Center"
                  Spacing="2">
                  <TextBlock Text="{x:Bind Key}"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Description}" />
                  <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}"
                    Text="{x:Bind Description}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Description}" />
                </StackPanel>

                <!-- 編輯器控制項（依屬性型別動態選擇範本，避免隱藏控制項誤繫結） -->
                <ContentControl Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalContentAlignment="Stretch"
                  Content="{x:Bind}"
                  ContentTemplateSelector="{StaticResource PropertyEditorSelector}" />

                <!-- 重設單項預設值按鈕 -->
                <Button Grid.Column="2"
                  VerticalAlignment="Center"
                  Content="預設"
                  Click="OnResetItemClicked"
                  ToolTipService.ToolTip="{x:Bind DefaultValue}"
                  AutomationProperties.Name="{x:Bind controls:UiBindHelpers.ActionFor('重設預設值', Key)}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <TextBlock Style="{StaticResource BodyTextBlockStyle}"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Text="沒有符合條件的屬性"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
          Visibility="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}"
          IsHitTestVisible="False"
          AutomationProperties.LiveSetting="Polite" />
      </Grid>
    </Border>

    <!-- 狀態訊息 -->
    <InfoBar Grid.Row="3"
      IsClosable="False"
      Severity="{x:Bind controls:UiBindHelpers.ErrorSeverity(ViewModel.IsStatusError), Mode=OneWay}"
      IsOpen="{x:Bind controls:UiBindHelpers.HasText(ViewModel.StatusMessage), Mode=OneWay}"
      Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

    <!-- 底部動作按鈕 -->
    <StackPanel Grid.Row="4"
      HorizontalAlignment="Right"
      Orientation="Horizontal"
      Spacing="10">
      <Button Style="{StaticResource PrimaryButtonStyle}"
        MinWidth="100"
        Content="儲存變更"
        Command="{x:Bind ViewModel.SaveCommand}" />
      <Button MinWidth="80"
        Content="取消"
        Command="{x:Bind ViewModel.CancelCommand}" />
    </StackPanel>
  </Grid>
</Window>
