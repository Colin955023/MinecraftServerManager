<Window
  x:Class="MinecraftServerManager.App.Views.ModVersionPickerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels">

  <Grid Style="{StaticResource DialogRootGridStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
      Style="{StaticResource SecondaryCaptionTextStyle}"
      Text="選擇要安裝的模組版本（已依伺服器的 Minecraft 版本與載入器篩選）" />

    <controls:TableFrame Grid.Row="1"
      SortTarget="{x:Bind HeaderSort}"
      IsEmpty="{x:Bind controls:UiBindHelpers.IsEmpty(ViewModel.Versions.Count), Mode=OneWay}"
      EmptyText="沒有相容的版本">
      <controls:TableFrame.Header>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:SortableTableHeader Grid.Column="0"
            Text="版本號碼"
            SortPropertyName="VersionNumber" />
          <controls:SortableTableHeader Grid.Column="1"
            Text="支援 MC"
            SortPropertyName="GameVersions" />
          <controls:SortableTableHeader Grid.Column="2"
            Text="載入器"
            SortPropertyName="Loaders" />
          <controls:SortableTableHeader Grid.Column="3"
            Text="發布時間"
            SortPropertyName="DatePublished" />
          <controls:SortableTableHeader Grid.Column="4"
            Text="檔案"
            SortPropertyName="FileName" />
        </Grid>
      </controls:TableFrame.Header>

      <ListView Style="{StaticResource TableListViewStyle}"
        ItemsSource="{x:Bind ViewModel.Versions}"
        SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}"
        SelectionMode="Single"
        controls:ListViewBehaviors.ClearOnOutsidePress="True"
        controls:ListViewBehaviors.InvokeCommand="{x:Bind ViewModel.InstallCommand}"
        AutomationProperties.Name="模組版本清單">
        <ListView.ItemTemplate>
          <DataTemplate
            x:DataType="vm:ModVersionDisplayItem">
            <Grid>
              <controls:TableCell Grid.Column="0"
                Text="{x:Bind VersionNumber}" />
              <controls:TableCell Grid.Column="1"
                Text="{x:Bind GameVersions}" />
              <controls:TableCell Grid.Column="2"
                Text="{x:Bind Loaders}" />
              <controls:TableCell Grid.Column="3"
                Text="{x:Bind DatePublished}" />
              <controls:TableCell Grid.Column="4"
                Text="{x:Bind FileName}"
                ShowRightBorder="False" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </controls:TableFrame>

    <!-- 狀態訊息 -->
    <TextBlock Grid.Row="2"
      Style="{StaticResource SecondaryCaptionTextStyle}"
      Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
      AutomationProperties.LiveSetting="Polite" />

    <!-- 底部按鈕 -->
    <StackPanel Grid.Row="3"
      HorizontalAlignment="Right"
      Orientation="Horizontal"
      Spacing="10">
      <Button Style="{StaticResource PrimaryButtonStyle}"
        MinWidth="100"
        Content="立即安裝"
        Command="{x:Bind ViewModel.InstallCommand}" />
      <Button MinWidth="110"
        Content="加入安裝清單"
        Command="{x:Bind ViewModel.QueueCommand}" />
      <Button MinWidth="80"
        Content="取消"
        Command="{x:Bind ViewModel.CancelCommand}" />
    </StackPanel>
  </Grid>
</Window>
