<Window x:Class="MinecraftServerManager.App.Views.ModUpdatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MinecraftServerManager.App.Controls"
        xmlns:views="using:MinecraftServerManager.App.Views"
        xmlns:vm="using:MinecraftServerManager.App.ViewModels">

        <Grid Background="{ThemeResource WindowBrush}"
                Padding="20"
                RowSpacing="12">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 標題 -->
                <TextBlock Grid.Row="0"
                        Text="📦 發現可用模組更新"
                        Style="{ThemeResource TitleTextBlockStyle}" />

                <!-- 說明 -->
                <TextBlock Grid.Row="1"
                        Text="下列模組在線上平台上有相容的新版本，請勾選要更新的模組後點選「立即更新所選模組」："
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}" />

                <Border Grid.Row="2"
                        Style="{StaticResource CardBorderStyle}"
                        CornerRadius="8"
                        Padding="12">
                        <controls:TableFrame>
                                <controls:TableFrame.Header>
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModUpdatesListColumns.Current.UpdateWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModUpdatesListColumns.Current.NameWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModUpdatesListColumns.Current.CurrentVersionWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModUpdatesListColumns.Current.NewVersionWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModUpdatesListColumns.Current.PlatformWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModUpdatesListColumns.Current.FileNameWidth, Mode=OneWay}" />
                                                </Grid.ColumnDefinitions>
                                                <controls:SortableTableHeader Grid.Column="0"
                                                        Text="更新"
                                                        SortPropertyName="IsSelected"
                                                        ColumnWidth="{x:Bind views:ModUpdatesListColumns.Current.UpdateWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="1"
                                                        Text="模組名稱"
                                                        SortPropertyName="ModName"
                                                        ColumnWidth="{x:Bind views:ModUpdatesListColumns.Current.NameWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="2"
                                                        Text="目前版本"
                                                        SortPropertyName="CurrentVersion"
                                                        ColumnWidth="{x:Bind views:ModUpdatesListColumns.Current.CurrentVersionWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="3"
                                                        Text="最新版本"
                                                        SortPropertyName="NewVersion"
                                                        ColumnWidth="{x:Bind views:ModUpdatesListColumns.Current.NewVersionWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="4"
                                                        Text="來源平台"
                                                        SortPropertyName="SourcePlatform"
                                                        ColumnWidth="{x:Bind views:ModUpdatesListColumns.Current.PlatformWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="5"
                                                        Text="新檔案名稱"
                                                        SortPropertyName="FileName"
                                                        ColumnWidth="{x:Bind views:ModUpdatesListColumns.Current.FileNameWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                        </Grid>
                                </controls:TableFrame.Header>

                                <ListView ItemsSource="{x:Bind CandidateItems}"
                                        SelectionMode="None"
                                        ItemContainerStyle="{StaticResource TableListViewItemStyle}">
                                        <ListView.ItemTemplate>
                                                <DataTemplate
                                                        x:DataType="vm:ModUpdateCandidateItem">
                                                        <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition
                                                                                Width="{x:Bind views:ModUpdatesListColumns.Current.UpdateWidth, Mode=OneWay}" />
                                                                        <ColumnDefinition
                                                                                Width="{x:Bind views:ModUpdatesListColumns.Current.NameWidth, Mode=OneWay}" />
                                                                        <ColumnDefinition
                                                                                Width="{x:Bind views:ModUpdatesListColumns.Current.CurrentVersionWidth, Mode=OneWay}" />
                                                                        <ColumnDefinition
                                                                                Width="{x:Bind views:ModUpdatesListColumns.Current.NewVersionWidth, Mode=OneWay}" />
                                                                        <ColumnDefinition
                                                                                Width="{x:Bind views:ModUpdatesListColumns.Current.PlatformWidth, Mode=OneWay}" />
                                                                        <ColumnDefinition
                                                                                Width="{x:Bind views:ModUpdatesListColumns.Current.FileNameWidth, Mode=OneWay}" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                                        BorderThickness="0,0,1,0"
                                                                        Padding="4,2">
                                                                        <CheckBox
                                                                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                                                MinWidth="0"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center" />
                                                                </Border>
                                                                <controls:TableCell
                                                                        Grid.Column="1"
                                                                        Text="{x:Bind ModName}" />
                                                                <controls:TableCell
                                                                        Grid.Column="2"
                                                                        Text="{x:Bind CurrentVersion}" />
                                                                <controls:TableCell
                                                                        Grid.Column="3"
                                                                        Text="{x:Bind NewVersion}" />
                                                                <controls:TableCell
                                                                        Grid.Column="4"
                                                                        Text="{x:Bind SourcePlatform}" />
                                                                <controls:TableCell
                                                                        Grid.Column="5"
                                                                        Text="{x:Bind FileName}" />
                                                        </Grid>
                                                </DataTemplate>
                                        </ListView.ItemTemplate>
                                </ListView>
                        </controls:TableFrame>
                </Border>

                <!-- 底部操作列 -->
                <Grid Grid.Row="3">
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                Spacing="8">
                                <Button Content="全選"
                                        Click="OnSelectAllClicked" />
                                <Button Content="取消全選"
                                        Click="OnDeselectAllClicked" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10">
                                <Button Content="取消"
                                        Click="OnCancelClicked"
                                        MinWidth="80" />
                                <Button Content="立即更新所選模組"
                                        Click="OnUpdateClicked"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        MinWidth="140" />
                        </StackPanel>
                </Grid>
        </Grid>
</Window>