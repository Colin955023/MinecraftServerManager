<Window
  x:Class="MinecraftServerManager.App.Views.ModUpdatesWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels">

  <Grid Style="{StaticResource DialogRootGridStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 說明 -->
    <TextBlock Grid.Row="0"
      Style="{StaticResource SecondaryCaptionTextStyle}"
      Text="下列模組在線上平台上有相容的新版本，請勾選要更新的模組後點選「立即更新所選模組」：" />

    <controls:TableFrame Grid.Row="1"
      SortTarget="{x:Bind HeaderSort}"
      IsEmpty="{x:Bind controls:UiBindHelpers.IsEmpty(ViewModel.CandidateItems.Count), Mode=OneWay}"
      EmptyText="沒有可更新的模組">
      <controls:TableFrame.Header>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="95" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <controls:SortableTableHeader Grid.Column="0"
            Text="更新"
            SortPropertyName="IsSelected" />
          <controls:SortableTableHeader Grid.Column="1"
            Text="模組名稱"
            SortPropertyName="ModName" />
          <controls:SortableTableHeader Grid.Column="2"
            Text="目前版本"
            SortPropertyName="CurrentVersion" />
          <controls:SortableTableHeader Grid.Column="3"
            Text="最新版本"
            SortPropertyName="NewVersion" />
          <controls:SortableTableHeader Grid.Column="4"
            Text="來源平台"
            SortPropertyName="SourcePlatform" />
          <controls:SortableTableHeader Grid.Column="5"
            Text="新檔案名稱"
            SortPropertyName="FileName" />
        </Grid>
      </controls:TableFrame.Header>

      <ListView Style="{StaticResource TableListViewStyle}"
        ItemsSource="{x:Bind ViewModel.CandidateItems}"
        SelectionMode="None"
        AutomationProperties.Name="可更新的模組">
        <ListView.ItemTemplate>
          <DataTemplate
            x:DataType="vm:ModUpdateCandidateItem">
            <Grid>
              <Border Grid.Column="0"
                Style="{StaticResource TableCellBorderStyle}"
                Padding="4,2">
                <CheckBox MinWidth="0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                  AutomationProperties.Name="{x:Bind ModName}" />
              </Border>
              <controls:TableCell Grid.Column="1"
                Text="{x:Bind ModName}" />
              <controls:TableCell Grid.Column="2"
                Text="{x:Bind CurrentVersion}" />
              <controls:TableCell Grid.Column="3"
                Text="{x:Bind NewVersion}" />
              <controls:TableCell Grid.Column="4"
                Text="{x:Bind SourcePlatform}" />
              <controls:TableCell Grid.Column="5"
                Text="{x:Bind FileName}"
                ShowRightBorder="False" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </controls:TableFrame>

    <!-- 底部操作列 -->
    <Grid Grid.Row="2"
      ColumnSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"
        Spacing="8">
        <Button Content="全選"
          Command="{x:Bind ViewModel.SelectAllCommand}" />
        <Button Content="取消全選"
          Command="{x:Bind ViewModel.DeselectAllCommand}" />
      </StackPanel>

      <StackPanel Grid.Column="1"
        Orientation="Horizontal"
        Spacing="10">
        <Button Style="{StaticResource PrimaryButtonStyle}"
          MinWidth="140"
          Content="立即更新所選模組"
          Command="{x:Bind ViewModel.ConfirmCommand}" />
        <Button MinWidth="80"
          Content="取消"
          Command="{x:Bind ViewModel.CancelCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
