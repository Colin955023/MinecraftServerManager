<Window x:Class="MinecraftServerManager.App.Views.RestoreBackupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MinecraftServerManager.App.Controls"
    xmlns:views="using:MinecraftServerManager.App.Views"
    xmlns:vm="using:MinecraftServerManager.App.ViewModels">

    <Grid Background="{ThemeResource WindowBrush}"
        Padding="20"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標題與說明 -->
        <StackPanel Grid.Row="0"
            Spacing="4">
            <TextBlock Text="備份還原與管理"
                Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="選擇備份存檔進行還原（具備 Staging 交易安全防護與自動復原機制）"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>

        <!-- 備份表格 ListView -->
        <Border Grid.Row="1"
            Background="{ThemeResource CardBrush}"
            BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource DataGridGridLineBrush}"
                    BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="{x:Bind views:BackupListColumns.Current.FileNameWidth, Mode=OneWay}" />
                            <ColumnDefinition
                                Width="{x:Bind views:BackupListColumns.Current.SizeWidth, Mode=OneWay}" />
                            <ColumnDefinition
                                Width="{x:Bind views:BackupListColumns.Current.CreatedWidth, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <controls:SortableTableHeader Grid.Column="0"
                            Text="備份檔案名稱"
                            SortPropertyName="FileName"
                            ColumnWidth="{x:Bind views:BackupListColumns.Current.FileNameWidth, Mode=TwoWay}"
                            SortRequested="OnHeaderSortRequested"
                            AutoFitRequested="OnHeaderAutoFitRequested" />
                        <controls:SortableTableHeader Grid.Column="1"
                            Text="檔案大小"
                            SortPropertyName="SizeFormatted"
                            ColumnWidth="{x:Bind views:BackupListColumns.Current.SizeWidth, Mode=TwoWay}"
                            SortRequested="OnHeaderSortRequested"
                            AutoFitRequested="OnHeaderAutoFitRequested" />
                        <controls:SortableTableHeader Grid.Column="2"
                            Text="建立時間"
                            SortPropertyName="CreatedAtFormatted"
                            ColumnWidth="{x:Bind views:BackupListColumns.Current.CreatedWidth, Mode=TwoWay}"
                            SortRequested="OnHeaderSortRequested"
                            AutoFitRequested="OnHeaderAutoFitRequested" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                    BorderBrush="{ThemeResource DataGridGridLineBrush}"
                    BorderThickness="1,0,1,1">
                    <ListView ItemsSource="{x:Bind ViewModel.Backups, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedBackup, Mode=TwoWay}"
                        SelectionMode="Single"
                        ItemContainerStyle="{StaticResource TableListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:BackupDisplayItem">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="{x:Bind views:BackupListColumns.Current.FileNameWidth, Mode=OneWay}" />
                                        <ColumnDefinition
                                            Width="{x:Bind views:BackupListColumns.Current.SizeWidth, Mode=OneWay}" />
                                        <ColumnDefinition
                                            Width="{x:Bind views:BackupListColumns.Current.CreatedWidth, Mode=OneWay}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                        BorderThickness="0,0,1,0"
                                        Padding="8,6">
                                        <TextBlock Text="{x:Bind FileName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind FileName}"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="1"
                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                        BorderThickness="0,0,1,0"
                                        Padding="8,6">
                                        <TextBlock Text="{x:Bind SizeFormatted}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind SizeFormatted}"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="2"
                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                        BorderThickness="0,0,1,0"
                                        Padding="8,6">
                                        <TextBlock Text="{x:Bind CreatedAtFormatted}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind CreatedAtFormatted}"
                                            VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
        </Border>

        <!-- 狀態提示 -->
        <TextBlock Grid.Row="2"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}" />

        <!-- 底部按鈕區 -->
        <Grid Grid.Row="3">
            <Button Content="刪除選取備份"
                Command="{x:Bind ViewModel.DeleteCommand}"
                HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10">
                <Button Content="取消"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    MinWidth="80" />
                <Button Content="開始還原"
                    Command="{x:Bind ViewModel.RestoreCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    MinWidth="100" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>