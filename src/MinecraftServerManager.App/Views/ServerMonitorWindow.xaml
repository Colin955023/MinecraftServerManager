<Window
  x:Class="MinecraftServerManager.App.Views.ServerMonitorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels"
  mc:Ignorable="d">

  <Grid x:Name="RootGrid"
    Padding="16,0,16,16">
    <Grid.RowDefinitions>
      <!-- 原生 TitleBar（自動預留右上角系統 Caption 按鈕區域） -->
      <RowDefinition Height="Auto" />
      <!-- 頂部卡片：操作按鈕 + 系統資源統計 -->
      <RowDefinition Height="Auto" />
      <!-- 中間區域：終端機日誌 + 線上玩家 -->
      <RowDefinition Height="*" />
      <!-- 底部指令輸入列 -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 頂部標題列：負邊界抵銷根格線的左右內距使其貼齊視窗邊緣 -->
    <TitleBar x:Name="AppTitleBar"
      Grid.Row="0"
      Margin="-16,0,-16,0"
      Title="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" />

    <!-- 操作按鈕 + 系統資源統計卡片 -->
    <Border Grid.Row="1"
      Style="{StaticResource CardBorderStyle}"
      Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左側：強制終止 -->
        <StackPanel Grid.Column="0"
          Orientation="Horizontal"
          VerticalAlignment="Center">
          <Button Command="{x:Bind ViewModel.ForceKillCommand}"
            IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}"
            Style="{StaticResource DangerButtonStyle}"
            Height="32"
            Padding="{StaticResource CompactButtonPadding}"
            VerticalContentAlignment="Center">
            <controls:IconLabel Icon="{StaticResource IconStop}"
              Text="強制終止"
              IconSize="14" />
          </Button>
        </StackPanel>

        <!-- 系統資源卡片：記憶體、版本、人數、運作時間 -->
        <controls:WrapPanel Grid.Column="1"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Margin="8,0"
          ItemSpacing="8"
          LineSpacing="4">
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Padding="8,4">
            <TextBlock Text="{x:Bind ViewModel.MemoryUsageText, Mode=OneWay}"
              FontSize="{StaticResource CaptionTextBlockFontSize}"
              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
          </Border>
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Padding="8,4">
            <TextBlock Text="{x:Bind ViewModel.MinecraftVersionText}"
              FontSize="{StaticResource CaptionTextBlockFontSize}"
              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
          </Border>
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Padding="8,4">
            <TextBlock Text="{x:Bind ViewModel.OnlinePlayersText, Mode=OneWay}"
              FontSize="{StaticResource CaptionTextBlockFontSize}"
              FontWeight="SemiBold"
              Foreground="{ThemeResource AccentTextBrush}" />
          </Border>
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Padding="8,4">
            <TextBlock Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}"
              FontSize="{StaticResource CaptionTextBlockFontSize}"
              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
          </Border>
        </controls:WrapPanel>

        <!-- 右側控制：自動捲動 + 啟動 / 停止 / 重新整理 -->
        <StackPanel Grid.Column="2"
          Orientation="Horizontal"
          VerticalAlignment="Center"
          Spacing="8">
          <CheckBox Content="自動捲動"
            IsChecked="{x:Bind ViewModel.IsAutoScrollEnabled, Mode=TwoWay}"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            VerticalAlignment="Center" />
          <Button Command="{x:Bind ViewModel.StartServerCommand}"
            Style="{StaticResource SuccessButtonStyle}"
            Height="32"
            Padding="{StaticResource CompactButtonPadding}"
            VerticalContentAlignment="Center">
            <controls:IconLabel Icon="{StaticResource IconStart}"
              Text="啟動"
              VerticalAlignment="Center" />
          </Button>
          <Button Command="{x:Bind ViewModel.StopServerCommand}"
            Style="{StaticResource DangerButtonStyle}"
            Height="32"
            Padding="{StaticResource CompactButtonPadding}"
            VerticalContentAlignment="Center">
            <controls:IconLabel Icon="{StaticResource IconStop}"
              Text="停止"
              VerticalAlignment="Center" />
          </Button>
          <Button Command="{x:Bind ViewModel.ClearLogsCommand}"
            Height="32"
            Padding="{StaticResource CompactButtonPadding}"
            VerticalContentAlignment="Center">
            <controls:IconLabel Icon="{StaticResource IconClear}"
              Text="清除紀錄"
              VerticalAlignment="Center" />
          </Button>
          <Button Command="{x:Bind ViewModel.RefreshStateCommand}"
            Height="32"
            Padding="{StaticResource CompactButtonPadding}"
            VerticalContentAlignment="Center">
            <controls:IconLabel Icon="{StaticResource IconRefresh}"
              Text="重新整理"
              VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 中間區域：左側終端機紀錄 + 右側線上玩家清單 -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="220" />
      </Grid.ColumnDefinitions>

      <!-- 終端機紀錄檢視區 (黑底綠字) -->
      <Border Grid.Column="0"
        Background="{StaticResource ConsoleBackgroundBrush}"
        RequestedTheme="Dark"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource OverlayCornerRadius}"
        Padding="10"
        Margin="0,0,12,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 工具列：複製日誌與狀態摘要 -->
          <Grid Grid.Row="0"
            Margin="0,0,0,8">
            <TextBlock Text="伺服器終端輸出"
              FontSize="{StaticResource BodyTextBlockFontSize}"
              FontWeight="SemiBold"
              Foreground="{StaticResource ConsoleMutedTextBrush}"
              VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right"
              Click="OnCopyAllLogsClicked"
              Padding="10,3"
              FontSize="{StaticResource CaptionTextBlockFontSize}">
              <controls:IconLabel Icon="{StaticResource IconCopy}"
                IconSize="12"
                Text="複製全部紀錄" />
            </Button>
          </Grid>

          <!-- 虛擬化日誌清單 -->
          <ListView x:Name="LogListView"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Logs}"
            SelectionMode="None"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <!-- 取消 ListViewItem 預設 40px 最小列高，行距縮為原本約一半 -->
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="MinHeight"
                  Value="0" />
                <Setter Property="Padding"
                  Value="8,0" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{x:Bind}"
                  FontFamily="{StaticResource ConsoleFontFamily}"
                  FontSize="{StaticResource CaptionTextBlockFontSize}"
                  Foreground="{StaticResource ConsoleForegroundBrush}"
                  TextWrapping="NoWrap"
                  IsTextSelectionEnabled="True"
                  Padding="2,1" />
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <!-- 右側線上玩家清單卡片 -->
      <Border Grid.Column="1"
        Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
            Text="線上玩家"
            FontSize="{StaticResource BodyTextBlockFontSize}"
            FontWeight="SemiBold"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            Margin="0,0,0,8" />
          <TextBlock Grid.Row="1"
            Text="無玩家線上"
            FontSize="{StaticResource BodyTextBlockFontSize}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.HasNoOnlinePlayers, Mode=OneWay}" />
          <ListView Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.OnlinePlayers}"
            Background="Transparent"
            BorderThickness="0"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnPlayerItemClicked">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal"
                  Spacing="6"
                  Padding="4,2">
                  <FontIcon Glyph="{StaticResource IconCheck}"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind}"
                    VerticalAlignment="Center"
                    FontSize="{StaticResource BodyTextBlockFontSize}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </Grid>

    <!-- 底部指令輸入列 -->
    <Grid Grid.Row="3"
      Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox AutomationProperties.Name="伺服器指令" Grid.Column="0"
        Text="{x:Bind ViewModel.CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}"
        KeyDown="CommandInputBox_KeyDown"
        PreviewKeyDown="CommandInputBox_PreviewKeyDown"
        Margin="0,0,10,0"
        PlaceholderText="在此輸入伺服器指令 (如 list, op, stop)..."
        FontFamily="{StaticResource ConsoleFontFamily}"
        FontSize="{StaticResource BodyTextBlockFontSize}" />

      <Button Grid.Column="1"
        Content="傳送指令"
        Command="{x:Bind ViewModel.SendCommandCommand}"
        IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}"
        Style="{StaticResource PrimaryButtonStyle}" />
    </Grid>
  </Grid>
</Window>