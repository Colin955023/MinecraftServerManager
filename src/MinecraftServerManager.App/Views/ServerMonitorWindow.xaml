<Window
  x:Class="MinecraftServerManager.App.Views.ServerMonitorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels"
  mc:Ignorable="d">

  <Grid x:Name="RootGrid"
    Background="{ThemeResource WindowBrush}"
    Padding="16,0,16,16">
    <Grid.RowDefinitions>
      <!-- 專屬標題列安全區域 (高度 38，預留右上角給系統 Caption 按鈕) -->
      <RowDefinition Height="38" />
      <!-- 頂部卡片：操作按鈕 + 系統資源統計 -->
      <RowDefinition Height="Auto" />
      <!-- 中間區域：終端機日誌 + 線上玩家 -->
      <RowDefinition Height="*" />
      <!-- 底部指令輸入列 -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 頂部標題列 (供拖曳與視窗圖示標題，保留右上角 140px 給系統控制鈕) -->
    <Grid Grid.Row="0"
      x:Name="AppTitleBar"
      Margin="4,0,140,0"
      VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal"
        Spacing="8"
        VerticalAlignment="Center">
        <TextBlock Text="🖥️"
          FontSize="14"
          VerticalAlignment="Center" />
        <TextBlock Text="{x:Bind ViewModel.WindowTitle, Mode=OneWay}"
          FontSize="12"
          FontWeight="SemiBold"
          Foreground="{ThemeResource TextBrush}"
          VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- 操作按鈕 + 系統資源統計卡片 -->
    <Border Grid.Row="1"
      Background="{ThemeResource CardBrush}"
      BorderBrush="{ThemeResource BorderBrush}"
      BorderThickness="1"
      CornerRadius="8"
      Padding="14,10"
      Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左側：強制終止 -->
        <StackPanel Grid.Column="0"
          Orientation="Horizontal"
          VerticalAlignment="Center">
          <Button Command="{x:Bind ViewModel.ForceKillCommand}"
            IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}"
            Style="{StaticResource DangerButtonStyle}"
            Height="32"
            Padding="12,4"
            VerticalContentAlignment="Center">
            <TextBlock Text="強制終止"
              VerticalAlignment="Center" />
          </Button>
        </StackPanel>

        <!-- 系統資源卡片：記憶體、版本、人數、運作時間 -->
        <StackPanel Grid.Column="1"
          Orientation="Horizontal"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Spacing="8">
          <Border Background="{ThemeResource WindowBrush}"
            CornerRadius="4"
            Padding="8,4">
            <TextBlock Text="{x:Bind ViewModel.MemoryUsageText, Mode=OneWay}"
              FontSize="12"
              Foreground="{ThemeResource TextBrush}" />
          </Border>
          <Border Background="{ThemeResource WindowBrush}"
            CornerRadius="4"
            Padding="8,4">
            <TextBlock Text="{x:Bind ViewModel.MinecraftVersionText, Mode=OneWay}"
              FontSize="12"
              Foreground="{ThemeResource TextBrush}" />
          </Border>
          <Border Background="{ThemeResource WindowBrush}"
            CornerRadius="4"
            Padding="8,4">
            <TextBlock Text="{x:Bind ViewModel.OnlinePlayersText, Mode=OneWay}"
              FontSize="12"
              FontWeight="SemiBold"
              Foreground="{ThemeResource AccentBrush}" />
          </Border>
          <Border Background="{ThemeResource WindowBrush}"
            CornerRadius="4"
            Padding="8,4">
            <TextBlock Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}"
              FontSize="12"
              Foreground="{ThemeResource TextBrush}" />
          </Border>
        </StackPanel>

        <!-- 右側控制：自動捲動 + 啟動 / 停止 / 重新整理 -->
        <StackPanel Grid.Column="2"
          Orientation="Horizontal"
          VerticalAlignment="Center"
          Spacing="8">
          <CheckBox Content="自動捲動"
            IsChecked="{x:Bind ViewModel.IsAutoScrollEnabled, Mode=TwoWay}"
            Foreground="{ThemeResource TextBrush}"
            VerticalAlignment="Center" />
          <Button Command="{x:Bind ViewModel.StartServerCommand}"
            IsEnabled="{x:Bind ViewModel.CanStartServer, Mode=OneWay}"
            Style="{StaticResource SuccessButtonStyle}"
            Height="32"
            Padding="12,4"
            VerticalContentAlignment="Center">
            <TextBlock Text="🚀 啟動"
              VerticalAlignment="Center" />
          </Button>
          <Button Command="{x:Bind ViewModel.StopServerCommand}"
            IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}"
            Style="{StaticResource DangerButtonStyle}"
            Height="32"
            Padding="12,4"
            VerticalContentAlignment="Center">
            <TextBlock Text="⏹️ 停止"
              VerticalAlignment="Center" />
          </Button>
          <Button Command="{x:Bind ViewModel.ClearLogsCommand}"
            Height="32"
            Padding="12,4"
            VerticalContentAlignment="Center">
            <TextBlock Text="🧹 清除紀錄"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextBrush}" />
          </Button>
          <Button Command="{x:Bind ViewModel.RefreshStateCommand}"
            Height="32"
            Padding="12,4"
            VerticalContentAlignment="Center">
            <TextBlock Text="🔄 重新整理"
              VerticalAlignment="Center"
              Foreground="{ThemeResource TextBrush}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 中間區域：左側終端機紀錄 + 右側線上玩家清單 -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="220" />
      </Grid.ColumnDefinitions>

      <!-- 終端機紀錄檢視區 (黑底綠字) -->
      <Border Grid.Column="0"
        Background="{ThemeResource ConsoleBackgroundBrush}"
        BorderBrush="{ThemeResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="10"
        Margin="0,0,12,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 工具列：複製日誌與狀態摘要 -->
          <Grid Grid.Row="0"
            Margin="0,0,0,8">
            <TextBlock Text="📜 伺服器終端輸出"
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{ThemeResource ConsoleMutedTextBrush}"
              VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right"
              Content="📋 複製全部紀錄"
              Click="OnCopyAllLogsClicked"
              Padding="10,3"
              FontSize="12" />
          </Grid>

          <!-- 虛擬化日誌清單 -->
          <ListView x:Name="LogListView"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}"
            SelectionMode="None"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <!-- 取消 ListViewItem 預設 40px 最小列高，行距縮為原本約一半 -->
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="MinHeight"
                  Value="0" />
                <Setter Property="Padding"
                  Value="8,0" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{x:Bind}"
                  FontFamily="Consolas, Cascadia Code, Courier New"
                  FontSize="12"
                  Foreground="{ThemeResource ConsoleForegroundBrush}"
                  TextWrapping="NoWrap"
                  IsTextSelectionEnabled="True"
                  Padding="2,1" />
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>

      <!-- 右側線上玩家清單卡片 -->
      <Border Grid.Column="1"
        Background="{ThemeResource CardBrush}"
        BorderBrush="{ThemeResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
            Text="👥 線上玩家"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="{ThemeResource TextBrush}"
            Margin="0,0,0,8" />
          <TextBlock Grid.Row="1"
            Text="無玩家線上"
            FontSize="13"
            Foreground="{ThemeResource MutedTextBrush}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.HasNoOnlinePlayers, Mode=OneWay}" />
          <ListView Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.OnlinePlayers, Mode=OneWay}"
            Background="Transparent"
            BorderThickness="0"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnPlayerItemClicked">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal"
                  Spacing="6"
                  Padding="4,2">
                  <controls:ColorIcon Source="{StaticResource IconCheck}"
                    Width="13"
                    Height="13"
                    VerticalAlignment="Center" />
                  <TextBlock Text="{x:Bind}"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{ThemeResource TextBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </Grid>

    <!-- 底部指令輸入列 -->
    <Grid Grid.Row="3"
      Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox Grid.Column="0"
        Text="{x:Bind ViewModel.CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}"
        KeyDown="CommandInputBox_KeyDown"
        Margin="0,0,10,0"
        Padding="8,8"
        PlaceholderText="在此輸入伺服器指令 (如 list, op, stop)..."
        FontFamily="Consolas, Cascadia Code, Courier New"
        FontSize="13" />

      <Button Grid.Column="1"
        Content="傳送指令"
        Command="{x:Bind ViewModel.SendCommandCommand}"
        IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}"
        Style="{StaticResource PrimaryButtonStyle}"
        Padding="18,8" />
    </Grid>
  </Grid>
</Window>