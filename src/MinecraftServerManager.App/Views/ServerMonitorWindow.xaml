<Window x:Class="MinecraftServerManager.App.Views.ServerMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1050"
        Height="680"
        MinWidth="850"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Icon="pack://application:,,,/MinecraftServerManager.App;component/assets/icon.ico">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 頂部卡片：操作三按鈕 + 系統資源統計 -->
    <Border Grid.Row="0"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10"
            Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 頂部操作三按鈕：刷新、停止、清空 -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Command="{Binding RefreshStateCommand}"
                  Height="32"
                  Margin="0,0,8,0"
                  Padding="12,4">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource IconRefresh}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="刷新" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding StopServerCommand}"
                  IsEnabled="{Binding IsServerRunning}"
                  Height="32"
                  Margin="0,0,8,0"
                  Padding="12,4">
            <StackPanel Orientation="Horizontal">
              <Image Source="{StaticResource IconStop}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="停止" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ForceKillCommand}"
                  IsEnabled="{Binding IsServerRunning}"
                  Style="{DynamicResource DangerButtonStyle}"
                  Height="32"
                  Padding="12,4">
            <TextBlock Text="強制終止" VerticalAlignment="Center" Foreground="#FFFFFF" />
          </Button>
        </StackPanel>

        <!-- 系統資源卡片：PID、記憶體、版本、人數、運行時間 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Background="{DynamicResource WindowBrush}" CornerRadius="4" Padding="8,4" Margin="4,0">
            <TextBlock Text="{Binding JvmPidText, StringFormat='JVM: {0}'}" FontSize="12" Foreground="{DynamicResource TextBrush}" />
          </Border>
          <Border Background="{DynamicResource WindowBrush}" CornerRadius="4" Padding="8,4" Margin="4,0">
            <TextBlock Text="{Binding MemoryUsageText, StringFormat='記憶體: {0}'}" FontSize="12" Foreground="{DynamicResource TextBrush}" />
          </Border>
          <Border Background="{DynamicResource WindowBrush}" CornerRadius="4" Padding="8,4" Margin="4,0">
            <TextBlock Text="{Binding MinecraftVersionText, StringFormat='MC: {0}'}" FontSize="12" Foreground="{DynamicResource TextBrush}" />
          </Border>
          <Border Background="{DynamicResource WindowBrush}" CornerRadius="4" Padding="8,4" Margin="4,0">
            <TextBlock Text="{Binding OnlinePlayersText, StringFormat='在線: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          </Border>
          <Border Background="{DynamicResource WindowBrush}" CornerRadius="4" Padding="8,4" Margin="4,0">
            <TextBlock Text="{Binding UptimeText, StringFormat='運行: {0}'}" FontSize="12" Foreground="{DynamicResource TextBrush}" />
          </Border>
        </StackPanel>

        <!-- 右側控制：自動捲動 -->
        <CheckBox Grid.Column="2"
                  Content="自動捲動"
                  IsChecked="{Binding IsAutoScrollEnabled}"
                  Foreground="{DynamicResource TextBrush}"
                  VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- 中間區域：左側日誌主控台 + 右側在線玩家清單卡片 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="200" />
      </Grid.ColumnDefinitions>

      <!-- 終端機日誌檢視區 (掛載 ContextMenu) -->
      <Border Grid.Column="0"
              Background="#0A0B0D"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10"
              Margin="0,0,10,0">
        <ListBox x:Name="LogListBox"
                 ItemsSource="{Binding Logs}"
                 Background="Transparent"
                 BorderThickness="0"
                 FontFamily="Consolas, Cascadia Code, Courier New"
                 FontSize="12"
                 Foreground="#E0E6ED"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="清空日誌" Command="{Binding ClearLogsCommand}" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0,1" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </Border>

      <!-- 右側在線玩家清單卡片 -->
      <Border Grid.Column="1"
              Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0"
                     Text="在線玩家"
                     FontWeight="Bold"
                     FontSize="14"
                     Foreground="{DynamicResource TextBrush}"
                     Margin="0,0,0,8" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding OnlinePlayers}"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="{DynamicResource TextBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,3">
                  <Image Source="{StaticResource IconCheck}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <!-- 底部指令輸入列 -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="CommandInputBox"
               Grid.Column="0"
               Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
               KeyDown="CommandInputBox_KeyDown"
               Margin="0,0,10,0"
               Padding="8,8"
               FontFamily="Consolas, Cascadia Code, Courier New"
               FontSize="13" />

      <Button Grid.Column="1"
              Content="發送指令"
              Command="{Binding SendCommandCommand}"
              Style="{DynamicResource PrimaryButtonStyle}"
              Padding="18,8" />
    </Grid>
  </Grid>
</Window>
