<Window
  x:Class="MinecraftServerManager.App.Views.ServerMonitorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  mc:Ignorable="d">

  <Grid x:Name="RootGrid"
    Padding="16,0,16,16">
    <Grid.RowDefinitions>
      <!-- 原生 TitleBar（自動預留右上角系統 Caption 按鈕區域） -->
      <RowDefinition Height="Auto" />
      <!-- 頂部卡片：操作按鈕 + 系統資源統計 -->
      <RowDefinition Height="Auto" />
      <!-- 中間區域：終端機日誌 + 線上玩家 -->
      <RowDefinition Height="*" />
      <!-- 底部指令輸入列 -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 頂部標題列：負邊界抵銷根格線的左右內距使其貼齊視窗邊緣 -->
    <TitleBar x:Name="AppTitleBar"
      Grid.Row="0"
      Margin="-16,0,-16,0"
      Title="{x:Bind ViewModel.WindowTitle, Mode=OneWay}" />

    <!-- 操作按鈕 + 系統資源統計卡片 -->
    <Border Grid.Row="1"
      Style="{StaticResource CardBorderStyle}"
      Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 左側：強制終止 -->
        <Button Grid.Column="0"
          VerticalAlignment="Center"
          Style="{StaticResource DangerButtonStyle}"
          Padding="{StaticResource CompactButtonPadding}"
          Command="{x:Bind ViewModel.ForceKillCommand}">
          <controls:IconLabel Icon="{StaticResource IconStop}"
            Text="強制終止" />
        </Button>

        <!-- 系統資源卡片：記憶體、版本、人數、運作時間 -->
        <controls:WrapPanel Grid.Column="1"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Margin="8,0"
          ItemSpacing="8"
          LineSpacing="4">
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Padding="8,4">
            <TextBlock Text="{x:Bind ViewModel.MemoryUsageText, Mode=OneWay}"
              FontSize="{StaticResource CaptionTextBlockFontSize}"
              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
          </Border>
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Padding="8,4">
            <TextBlock Text="{x:Bind ViewModel.MinecraftVersionText}"
              FontSize="{StaticResource CaptionTextBlockFontSize}"
              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
          </Border>
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Padding="8,4">
            <TextBlock Text="{x:Bind ViewModel.OnlinePlayersText, Mode=OneWay}"
              FontSize="{StaticResource CaptionTextBlockFontSize}"
              FontWeight="SemiBold"
              Foreground="{ThemeResource AccentTextBrush}" />
          </Border>
          <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Padding="8,4">
            <TextBlock Text="{x:Bind ViewModel.UptimeText, Mode=OneWay}"
              FontSize="{StaticResource CaptionTextBlockFontSize}"
              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
          </Border>
        </controls:WrapPanel>

        <!-- 右側控制：自動捲動 + 啟動 / 停止 / 重新整理 -->
        <StackPanel Grid.Column="2"
          Orientation="Horizontal"
          VerticalAlignment="Center"
          Spacing="8">
          <CheckBox Content="自動捲動"
            IsChecked="{x:Bind ViewModel.IsAutoScrollEnabled, Mode=TwoWay}"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            VerticalAlignment="Center" />
          <Button Style="{StaticResource PrimaryButtonStyle}"
            Padding="{StaticResource CompactButtonPadding}"
            Command="{x:Bind ViewModel.StartServerCommand}">
            <controls:IconLabel Icon="{StaticResource IconStart}"
              Text="啟動" />
          </Button>
          <Button Style="{StaticResource DangerButtonStyle}"
            Padding="{StaticResource CompactButtonPadding}"
            Command="{x:Bind ViewModel.StopServerCommand}">
            <controls:IconLabel Icon="{StaticResource IconStop}"
              Text="停止" />
          </Button>
          <Button Padding="{StaticResource CompactButtonPadding}"
            VerticalContentAlignment="Center"
            Command="{x:Bind ViewModel.ClearLogsCommand}">
            <controls:IconLabel Icon="{StaticResource IconClear}"
              Text="清除紀錄" />
          </Button>
          <Button Padding="{StaticResource CompactButtonPadding}"
            VerticalContentAlignment="Center"
            Command="{x:Bind ViewModel.RefreshStateCommand}">
            <Button.KeyboardAccelerators>
              <KeyboardAccelerator Key="F5" />
            </Button.KeyboardAccelerators>
            <controls:IconLabel Icon="{StaticResource IconRefresh}"
              Text="重新整理" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 中間區域：左側終端機紀錄 + 右側線上玩家清單 -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="220" />
      </Grid.ColumnDefinitions>

      <!-- 終端機紀錄檢視區（黑底綠字） -->
      <Border Grid.Column="0"
        Margin="0,0,12,0"
        Padding="10"
        Background="{StaticResource ConsoleBackgroundBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource OverlayCornerRadius}"
        RequestedTheme="Dark">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 工具列：複製日誌與狀態摘要 -->
          <Grid Grid.Row="0"
            Margin="0,0,0,8">
            <TextBlock VerticalAlignment="Center"
              Text="伺服器終端輸出"
              FontSize="{StaticResource BodyTextBlockFontSize}"
              FontWeight="SemiBold"
              Foreground="{StaticResource ConsoleMutedTextBrush}" />
            <Button Padding="10,3"
              HorizontalAlignment="Right"
              Command="{x:Bind ViewModel.CopyAllLogsCommand}"
              FontSize="{StaticResource CaptionTextBlockFontSize}">
              <controls:IconLabel Icon="{StaticResource IconCopy}"
                Text="複製全部紀錄"
                IconSize="12" />
            </Button>
          </Grid>

          <!-- 虛擬化日誌清單 -->
          <ListView x:Name="LogListView"
            Grid.Row="1"
            Style="{StaticResource ConsoleLogListViewStyle}"
            ItemsSource="{x:Bind ViewModel.Logs}"
            AutomationProperties.Name="伺服器日誌" />
        </Grid>
      </Border>

      <!-- 右側線上玩家清單卡片 -->
      <Border Grid.Column="1"
        Style="{StaticResource CardBorderStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
            Margin="0,0,0,8"
            Text="線上玩家"
            FontSize="{StaticResource BodyTextBlockFontSize}"
            FontWeight="SemiBold"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
          <TextBlock Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="無玩家線上"
            FontSize="{StaticResource BodyTextBlockFontSize}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="{x:Bind ViewModel.HasNoOnlinePlayers, Mode=OneWay}" />
          <ListView Grid.Row="1"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{x:Bind ViewModel.OnlinePlayers}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnPlayerItemClicked"
            AutomationProperties.Name="線上玩家">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <StackPanel Padding="4,2"
                  Orientation="Horizontal"
                  Spacing="6">
                  <FontIcon Glyph="{StaticResource IconCheck}"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    AutomationProperties.AccessibilityView="Raw" />
                  <TextBlock VerticalAlignment="Center"
                    Text="{x:Bind}"
                    FontSize="{StaticResource BodyTextBlockFontSize}"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </Grid>

    <!-- 底部指令輸入列 -->
    <Grid Grid.Row="3"
      Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox Grid.Column="0"
        Margin="0,0,10,0"
        Text="{x:Bind ViewModel.CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        PlaceholderText="在此輸入伺服器指令（如 list, op, stop）..."
        controls:TextBoxShortcuts.EnterCommand="{x:Bind ViewModel.SendCommandCommand}"
        IsEnabled="{x:Bind ViewModel.IsServerRunning, Mode=OneWay}"
        PreviewKeyDown="OnCommandInputBoxPreviewKeyDown"
        FontFamily="{StaticResource ConsoleFontFamily}"
        FontSize="{StaticResource BodyTextBlockFontSize}"
        AutomationProperties.Name="伺服器指令" />

      <Button Grid.Column="1"
        Content="傳送指令"
        Command="{x:Bind ViewModel.SendCommandCommand}"
        Style="{StaticResource PrimaryButtonStyle}" />
    </Grid>
  </Grid>
</Window>
