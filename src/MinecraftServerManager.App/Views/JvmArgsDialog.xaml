<Window x:Class="MinecraftServerManager.App.Views.JvmArgsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JVM 啟動參數設定"
        Width="700"
        Height="540"
        MinWidth="600"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 標題 -->
    <TextBlock Grid.Row="0"
               Text="JVM 參數設定"
               FontSize="22"
               FontWeight="Bold"
               Foreground="{DynamicResource TextBrush}"
               Margin="0,0,0,8" />

    <!-- 說明文字 -->
    <TextBlock Grid.Row="1"
               Text="{Binding DescriptionText}"
               TextWrapping="Wrap"
               FontSize="13"
               Foreground="{DynamicResource MutedTextBrush}"
               LineHeight="18"
               Margin="0,0,0,16" />

    <!-- 建議參數列表卡片 -->
    <Border Grid.Row="2"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
            Margin="0,0,0,16">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding RecommendedArgs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding IsChecked}"
                        Margin="0,4,0,6"
                        ToolTip="{Binding Description}"
                        Foreground="{DynamicResource TextBrush}">
                <TextBlock Text="{Binding Option}" FontFamily="Consolas, Segoe UI" FontSize="12.5" />
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- 其他自訂參數區塊 -->
    <StackPanel Grid.Row="3" Margin="0,0,0,20">
      <CheckBox Content="其他自訂參數"
                IsChecked="{Binding HasCustomArgs}"
                Foreground="{DynamicResource TextBrush}"
                Margin="0,0,0,8" />
      <TextBox Text="{Binding CustomArgsText, UpdateSourceTrigger=PropertyChanged}"
               IsEnabled="{Binding HasCustomArgs}"
               Height="34"
               VerticalContentAlignment="Center" />
    </StackPanel>

    <!-- 底部按鈕區 -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0"
              Content="重設為建議預設"
              Command="{Binding ResetToDefaultCommand}"
              Height="34"
              Padding="14,0" />

      <Button Grid.Column="2"
              Content="取消"
              Click="CancelButton_Click"
              Height="34"
              MinWidth="85"
              Margin="0,0,10,0" />

      <Button Grid.Column="3"
              Content="確定"
              Click="OkButton_Click"
              Style="{DynamicResource PrimaryButtonStyle}"
              Height="34"
              MinWidth="95" />
    </Grid>
  </Grid>
</Window>
