<ContentDialog x:Class="MinecraftServerManager.App.Views.JvmArgsDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels"
  Title="JVM 參數設定"
  PrimaryButtonText="套用"
  CloseButtonText="取消"
  DefaultButton="Primary">

  <ContentDialog.Resources>
    <!-- 預設上限 548 會裁切 560 寬內容 -->
    <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
  </ContentDialog.Resources>

  <Grid Width="560"
    MaxHeight="520"
    RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 說明文字 -->
    <TextBlock Grid.Row="0"
      Text="{x:Bind ViewModel.DescriptionText}"
      TextWrapping="Wrap"
      Style="{StaticResource SecondaryCaptionTextStyle}" />

    <!-- 建議參數清單卡片 -->
    <Border Grid.Row="1"
      Style="{StaticResource CardBorderStyle}">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{x:Bind ViewModel.RecommendedArgs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:JvmArgOptionItem">
              <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                ToolTipService.ToolTip="{x:Bind Description}"
                Margin="0,3,0,3">
                <TextBlock Text="{x:Bind Option}"
                  FontFamily="{StaticResource ConsoleFontFamily}"
                  FontSize="{StaticResource BodyTextBlockFontSize}" />
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- 重設按鈕 -->
    <Button Grid.Row="2"
      Content="重設為建議預設"
      Command="{x:Bind ViewModel.ResetToDefaultCommand}"
      Style="{StaticResource DangerButtonStyle}"
      HorizontalAlignment="Left" />

    <!-- 其他自訂參數區塊 -->
    <StackPanel Grid.Row="3"
      Spacing="6">
      <CheckBox Content="其他自訂參數"
        IsChecked="{x:Bind ViewModel.HasCustomArgs, Mode=TwoWay}" />
      <TextBox AutomationProperties.Name="自訂 JVM 參數"
        Text="{x:Bind ViewModel.CustomArgsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        IsEnabled="{x:Bind ViewModel.HasCustomArgs, Mode=OneWay}"
        PlaceholderText="例如：-Dfile.encoding=UTF-8" />
    </StackPanel>
  </Grid>
</ContentDialog>
