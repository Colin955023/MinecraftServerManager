<ContentDialog x:Class="MinecraftServerManager.App.Views.OperationProgressDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="{x:Bind DialogHeading, Mode=OneTime}"
  Closing="ContentDialog_Closing">

  <!-- 放寬 ContentDialog 預設最大寬度（548），讓固定尺寸內容可完整顯示 -->
  <ContentDialog.Resources>
    <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
  </ContentDialog.Resources>

  <!-- 固定寬高：進度文字長短不同時視窗不再跳動 -->
  <Grid Margin="0,12,0,0"
    Width="640">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 階段狀態說明（固定三行高度，過長以刪節號截斷並以提示顯示全文） -->
    <TextBlock Grid.Row="0"
      Text="{x:Bind PhaseMessage, Mode=OneWay}"
      ToolTipService.ToolTip="{x:Bind PhaseMessage, Mode=OneWay}"
      FontSize="14"
      Height="64"
      MaxLines="3"
      TextWrapping="Wrap"
      TextTrimming="CharacterEllipsis"
      Foreground="{ThemeResource MutedTextBrush}"
      Margin="0,0,0,16" />

    <!-- 進度列 -->
    <ProgressBar Grid.Row="1"
      Height="8"
      Minimum="0"
      Maximum="100"
      Value="{x:Bind ProgressValue, Mode=OneWay}"
      Foreground="{ThemeResource AccentBrush}"
      CornerRadius="4" />

    <!-- 百分比文字 -->
    <TextBlock Grid.Row="2"
      Text="{x:Bind PercentDisplay, Mode=OneWay}"
      FontSize="13"
      FontWeight="SemiBold"
      HorizontalAlignment="Right"
      Foreground="{ThemeResource TextBrush}"
      Margin="0,8,0,0" />
  </Grid>
</ContentDialog>