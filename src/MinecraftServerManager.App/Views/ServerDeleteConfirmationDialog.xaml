<ContentDialog x:Class="MinecraftServerManager.App.Views.ServerDeleteConfirmationDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  mc:Ignorable="d"
  Title="確認刪除伺服器"
  PrimaryButtonText="{x:Bind PrimaryText, Mode=OneTime}"
  SecondaryButtonText="{x:Bind SecondaryText, Mode=OneTime}"
  PrimaryButtonStyle="{StaticResource DangerButtonStyle}"
  CloseButtonText="取消"
  DefaultButton="Close"
  PrimaryButtonClick="Dialog_PrimaryButtonClick"
  SecondaryButtonClick="Dialog_SecondaryButtonClick">

  <Grid Margin="0,12,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <FontIcon Glyph="{StaticResource IconWarning}"
      FontFamily="{StaticResource SymbolThemeFontFamily}"
      controls:ThemeBrush.ForegroundKey="WarningTextBrush"
      FontSize="{StaticResource TitleTextBlockFontSize}"
      VerticalAlignment="Top"
      Margin="0,0,14,0" />
    <TextBlock Grid.Column="1"
      Text="{x:Bind Message, Mode=OneTime}"
      TextWrapping="Wrap"
      FontSize="{StaticResource BodyTextBlockFontSize}"
      LineHeight="22"
      Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
  </Grid>
</ContentDialog>