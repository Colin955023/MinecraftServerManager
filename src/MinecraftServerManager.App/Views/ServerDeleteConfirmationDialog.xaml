<ContentDialog x:Class="MinecraftServerManager.App.Views.ServerDeleteConfirmationDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
  Title="確認刪除伺服器"
  PrimaryButtonText="{x:Bind PrimaryText, Mode=OneTime}"
  SecondaryButtonText="{x:Bind SecondaryText, Mode=OneTime}"
  PrimaryButtonStyle="{StaticResource DangerButtonStyle}"
  CloseButtonText="取消"
  DefaultButton="Close"
  PrimaryButtonClick="Dialog_PrimaryButtonClick"
  SecondaryButtonClick="Dialog_SecondaryButtonClick">

  <StackPanel Margin="0,12,0,0">
    <TextBlock Text="{x:Bind Message, Mode=OneTime}"
      TextWrapping="Wrap"
      FontSize="14"
      LineHeight="22"
      Foreground="{ThemeResource TextBrush}" />
  </StackPanel>
</ContentDialog>