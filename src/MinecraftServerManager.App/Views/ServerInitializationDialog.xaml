<Window x:Class="MinecraftServerManager.App.Views.ServerInitializationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MinecraftServerManager.App.Controls"
    xmlns:views="using:MinecraftServerManager.App.Views">

    <Grid Margin="20"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 頂部狀態 -->
        <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            Spacing="8">
            <ProgressBar Style="{StaticResource BusyProgressBarStyle}"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay}" />
            <TextBlock AutomationProperties.LiveSetting="Polite"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Style="{StaticResource SecondaryCaptionTextStyle}"
                VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1"
            Background="{StaticResource ConsoleBackgroundBrush}"
            RequestedTheme="Dark"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Padding="8">
            <TextBox x:Name="ConsoleBox"
                Text="{x:Bind ViewModel.ConsoleText, Mode=OneWay}"
                TextChanged="ConsoleBox_TextChanged"
                Background="{StaticResource ConsoleBackgroundBrush}"
                Foreground="{StaticResource ConsoleForegroundBrush}"
                FontFamily="{StaticResource ConsoleFontFamily}"
                FontSize="{StaticResource CaptionTextBlockFontSize}"
                BorderThickness="0"
                IsReadOnly="True"
                AcceptsReturn="True"
                TextWrapping="Wrap" />
        </Border>

        <!-- 底部按鈕列 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左側：取消按鈕 -->
            <Button Grid.Column="0"
                Content="取消初始化"
                Style="{ThemeResource DefaultButtonStyle}"
                Click="CancelButton_Click" />

            <!-- 中間：倒數計時提示 -->
            <TextBlock Grid.Column="1"
                Text="{x:Bind ViewModel.CountdownText, Mode=OneWay}"
                controls:ThemeBrush.ForegroundKey="{x:Bind views:ServerInitializationDialog.CountdownBrushKey(ViewModel.CountdownState), Mode=OneWay}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="12,0" />

            <!-- 右側：完成按鈕 -->
            <Button Grid.Column="2"
                Content="{x:Bind ViewModel.CompleteButtonText, Mode=OneWay}"
                Style="{StaticResource PrimaryButtonStyle}"
                IsEnabled="{x:Bind ViewModel.IsCompleteEnabled, Mode=OneWay}"
                Click="CompleteButton_Click" />
        </Grid>
    </Grid>
</Window>