<Window x:Class="MinecraftServerManager.App.Views.ServerInitializationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="伺服器初始化"
        Width="740"
        Height="500"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Icon="pack://application:,,,/MinecraftServerManager.App;component/assets/icon.ico">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 頂部標題與狀態 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock x:Name="TitleText"
                 Text="伺服器初次啟動初始化"
                 FontSize="18"
                 FontWeight="Bold"
                 Foreground="{DynamicResource TextBrush}"
                 Margin="0,0,0,4" />
      <TextBlock x:Name="StatusText"
                 Text="狀態: 正在準備啟動伺服器進行初次世界生成與設定配置..."
                 FontSize="13"
                 Foreground="{DynamicResource MutedTextBrush}" />
    </StackPanel>

    <!-- 中間：控制台日誌輸出 (黑底綠字) -->
    <Border Grid.Row="1"
            Background="#0C0C0C"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8"
            Margin="0,0,0,16">
      <TextBox x:Name="ConsoleBox"
               Background="#0C0C0C"
               Foreground="#00FF66"
               FontFamily="Consolas, Cascadia Code, Courier New"
               FontSize="12"
               BorderThickness="0"
               IsReadOnly="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" />
    </Border>

    <!-- 底部按鈕列 -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- 左側：強制關閉 -->
      <Button Grid.Column="0"
              x:Name="CancelButton"
              Content="強制中斷"
              Style="{DynamicResource DangerButtonStyle}"
              Height="34"
              Padding="16,0"
              Click="CancelButton_Click" />

      <!-- 中間：倒數計時提示 -->
      <TextBlock Grid.Column="1"
                 x:Name="CountdownText"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="#00FF66"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 Margin="12,0" />

      <!-- 右側：完成按鈕 -->
      <Button Grid.Column="2"
              x:Name="CompleteButton"
              Content="完成初始化"
              Style="{DynamicResource PrimaryButtonStyle}"
              Height="34"
              Padding="20,0"
              IsEnabled="False"
              Click="CompleteButton_Click" />
    </Grid>
  </Grid>
</Window>
