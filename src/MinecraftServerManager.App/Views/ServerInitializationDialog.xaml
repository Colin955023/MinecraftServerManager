<Window x:Class="MinecraftServerManager.App.Views.ServerInitializationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MinecraftServerManager.App.Controls">

    <Grid Background="{ThemeResource WindowBrush}">
        <Grid Margin="20"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 頂部標題與狀態 -->
            <StackPanel Grid.Row="0"
                Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                    Style="{ThemeResource TitleTextBlockStyle}" />
                <StackPanel Orientation="Horizontal"
                    Spacing="8">
                    <ProgressBar IsIndeterminate="True"
                        Width="80"
                        Height="4"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsProgressVisible, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- 中間：主控台記錄輸出 -->
            <Border Grid.Row="1"
                Background="{ThemeResource ConsoleBackgroundBrush}"
                BorderBrush="{ThemeResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
                <ScrollViewer x:Name="ConsoleScrollViewer"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="ConsoleBox"
                        Text="{x:Bind ViewModel.ConsoleText, Mode=OneWay}"
                        TextChanged="ConsoleBox_TextChanged"
                        Background="{ThemeResource ConsoleBackgroundBrush}"
                        Foreground="{ThemeResource ConsoleForegroundBrush}"
                        FontFamily="Consolas, Cascadia Code, Courier New"
                        FontSize="12"
                        BorderThickness="0"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- 底部按鈕列 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左側：取消按鈕 -->
                <Button Grid.Column="0"
                    Content="取消初始化"
                    Style="{ThemeResource DefaultButtonStyle}"
                    Click="CancelButton_Click" />

                <!-- 中間：倒數計時提示 -->
                <TextBlock Grid.Column="1"
                    Text="{x:Bind ViewModel.CountdownText, Mode=OneWay}"
                    controls:ThemeBrush.ForegroundKey="{x:Bind CountdownBrushKey(ViewModel.CountdownState), Mode=OneWay}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="12,0" />

                <!-- 右側：完成按鈕 -->
                <Button Grid.Column="2"
                    Content="{x:Bind ViewModel.CompleteButtonText, Mode=OneWay}"
                    Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="{x:Bind ViewModel.IsCompleteEnabled, Mode=OneWay}"
                    Click="CompleteButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>