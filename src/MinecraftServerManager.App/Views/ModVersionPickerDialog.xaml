<Window x:Class="MinecraftServerManager.App.Views.ModVersionPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MinecraftServerManager.App.Controls"
        xmlns:views="using:MinecraftServerManager.App.Views"
        xmlns:vm="using:MinecraftServerManager.App.ViewModels">

        <Grid Background="{ThemeResource WindowBrush}"
                Padding="20"
                RowSpacing="12">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 標題 -->
                <StackPanel Grid.Row="0"
                        Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ProjectTitle, Mode=OneWay}"
                                Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock Text="選擇要安裝的模組版本（已依伺服器的 Minecraft 版本與載入器篩選）"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>

                <!-- 版本清單 ListView -->
                <Border Grid.Row="1"
                        Background="{ThemeResource CardBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                        <Grid>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{ThemeResource CardBrush}"
                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                        BorderThickness="1">
                                        <Grid>
                                                <Grid.ColumnDefinitions>
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModVersionListColumns.Current.VersionWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModVersionListColumns.Current.GameVersionWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModVersionListColumns.Current.LoaderWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModVersionListColumns.Current.DateWidth, Mode=OneWay}" />
                                                        <ColumnDefinition
                                                                Width="{x:Bind views:ModVersionListColumns.Current.FileNameWidth, Mode=OneWay}" />
                                                </Grid.ColumnDefinitions>
                                                <controls:SortableTableHeader Grid.Column="0"
                                                        Text="版本號碼"
                                                        SortPropertyName="VersionNumber"
                                                        ColumnWidth="{x:Bind views:ModVersionListColumns.Current.VersionWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="1"
                                                        Text="支援 MC"
                                                        SortPropertyName="GameVersions"
                                                        ColumnWidth="{x:Bind views:ModVersionListColumns.Current.GameVersionWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="2"
                                                        Text="載入器"
                                                        SortPropertyName="Loaders"
                                                        ColumnWidth="{x:Bind views:ModVersionListColumns.Current.LoaderWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="3"
                                                        Text="發布時間"
                                                        SortPropertyName="DatePublished"
                                                        ColumnWidth="{x:Bind views:ModVersionListColumns.Current.DateWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                                <controls:SortableTableHeader Grid.Column="4"
                                                        Text="檔案"
                                                        SortPropertyName="FileName"
                                                        ColumnWidth="{x:Bind views:ModVersionListColumns.Current.FileNameWidth, Mode=TwoWay}"
                                                        SortRequested="OnHeaderSortRequested"
                                                        AutoFitRequested="OnHeaderAutoFitRequested" />
                                        </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                        BorderThickness="1,0,1,1">
                                        <ListView
                                                ItemsSource="{x:Bind ViewModel.Versions, Mode=OneWay}"
                                                SelectedItem="{x:Bind ViewModel.SelectedVersion, Mode=TwoWay}"
                                                SelectionMode="Single"
                                                ItemContainerStyle="{StaticResource TableListViewItemStyle}">
                                                <ListView.ItemTemplate>
                                                        <DataTemplate
                                                                x:DataType="vm:ModVersionDisplayItem">
                                                                <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition
                                                                                        Width="{x:Bind views:ModVersionListColumns.Current.VersionWidth, Mode=OneWay}" />
                                                                                <ColumnDefinition
                                                                                        Width="{x:Bind views:ModVersionListColumns.Current.GameVersionWidth, Mode=OneWay}" />
                                                                                <ColumnDefinition
                                                                                        Width="{x:Bind views:ModVersionListColumns.Current.LoaderWidth, Mode=OneWay}" />
                                                                                <ColumnDefinition
                                                                                        Width="{x:Bind views:ModVersionListColumns.Current.DateWidth, Mode=OneWay}" />
                                                                                <ColumnDefinition
                                                                                        Width="{x:Bind views:ModVersionListColumns.Current.FileNameWidth, Mode=OneWay}" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0"
                                                                                BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                                                BorderThickness="0,0,1,0"
                                                                                Padding="8,6">
                                                                                <TextBlock
                                                                                        Text="{x:Bind VersionNumber}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTipService.ToolTip="{x:Bind VersionNumber}"
                                                                                        VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <Border Grid.Column="1"
                                                                                BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                                                BorderThickness="0,0,1,0"
                                                                                Padding="8,6">
                                                                                <TextBlock
                                                                                        Text="{x:Bind GameVersions}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTipService.ToolTip="{x:Bind GameVersions}"
                                                                                        VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <Border Grid.Column="2"
                                                                                BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                                                BorderThickness="0,0,1,0"
                                                                                Padding="8,6">
                                                                                <TextBlock
                                                                                        Text="{x:Bind Loaders}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTipService.ToolTip="{x:Bind Loaders}"
                                                                                        VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <Border Grid.Column="3"
                                                                                BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                                                BorderThickness="0,0,1,0"
                                                                                Padding="8,6">
                                                                                <TextBlock
                                                                                        Text="{x:Bind DatePublished}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTipService.ToolTip="{x:Bind DatePublished}"
                                                                                        VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <Border Grid.Column="4"
                                                                                BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                                                                BorderThickness="0,0,1,0"
                                                                                Padding="8,6">
                                                                                <TextBlock
                                                                                        Text="{x:Bind FileName}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTipService.ToolTip="{x:Bind FileName}"
                                                                                        VerticalAlignment="Center" />
                                                                        </Border>
                                                                </Grid>
                                                        </DataTemplate>
                                                </ListView.ItemTemplate>
                                        </ListView>
                                </Border>
                        </Grid>
                </Border>

                <!-- 狀態訊息 -->
                <TextBlock Grid.Row="2"
                        Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource CaptionTextBlockStyle}" />

                <!-- 底部按鈕 -->
                <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10">
                        <Button Content="取消"
                                Command="{x:Bind ViewModel.CancelCommand}"
                                MinWidth="80" />
                        <Button Content="加入安裝清單"
                                Command="{x:Bind ViewModel.QueueCommand}"
                                MinWidth="110" />
                        <Button Content="立即安裝"
                                Command="{x:Bind ViewModel.InstallCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                MinWidth="100" />
                </StackPanel>
        </Grid>
</Window>