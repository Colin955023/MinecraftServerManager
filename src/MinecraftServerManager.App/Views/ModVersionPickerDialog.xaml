<Window x:Class="MinecraftServerManager.App.Views.ModVersionPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="760"
        Height="500"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Icon="pack://application:,,,/MinecraftServerManager.App;component/assets/icon.ico">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="{Binding ProjectTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
      <TextBlock Text="選擇要安裝的模組版本（已依伺服器的 Minecraft 版本與載入器篩選）"
                 Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
    </StackPanel>

    <Border Grid.Row="1"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Margin="0,0,0,14">
      <DataGrid ItemsSource="{Binding Versions}"
                SelectedItem="{Binding SelectedVersion}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionMode="Single"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                RowHeaderWidth="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="版本號" Binding="{Binding VersionNumber}" Width="180" />
          <DataGridTextColumn Header="支援 MC" Binding="{Binding GameVersions}" Width="160" />
          <DataGridTextColumn Header="載入器" Binding="{Binding Loaders}" Width="120" />
          <DataGridTextColumn Header="發布時間" Binding="{Binding DatePublished}" Width="140" />
          <DataGridTextColumn Header="檔案" Binding="{Binding FileName}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <TextBlock Grid.Row="2"
               Text="{Binding StatusMessage}"
               Foreground="{DynamicResource MutedTextBrush}"
               FontSize="12"
               Margin="0,0,0,12"
               TextWrapping="Wrap" />

    <Grid Grid.Row="3">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消"
                Command="{Binding CancelCommand}"
                Margin="0,0,10,0"
                Padding="16,6" />
        <Button Content="加入安裝清單"
                Command="{Binding QueueCommand}"
                Margin="0,0,10,0"
                Padding="16,6" />
        <Button Content="立即安裝"
                Command="{Binding InstallCommand}"
                Style="{DynamicResource PrimaryButtonStyle}"
                Padding="20,6" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
