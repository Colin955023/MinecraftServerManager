<Window x:Class="MinecraftServerManager.App.Views.ServerPropertiesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:MinecraftServerManager.App.ViewModels"
    xmlns:helpers="using:MinecraftServerManager.App.Controls">

    <Grid Background="{ThemeResource WindowBrush}"
        Padding="20"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標題與說明 -->
        <StackPanel Grid.Row="0"
            Spacing="4">
            <TextBlock Text="編輯伺服器屬性"
                Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="修改 server.properties 設定檔，支援 60+ 項官方設定、中文說明與預設值還原"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}" />
        </StackPanel>

        <!-- 搜尋與分類過濾列 -->
        <Grid Grid.Row="1"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 快速搜尋輸入框 -->
            <TextBox Grid.Column="0"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="搜尋屬性名稱或中文說明..." />

            <!-- 分類下拉選單 -->
            <ComboBox Grid.Column="1"
                ItemsSource="{x:Bind ViewModel.Categories}"
                SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}"
                HorizontalAlignment="Stretch" />

            <!-- 全部還原預設值按鈕 -->
            <Button Grid.Column="2"
                Content="全部還原預設值"
                Command="{x:Bind ViewModel.ResetAllToDefaultCommand}" />
        </Grid>

        <!-- 屬性清單區域 -->
        <Border Grid.Row="2"
            Style="{StaticResource CardBorderStyle}"
            CornerRadius="8"
            Padding="8">
            <ListView x:Name="PropertiesListView"
                ItemsSource="{x:Bind ViewModel.DisplayItems}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PropertyEditItem">
                        <Grid Margin="0,4,0,4"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 屬性鍵名與提示說明 -->
                            <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Text="{x:Bind Key}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Description}" />
                                <TextBlock Text="{x:Bind Description}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Description}" />
                            </StackPanel>

                            <!-- 編輯器控制項（依屬性型別動態切換） -->
                            <Grid Grid.Column="1"
                                VerticalAlignment="Center">
                                <!-- 以 x:Load 只建立該屬性型別需要的編輯器，避免隱藏的 ComboBox 雙向繫結誤寫屬性值 -->
                                <TextBox x:Name="TextEditor"
                                    x:Load="{x:Bind IsText}"
                                    Text="{x:Bind Value, Mode=TwoWay}"
                                    PlaceholderText="{x:Bind DefaultValue}"
                                    VerticalAlignment="Center" />
                                <CheckBox x:Name="BoolEditor"
                                    x:Load="{x:Bind IsBoolean}"
                                    Content="啟用"
                                    IsChecked="{x:Bind BoolValue, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                                <ComboBox x:Name="OptionsEditor"
                                    x:Load="{x:Bind IsOptions}"
                                    ItemsSource="{x:Bind Options}"
                                    SelectedItem="{x:Bind Value, Mode=TwoWay}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" />
                            </Grid>

                            <!-- 重設單項預設值按鈕 -->
                            <Button Grid.Column="2"
                                Content="預設"
                                Click="ResetItem_Click"
                                ToolTipService.ToolTip="{x:Bind DefaultValue}"
                                VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- 狀態訊息 -->
        <TextBlock Grid.Row="3"
            Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}" />

        <!-- 底部動作按鈕 -->
        <StackPanel Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="10">
            <Button Content="取消"
                Command="{x:Bind ViewModel.CancelCommand}"
                MinWidth="80" />
            <Button Content="儲存變更"
                Command="{x:Bind ViewModel.SaveCommand}"
                Style="{ThemeResource AccentButtonStyle}"
                MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>