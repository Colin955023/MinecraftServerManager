<Window x:Class="MinecraftServerManager.App.Views.ManageJavaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MinecraftServerManager.App.ViewModels"
        Title="管理 Java 環境"
        Width="780"
        Height="560"
        MinWidth="680"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 頂部資訊卡片 -->
    <Border Grid.Row="0"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,12"
            Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="本機 Java 執行環境管理" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="目前 Minecraft 版本：" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Text="{Binding MinecraftVersionText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" />
            <TextBlock Text="指定 Java 需求：" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Text="{Binding RequiredMajorText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
          </StackPanel>
        </StackPanel>

        <!-- 工具列按鈕 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="自動偵測配對"
                  Command="{Binding AutoDetectCommand}"
                  Height="30"
                  Padding="10,4"
                  Margin="0,0,8,0" />
          <Button Content="手動瀏覽..."
                  Command="{Binding BrowseFileCommand}"
                  Height="30"
                  Padding="10,4"
                  Margin="0,0,8,0" />
          <Button Content="🔄 重新整理"
                  Command="{Binding RefreshCommand}"
                  Height="30"
                  Padding="10,4" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- winget 線上安裝區塊 -->
    <Border Grid.Row="1"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10"
            Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="線上安裝 Java (winget)：" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,8,0" />
        <ComboBox Grid.Column="1"
                  ItemsSource="{Binding AvailableInstallMajors}"
                  SelectedItem="{Binding SelectedInstallMajor}"
                  Width="120"
                  Height="30"
                  VerticalContentAlignment="Center"
                  Margin="0,0,8,0">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding StringFormat='Java {0}'}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2"
                Content="⬇️ 安裝所選版本"
                Command="{Binding InstallWithWingetCommand}"
                Height="30"
                Padding="12,4"
                Style="{DynamicResource PrimaryButtonStyle}" />
        <TextBlock Grid.Column="3"
                   Text="* 依版本快取篩選可用版本，安裝需允許系統管理員權限"
                   VerticalAlignment="Center"
                   FontSize="11"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Margin="12,0,0,0" />
      </Grid>
    </Border>

    <!-- 已安裝清單 DataGrid -->
    <Border Grid.Row="2"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8"
            Margin="0,0,0,12">
      <DataGrid ItemsSource="{Binding InstalledJavas}"
                SelectedItem="{Binding SelectedJava}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionMode="Single"
                GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                Background="Transparent"
                BorderThickness="0"
                RowHeaderWidth="0"
                MouseDoubleClick="DataGrid_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="主要版本" Binding="{Binding DisplayName}" Width="100" />
          <DataGridTextColumn Header="發行廠商" Binding="{Binding Vendor}" Width="140" />
          <DataGridTemplateColumn Header="相容狀態" SortMemberPath="StatusText" Width="150">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="執行檔路徑" Binding="{Binding ExecutablePath}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <!-- 狀態列提示 -->
    <StackPanel Grid.Row="3" Margin="0,0,0,12" Orientation="Horizontal">
      <ProgressBar IsIndeterminate="True"
                   Width="80"
                   Height="4"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center">
        <ProgressBar.Style>
          <Style TargetType="ProgressBar">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ProgressBar.Style>
      </ProgressBar>
      <TextBlock Text="{Binding StatusMessage}"
                 FontSize="12"
                 Foreground="{DynamicResource AccentBrush}"
                 VerticalAlignment="Center" />
    </StackPanel>

    <!-- 底部操作列 -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="套用選定 Java"
              Command="{Binding ApplyCommand}"
              Style="{DynamicResource PrimaryButtonStyle}"
              MinWidth="120"
              Height="34"
              Margin="0,0,10,0" />
      <Button Content="取消"
              Click="CancelButton_Click"
              MinWidth="80"
              Height="34" />
    </StackPanel>
  </Grid>
</Window>
