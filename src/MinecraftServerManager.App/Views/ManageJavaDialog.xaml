<Window x:Class="MinecraftServerManager.App.Views.ManageJavaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MinecraftServerManager.App.Controls"
    xmlns:views="using:MinecraftServerManager.App.Views"
    xmlns:vm="using:MinecraftServerManager.App.ViewModels"
    xmlns:helpers="using:MinecraftServerManager.App.Controls">

    <Grid Background="{ThemeResource WindowBrush}"
        Padding="20"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 頂部資訊卡片 -->
        <Border Grid.Row="0"
            Style="{StaticResource CardBorderStyle}"
            CornerRadius="8"
            Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                    Spacing="4">
                    <TextBlock Text="本機 Java 執行環境管理"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextBrush}" />
                    <StackPanel Orientation="Horizontal"
                        Spacing="6">
                        <TextBlock Text="目前 Minecraft 版本："
                            Foreground="{ThemeResource MutedTextBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.MinecraftVersionText}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Text="指定 Java 需求："
                            Foreground="{ThemeResource MutedTextBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Margin="10,0,0,0" />
                        <TextBlock Text="{x:Bind ViewModel.RequiredMajorText, Mode=OneWay}"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- 工具列按鈕 -->
                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button Content="自動偵測配對"
                        Command="{x:Bind ViewModel.AutoDetectCommand}" />
                    <Button Content="手動瀏覽..."
                        Command="{x:Bind ViewModel.BrowseFileCommand}" />
                    <Button Content="🔄 重新整理"
                        Command="{x:Bind ViewModel.RefreshCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- winget 線上安裝區塊 -->
        <Border Grid.Row="1"
            Style="{StaticResource CardBorderStyle}"
            CornerRadius="8"
            Padding="16,10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                    Text="線上安裝 Java (winget)："
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextBrush}"
                    Style="{ThemeResource BodyTextBlockStyle}" />
                <ComboBox Grid.Column="1"
                    ItemsSource="{x:Bind ViewModel.AvailableInstallOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedInstallMajorOption, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:JavaMajorOption">
                            <TextBlock Text="{x:Bind DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2"
                    Content="⬇️ 安裝所選版本"
                    Command="{x:Bind ViewModel.InstallWithWingetCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" />
                <TextBlock Grid.Column="3"
                    Text="* 依版本快取篩選可用版本，安裝需允許系統管理員權限"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource MutedTextBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Margin="6,0,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
            Style="{StaticResource CardBorderStyle}"
            CornerRadius="8"
            Padding="12">
            <controls:TableFrame>
                <controls:TableFrame.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="{x:Bind views:JavaListColumns.Current.VersionWidth, Mode=OneWay}" />
                            <ColumnDefinition
                                Width="{x:Bind views:JavaListColumns.Current.VendorWidth, Mode=OneWay}" />
                            <ColumnDefinition
                                Width="{x:Bind views:JavaListColumns.Current.StatusWidth, Mode=OneWay}" />
                            <ColumnDefinition
                                Width="{x:Bind views:JavaListColumns.Current.PathWidth, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <helpers:SortableTableHeader Grid.Column="0"
                            Text="主要版本"
                            SortPropertyName="MajorVersion"
                            ColumnWidth="{x:Bind views:JavaListColumns.Current.VersionWidth, Mode=TwoWay}"
                            SortRequested="OnHeaderSortRequested"
                            AutoFitRequested="OnHeaderAutoFitRequested" />
                        <helpers:SortableTableHeader Grid.Column="1"
                            Text="發行廠商"
                            SortPropertyName="Vendor"
                            ColumnWidth="{x:Bind views:JavaListColumns.Current.VendorWidth, Mode=TwoWay}"
                            SortRequested="OnHeaderSortRequested"
                            AutoFitRequested="OnHeaderAutoFitRequested" />
                        <helpers:SortableTableHeader Grid.Column="2"
                            Text="相容狀態"
                            SortPropertyName="StatusText"
                            ColumnWidth="{x:Bind views:JavaListColumns.Current.StatusWidth, Mode=TwoWay}"
                            SortRequested="OnHeaderSortRequested"
                            AutoFitRequested="OnHeaderAutoFitRequested" />
                        <helpers:SortableTableHeader Grid.Column="3"
                            Text="執行檔路徑"
                            SortPropertyName="ExecutablePath"
                            ColumnWidth="{x:Bind views:JavaListColumns.Current.PathWidth, Mode=TwoWay}"
                            SortRequested="OnHeaderSortRequested"
                            AutoFitRequested="OnHeaderAutoFitRequested" />
                    </Grid>
                </controls:TableFrame.Header>

                <ListView ItemsSource="{x:Bind ViewModel.InstalledJavas}"
                    SelectedItem="{x:Bind ViewModel.SelectedJava, Mode=TwoWay}"
                    SelectionMode="Single"
                    controls:ListSelectionBehavior.ClearOnOutsidePress="True"
                    ItemContainerStyle="{StaticResource TableListViewItemStyle}"
                    DoubleTapped="ListView_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:JavaItemViewModel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="{x:Bind views:JavaListColumns.Current.VersionWidth, Mode=OneWay}" />
                                    <ColumnDefinition
                                        Width="{x:Bind views:JavaListColumns.Current.VendorWidth, Mode=OneWay}" />
                                    <ColumnDefinition
                                        Width="{x:Bind views:JavaListColumns.Current.StatusWidth, Mode=OneWay}" />
                                    <ColumnDefinition
                                        Width="{x:Bind views:JavaListColumns.Current.PathWidth, Mode=OneWay}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                    BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                    BorderThickness="0,0,1,0"
                                    Padding="8,6">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                        Foreground="{ThemeResource TextBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1"
                                    BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                    BorderThickness="0,0,1,0"
                                    Padding="8,6">
                                    <TextBlock Text="{x:Bind Vendor, Mode=OneWay}"
                                        Foreground="{ThemeResource TextBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Vendor, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="2"
                                    BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                    BorderThickness="0,0,1,0"
                                    Padding="8,6">
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                        FontWeight="{x:Bind helpers:UiBindHelpers.FormatStatusWeight(IsRecommended), Mode=OneWay}"
                                        helpers:ThemeBrush.ForegroundKey="{x:Bind helpers:UiBindHelpers.FormatStatusBrushKey(IsRecommended), Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="3"
                                    BorderBrush="{ThemeResource DataGridGridLineBrush}"
                                    BorderThickness="0,0,1,0"
                                    Padding="8,6">
                                    <TextBlock Text="{x:Bind ExecutablePath, Mode=OneWay}"
                                        Foreground="{ThemeResource TextBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind ExecutablePath, Mode=OneWay}"
                                        VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </controls:TableFrame>
        </Border>

        <!-- 狀態列提示 -->
        <StackPanel Grid.Row="3"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Center">
            <ProgressBar IsIndeterminate="True"
                Width="80"
                Height="4"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource MutedTextBrush}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- 底部操作列 -->
        <StackPanel Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="10">
            <Button Content="套用選定 Java"
                Command="{x:Bind ViewModel.ApplyCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                MinWidth="120" />
            <Button Content="取消"
                Click="CancelButton_Click"
                MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>