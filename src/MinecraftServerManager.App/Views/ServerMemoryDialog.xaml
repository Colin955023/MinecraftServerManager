<Window x:Class="MinecraftServerManager.App.Views.ServerMemoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧠 修改伺服器記憶體設定"
        Width="500"
        Height="420"
        MinWidth="440"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Icon="pack://application:,,,/MinecraftServerManager.App;component/assets/icon.ico">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 標題與說明 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="🧠 修改伺服器記憶體" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
      <TextBlock Text="{Binding ServerDetails}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
      <TextBlock Text="{Binding SystemMemoryText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,4,0,0" />
    </StackPanel>

    <!-- 卡片輸入區 -->
    <Border Grid.Row="1"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,14">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="最大記憶體 (-Xmx, 單位 MB):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
        <TextBox Text="{Binding MaxMemoryMb, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

        <TextBlock Text="最小初始記憶體 (-Xms, 單位 MB，可留空):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
        <TextBox Text="{Binding MinMemoryMb, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </Border>

    <!-- 錯誤與警示訊息 -->
    <TextBlock Grid.Row="2"
               Text="{Binding ErrorMessage}"
               Foreground="{DynamicResource DangerBrush}"
               FontSize="12"
               TextWrapping="Wrap"
               Margin="0,0,0,12" />

    <!-- 底部按鈕區 -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消"
              Command="{Binding CancelCommand}"
              Margin="0,0,10,0"
              Padding="16,6" />
      <Button Content="儲存設定"
              Command="{Binding SaveCommand}"
              Style="{DynamicResource PrimaryButtonStyle}"
              Padding="20,6" />
    </StackPanel>
  </Grid>
</Window>
