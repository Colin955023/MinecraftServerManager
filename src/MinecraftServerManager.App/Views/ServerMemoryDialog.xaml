<ContentDialog x:Class="MinecraftServerManager.App.Views.ServerMemoryDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  mc:Ignorable="d"
  Title="修改伺服器記憶體設定"
  PrimaryButtonText="儲存設定"
  CloseButtonText="取消"
  DefaultButton="Primary"
  PrimaryButtonClick="OnPrimaryButtonClicked">

  <StackPanel Margin="0,12,0,0"
    MinWidth="420">
    <TextBlock Text="{x:Bind ViewModel.ServerDetails}"
      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
      FontSize="{StaticResource BodyTextBlockFontSize}"
      Margin="0,0,0,4" />

    <TextBlock Text="{x:Bind ViewModel.SystemMemoryText}"
      Foreground="{ThemeResource AccentTextBrush}"
      FontSize="{StaticResource BodyTextBlockFontSize}"
      Margin="0,0,0,16" />

    <!-- 卡片輸入區 -->
    <Border Style="{StaticResource CardBorderStyle}"
      Padding="16"
      Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="最大記憶體（-Xmx，單位 MB）："
          FontSize="{StaticResource BodyTextBlockFontSize}"
          FontWeight="SemiBold"
          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
          Margin="0,0,0,6" />
        <TextBox AutomationProperties.Name="最大記憶體"
          Text="{x:Bind ViewModel.MaxMemoryMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Margin="0,0,0,14" />

        <TextBlock Text="最小初始記憶體（-Xms，單位 MB，可留空）："
          FontSize="{StaticResource BodyTextBlockFontSize}"
          FontWeight="SemiBold"
          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
          Margin="0,0,0,6" />
        <TextBox AutomationProperties.Name="最小初始記憶體"
          Text="{x:Bind ViewModel.MinMemoryMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </Border>

    <!-- 錯誤與警示訊息 -->
    <InfoBar Severity="Error"
      IsClosable="False"
      IsOpen="{x:Bind controls:UiBindHelpers.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
      Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
  </StackPanel>
</ContentDialog>
