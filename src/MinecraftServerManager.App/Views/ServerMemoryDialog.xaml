<ContentDialog x:Class="MinecraftServerManager.App.Views.ServerMemoryDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels"
  mc:Ignorable="d"
  Title="🧠 修改伺服器記憶體設定"
  PrimaryButtonText="儲存設定"
  CloseButtonText="取消"
  DefaultButton="Primary"
  PrimaryButtonClick="Dialog_PrimaryButtonClick">

  <StackPanel Margin="0,12,0,0"
    MinWidth="420">
    <TextBlock Text="{x:Bind ViewModel.ServerDetails, Mode=OneWay}"
      Foreground="{ThemeResource MutedTextBrush}"
      FontSize="13"
      Margin="0,0,0,4" />

    <TextBlock Text="{x:Bind ViewModel.SystemMemoryText, Mode=OneWay}"
      Foreground="{ThemeResource AccentBrush}"
      FontSize="13"
      Margin="0,0,0,16" />

    <!-- 卡片輸入區 -->
    <Border Background="{ThemeResource CardBrush}"
      BorderBrush="{ThemeResource BorderBrush}"
      BorderThickness="1"
      CornerRadius="8"
      Padding="16"
      Margin="0,0,0,14">
      <StackPanel>
        <TextBlock Text="最大記憶體（-Xmx，單位 MB）："
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{ThemeResource TextBrush}"
          Margin="0,0,0,6" />
        <TextBox
          Text="{x:Bind ViewModel.MaxMemoryMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          Margin="0,0,0,14" />

        <TextBlock Text="最小初始記憶體（-Xms，單位 MB，可留空）："
          FontSize="13"
          FontWeight="SemiBold"
          Foreground="{ThemeResource TextBrush}"
          Margin="0,0,0,6" />
        <TextBox
          Text="{x:Bind ViewModel.MinMemoryMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </Border>

    <!-- 錯誤與警示訊息 -->
    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
      Foreground="{ThemeResource DangerBrush}"
      FontSize="12"
      TextWrapping="Wrap" />
  </StackPanel>
</ContentDialog>