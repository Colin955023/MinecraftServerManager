<Window x:Class="MinecraftServerManager.App.Views.CustomConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="確認操作"
        Width="460"
        SizeToContent="Height"
        MinWidth="380"
        MaxWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded">
  <Border Padding="22" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="12" CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 標題與圖示 -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
        <TextBlock x:Name="IconText" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
      </StackPanel>

      <!-- 訊息內容 -->
      <TextBlock Grid.Row="1"
                 x:Name="MessageText"
                 TextWrapping="Wrap"
                 FontSize="13"
                 LineHeight="20"
                 Foreground="{DynamicResource TextBrush}"
                 Margin="0,0,0,20" />

      <!-- 按鈕區域 -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CancelButton"
                Content="取消"
                MinWidth="90"
                Padding="12,6"
                Margin="0,0,10,0"
                IsCancel="True"
                Click="CancelButton_Click" />
        <Button x:Name="ConfirmButton"
                Content="確定"
                MinWidth="90"
                Padding="12,6"
                IsDefault="True"
                Style="{DynamicResource PrimaryButtonStyle}"
                Click="ConfirmButton_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
