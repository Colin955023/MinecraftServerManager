<ContentDialog x:Class="MinecraftServerManager.App.Views.CustomConfirmDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  mc:Ignorable="d"
  Title="{x:Bind DialogTitle}"
  PrimaryButtonText="確定"
  CloseButtonText="取消"
  DefaultButton="Primary">

  <controls:IconMessageContent Margin="0,12,0,0"
    Glyph="{x:Bind IconGlyph}"
    IconBrushKey="{x:Bind IconBrushKey}"
    Message="{x:Bind Message}" />
</ContentDialog>
