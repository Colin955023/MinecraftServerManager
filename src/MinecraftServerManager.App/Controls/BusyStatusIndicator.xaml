<UserControl
  x:Class="MinecraftServerManager.App.Controls.BusyStatusIndicator"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">

  <StackPanel VerticalAlignment="Center"
    Orientation="Horizontal"
    Spacing="8">
    <ProgressBar Style="{StaticResource BusyProgressBarStyle}"
      VerticalAlignment="Center"
      Visibility="{x:Bind IsBusy, Mode=OneWay}"
      AutomationProperties.Name="{x:Bind BusyName}" />
    <TextBlock x:Name="MessageTextBlock"
      VerticalAlignment="Center"
      Style="{StaticResource SecondaryCaptionTextStyle}"
      Text="{x:Bind Message, Mode=OneWay}"
      AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</UserControl>
