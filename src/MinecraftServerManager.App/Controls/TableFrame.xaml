<UserControl
    x:Class="MinecraftServerManager.App.Controls.TableFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource TableHeaderCornerRadius}">
            <ContentPresenter Content="{x:Bind Header, Mode=OneWay}"
                HorizontalContentAlignment="Stretch" />
        </Border>
        <Border Grid.Row="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1,0,1,1"
            CornerRadius="{StaticResource TableBodyCornerRadius}">
            <Grid>
                <ContentPresenter Content="{x:Bind Body, Mode=OneWay}"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
                <TextBlock x:Name="EmptyTextBlock"
                    x:Load="{x:Bind IsEmpty, Mode=OneWay}"
                    Text="{x:Bind EmptyText, Mode=OneWay}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    Margin="{StaticResource CardPadding}"
                    IsHitTestVisible="False"
                    AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>
    </Grid>
</UserControl>