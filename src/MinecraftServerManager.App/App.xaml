<Application
        x:Class="MinecraftServerManager.App.App"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls"
        xmlns:customControls="using:MinecraftServerManager.App.Controls"
        xmlns:local="using:MinecraftServerManager.App">
        <Application.Resources>
                <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                                <controls:XamlControlsResources />
                                <ResourceDictionary Source="ms-appx:///Resources/ColorIcons.xaml" />
                        </ResourceDictionary.MergedDictionaries>

                        <ResourceDictionary.ThemeDictionaries>
                                <!-- 深色主題（WinUI 3 預設以 Default 代表 Dark） -->
                                <ResourceDictionary x:Key="Default">
                                        <SolidColorBrush x:Key="WindowBrush"
                                                Color="#101114" />
                                        <SolidColorBrush x:Key="SidebarBrush"
                                                Color="#17191E" />
                                        <SolidColorBrush x:Key="CardBrush"
                                                Color="#1F2229" />
                                        <SolidColorBrush x:Key="BorderBrush"
                                                Color="#353A45" />
                                        <SolidColorBrush x:Key="TextBrush"
                                                Color="#F3F4F6" />
                                        <SolidColorBrush x:Key="MutedTextBrush"
                                                Color="#A5ACB9" />
                                        <SolidColorBrush x:Key="AccentBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentHoverBrush"
                                                Color="#3D5CC4" />
                                        <SolidColorBrush x:Key="WarningBrush"
                                                Color="#F59E0B" />
                                        <SolidColorBrush x:Key="DangerBrush"
                                                Color="#B91C1C" />
                                        <SolidColorBrush x:Key="DangerHoverBrush"
                                                Color="#991B1B" />
                                        <SolidColorBrush x:Key="SuccessBrush"
                                                Color="#238636" />
                                        <SolidColorBrush x:Key="SuccessHoverBrush"
                                                Color="#2EA043" />
                                        <SolidColorBrush x:Key="NotificationBrush"
                                                Color="#283A5A" />
                                        <SolidColorBrush x:Key="ButtonDefaultHoverBrush"
                                                Color="#2E3440" />
                                        <SolidColorBrush x:Key="NavButtonHoverBrush"
                                                Color="#2D323E" />
                                        <SolidColorBrush x:Key="DataGridGridLineBrush"
                                                Color="#3F4552" />
                                        <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush"
                                                Color="#2B2D35" />
                                        <SolidColorBrush x:Key="ButtonDisabledForegroundBrush"
                                                Color="#94A3B8" />
                                        <SolidColorBrush x:Key="ButtonDisabledBorderBrush"
                                                Color="#383C46" />
                                        <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush"
                                                Color="#1F2229" />
                                        <SolidColorBrush x:Key="ComboBoxItemHoverBrush"
                                                Color="#2E3442" />
                                        <SolidColorBrush x:Key="ComboBoxItemSelectedBrush"
                                                Color="#3B4459" />

                                        <!-- WinUI 3 原生強調色控制項筆刷覆蓋 -->
                                        <Color x:Key="SystemAccentColor">#4F6FD8</Color>
                                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"
                                                Color="#3D5CC4" />
                                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"
                                                Color="#314CA4" />
                                        <SolidColorBrush x:Key="AccentFillColorDisabledBrush"
                                                Color="#804F6FD8" />
                                </ResourceDictionary>

                                <!-- 淺色主題 -->
                                <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="WindowBrush"
                                                Color="#F5F6FA" />
                                        <SolidColorBrush x:Key="SidebarBrush"
                                                Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="CardBrush"
                                                Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="BorderBrush"
                                                Color="#D9DEE8" />
                                        <SolidColorBrush x:Key="TextBrush"
                                                Color="#1A1D24" />
                                        <SolidColorBrush x:Key="MutedTextBrush"
                                                Color="#5E6675" />
                                        <SolidColorBrush x:Key="AccentBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentHoverBrush"
                                                Color="#3D5CC4" />
                                        <SolidColorBrush x:Key="WarningBrush"
                                                Color="#B45309" />
                                        <SolidColorBrush x:Key="DangerBrush"
                                                Color="#DC2626" />
                                        <SolidColorBrush x:Key="DangerHoverBrush"
                                                Color="#B91C1C" />
                                        <SolidColorBrush x:Key="SuccessBrush"
                                                Color="#1A7F37" />
                                        <SolidColorBrush x:Key="SuccessHoverBrush"
                                                Color="#1F883D" />
                                        <SolidColorBrush x:Key="NotificationBrush"
                                                Color="#E7EEFF" />
                                        <SolidColorBrush x:Key="ButtonDefaultHoverBrush"
                                                Color="#E2E8F0" />
                                        <SolidColorBrush x:Key="NavButtonHoverBrush"
                                                Color="#E5E7EB" />
                                        <SolidColorBrush x:Key="DataGridGridLineBrush"
                                                Color="#D1D5DB" />
                                        <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush"
                                                Color="#E2E8F0" />
                                        <SolidColorBrush x:Key="ButtonDisabledForegroundBrush"
                                                Color="#1A1D24" />
                                        <SolidColorBrush x:Key="ButtonDisabledBorderBrush"
                                                Color="#CBD5E1" />
                                        <SolidColorBrush x:Key="ComboBoxPopupBackgroundBrush"
                                                Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="ComboBoxItemHoverBrush"
                                                Color="#EBF0FF" />
                                        <SolidColorBrush x:Key="ComboBoxItemSelectedBrush"
                                                Color="#D6E4FF" />

                                        <!-- WinUI 3 原生強調色控制項筆刷覆蓋 -->
                                        <Color x:Key="SystemAccentColor">#4F6FD8</Color>
                                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"
                                                Color="#3D5CC4" />
                                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"
                                                Color="#314CA4" />
                                        <SolidColorBrush x:Key="AccentFillColorDisabledBrush"
                                                Color="#804F6FD8" />
                                </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>

                        <!-- 主要突顯按鈕樣式 (Primary) -->
                        <Style x:Key="PrimaryButtonStyle"
                                TargetType="Button"
                                BasedOn="{StaticResource AccentButtonStyle}">
                                <Setter Property="Background"
                                        Value="{ThemeResource AccentBrush}" />
                                <Setter Property="Foreground"
                                        Value="#FFFFFF" />
                                <Setter Property="CornerRadius"
                                        Value="6" />
                                <Setter Property="Padding"
                                        Value="14,4" />
                                <Setter Property="MinHeight"
                                        Value="36" />
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                        </Style>

                        <!-- 危險動作按鈕樣式 (Danger) -->
                        <Style x:Key="DangerButtonStyle"
                                TargetType="Button">
                                <Setter Property="Background"
                                        Value="{ThemeResource DangerBrush}" />
                                <Setter Property="Foreground"
                                        Value="#FFFFFF" />
                                <Setter Property="BorderBrush"
                                        Value="{ThemeResource DangerBrush}" />
                                <Setter Property="BorderThickness"
                                        Value="1" />
                                <Setter Property="CornerRadius"
                                        Value="6" />
                                <Setter Property="Padding"
                                        Value="14,4" />
                                <Setter Property="MinHeight"
                                        Value="36" />
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                        </Style>

                        <!-- 成功/確認按鈕樣式 (Success) -->
                        <Style x:Key="SuccessButtonStyle"
                                TargetType="Button">
                                <Setter Property="Background"
                                        Value="{ThemeResource SuccessBrush}" />
                                <Setter Property="Foreground"
                                        Value="#FFFFFF" />
                                <Setter Property="BorderBrush"
                                        Value="{ThemeResource SuccessBrush}" />
                                <Setter Property="BorderThickness"
                                        Value="1" />
                                <Setter Property="CornerRadius"
                                        Value="6" />
                                <Setter Property="Padding"
                                        Value="14,4" />
                                <Setter Property="MinHeight"
                                        Value="36" />
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                        </Style>

                        <!-- 左側導覽列按鈕樣式 (NavButton) -->
                        <Style x:Key="NavButtonStyle"
                                TargetType="Button">
                                <Setter Property="Background"
                                        Value="Transparent" />
                                <Setter Property="BorderBrush"
                                        Value="Transparent" />
                                <Setter Property="BorderThickness"
                                        Value="0" />
                                <Setter Property="Foreground"
                                        Value="{ThemeResource TextBrush}" />
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Left" />
                                <Setter Property="HorizontalAlignment"
                                        Value="Stretch" />
                                <Setter Property="CornerRadius"
                                        Value="6" />
                                <Setter Property="Padding"
                                        Value="14,10" />
                                <Setter Property="Margin"
                                        Value="0,2" />
                        </Style>
                        <!-- 全域 ComboBox 預設啟用滾輪選項切換 -->
                        <Style TargetType="ComboBox">
                                <Setter
                                        Property="customControls:ComboBoxScrollHelper.EnableWheelScroll"
                                        Value="True" />
                        </Style>

                        <!-- 共用多欄表格列樣式：零內距、拉伸對齊並帶底部水平分隔線 -->
                        <Style x:Key="TableListViewItemStyle"
                                TargetType="ListViewItem">
                                <Setter Property="Padding"
                                        Value="0" />
                                <Setter Property="Margin"
                                        Value="0" />
                                <Setter Property="MinHeight"
                                        Value="34" />
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch" />
                                <Setter Property="VerticalContentAlignment"
                                        Value="Stretch" />
                                <Setter Property="BorderBrush"
                                        Value="{ThemeResource DataGridGridLineBrush}" />
                                <Setter Property="BorderThickness"
                                        Value="0,0,0,1" />
                                <Setter Property="CornerRadius"
                                        Value="0" />
                        </Style>
                </ResourceDictionary>
        </Application.Resources>
</Application>