<Application
        x:Class="MinecraftServerManager.App.App"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Microsoft.UI.Xaml.Controls"
        xmlns:customControls="using:MinecraftServerManager.App.Controls"
        xmlns:local="using:MinecraftServerManager.App">
        <Application.Resources>
                <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                                <controls:XamlControlsResources />
                                <ResourceDictionary Source="ms-appx:///Resources/Glyphs.xaml" />
                        </ResourceDictionary.MergedDictionaries>

                        <ResourceDictionary.ThemeDictionaries>
                                <!-- 深色主題（Default 即 Dark） -->
                                <ResourceDictionary x:Key="Default">
                                        <!-- 實心危險／成功按鈕底色 -->
                                        <SolidColorBrush x:Key="DangerBrush"
                                                Color="#B91C1C" />
                                        <SolidColorBrush x:Key="SuccessBrush"
                                                Color="#238636" />
                                        <!-- 實心按鈕停用狀態（對齊 Fluent
                                        AccentFillColorDisabled／TextOnAccentFillColorDisabled） -->
                                        <SolidColorBrush x:Key="SolidButtonDisabledBackgroundBrush"
                                                Color="#28FFFFFF" />
                                        <SolidColorBrush x:Key="SolidButtonDisabledForegroundBrush"
                                                Color="#87FFFFFF" />
                                        <!-- 程式碼以鍵解析之語意筆刷（ThemeBrush）：須為實色，StaticResource 別名會依系統主題解析 -->
                                        <SolidColorBrush x:Key="SuccessTextBrush"
                                                Color="#6CCB5F" />
                                        <SolidColorBrush x:Key="DangerTextBrush"
                                                Color="#FF99A4" />
                                        <SolidColorBrush x:Key="WarningTextBrush"
                                                Color="#FCE100" />
                                        <SolidColorBrush x:Key="MutedTextBrush"
                                                Color="#C5FFFFFF" />
                                        <SolidColorBrush x:Key="NotificationBackgroundBrush"
                                                Color="#282828" />

                                        <!-- 強調色專用鍵：框架同名鍵在非系統主題不受此處覆寫，自訂強調色須經專用鍵套用 -->
                                        <SolidColorBrush x:Key="AccentBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentForegroundBrush"
                                                Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="AccentTextBrush"
                                                Color="#4F6FD8" />

                                        <!-- 框架強調色鍵（系統主題下的控制項狀態） -->
                                        <Color x:Key="SystemAccentColor">#4F6FD8</Color>
                                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentFillColorDisabledBrush"
                                                Color="#644F6FD8" />
                                        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentButtonForeground"
                                                Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver"
                                                Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="AccentButtonForegroundPressed"
                                                Color="#FFFFFF" />
                                </ResourceDictionary>

                                <!-- 淺色主題 -->
                                <ResourceDictionary x:Key="Light">
                                        <!-- 實心危險／成功按鈕底色 -->
                                        <SolidColorBrush x:Key="DangerBrush"
                                                Color="#DC2626" />
                                        <SolidColorBrush x:Key="SuccessBrush"
                                                Color="#1A7F37" />
                                        <!-- 實心按鈕停用狀態（對齊 Fluent
                                        AccentFillColorDisabled／TextOnAccentFillColorDisabled） -->
                                        <SolidColorBrush x:Key="SolidButtonDisabledBackgroundBrush"
                                                Color="#37000000" />
                                        <SolidColorBrush x:Key="SolidButtonDisabledForegroundBrush"
                                                Color="#FFFFFF" />
                                        <!-- 程式碼以鍵解析之語意筆刷（ThemeBrush）：須為實色，StaticResource 別名會依系統主題解析 -->
                                        <SolidColorBrush x:Key="SuccessTextBrush"
                                                Color="#0F7B0F" />
                                        <SolidColorBrush x:Key="DangerTextBrush"
                                                Color="#C42B1C" />
                                        <SolidColorBrush x:Key="WarningTextBrush"
                                                Color="#9D5D00" />
                                        <SolidColorBrush x:Key="MutedTextBrush"
                                                Color="#9E000000" />
                                        <SolidColorBrush x:Key="NotificationBackgroundBrush"
                                                Color="#F9F9F9" />

                                        <!-- 強調色專用鍵：框架同名鍵在非系統主題不受此處覆寫，自訂強調色須經專用鍵套用 -->
                                        <SolidColorBrush x:Key="AccentBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentForegroundBrush"
                                                Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="AccentTextBrush"
                                                Color="#4F6FD8" />

                                        <!-- 框架強調色鍵（系統主題下的控制項狀態） -->
                                        <Color x:Key="SystemAccentColor">#4F6FD8</Color>
                                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentFillColorDisabledBrush"
                                                Color="#644F6FD8" />
                                        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush"
                                                Color="#4F6FD8" />
                                        <SolidColorBrush x:Key="AccentButtonForeground"
                                                Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver"
                                                Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="AccentButtonForegroundPressed"
                                                Color="#FFFFFF" />
                                </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>

                        <!-- 間距 token（4px 網格） -->
                        <Thickness x:Key="PageContentMargin">28,20,28,20</Thickness>
                        <Thickness x:Key="CardPadding">12</Thickness>
                        <Thickness x:Key="DialogPadding">20</Thickness>
                        <Thickness x:Key="CardHeaderPadding">12,10</Thickness>
                        <Thickness x:Key="CompactButtonPadding">12,4</Thickness>
                        <CornerRadius x:Key="TableHeaderCornerRadius">4,4,0,0</CornerRadius>
                        <CornerRadius x:Key="TableBodyCornerRadius">0,0,4,4</CornerRadius>

                        <!-- 實心按鈕共用範本：底色取自樣式，暫留／按下以不透明度呈現（同 Fluent 強調色 90%／80%），停用改用專用筆刷 -->
                        <ControlTemplate x:Key="SolidButtonTemplate"
                                TargetType="Button">
                                <ContentPresenter x:Name="ContentPresenter"
                                        Background="{TemplateBinding Background}"
                                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        ContentTransitions="{TemplateBinding ContentTransitions}"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        AutomationProperties.AccessibilityView="Raw">
                                        <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal" />
                                                        <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                        <Setter
                                                                                Target="ContentPresenter.Opacity"
                                                                                Value="0.9" />
                                                                </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                                <VisualState.Setters>
                                                                        <Setter
                                                                                Target="ContentPresenter.Opacity"
                                                                                Value="0.8" />
                                                                </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled">
                                                                <VisualState.Setters>
                                                                        <Setter
                                                                                Target="ContentPresenter.Background"
                                                                                Value="{ThemeResource SolidButtonDisabledBackgroundBrush}" />
                                                                        <Setter
                                                                                Target="ContentPresenter.BorderBrush"
                                                                                Value="Transparent" />
                                                                        <Setter
                                                                                Target="ContentPresenter.Foreground"
                                                                                Value="{ThemeResource SolidButtonDisabledForegroundBrush}" />
                                                                </VisualState.Setters>
                                                        </VisualState>
                                                </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                </ContentPresenter>
                        </ControlTemplate>

                        <!-- 主要突顯按鈕樣式 (Primary) -->
                        <Style x:Key="PrimaryButtonStyle"
                                TargetType="Button"
                                BasedOn="{StaticResource AccentButtonStyle}">
                                <Setter Property="Background"
                                        Value="{ThemeResource AccentBrush}" />
                                <Setter Property="Foreground"
                                        Value="{ThemeResource AccentForegroundBrush}" />
                                <Setter Property="Template"
                                        Value="{StaticResource SolidButtonTemplate}" />
                                <Setter Property="CornerRadius"
                                        Value="{StaticResource ControlCornerRadius}" />
                                <Setter Property="Padding"
                                        Value="14,4" />
                                <Setter Property="MinHeight"
                                        Value="36" />
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                        </Style>

                        <!-- 實心色彩按鈕共用基底 (Danger / Success)：統一前景、圓角、邊距與字重 -->
                        <Style x:Key="SolidColorButtonBaseStyle"
                                TargetType="Button">
                                <Setter Property="Foreground"
                                        Value="#FFFFFF" />
                                <Setter Property="Template"
                                        Value="{StaticResource SolidButtonTemplate}" />
                                <Setter Property="BorderThickness"
                                        Value="1" />
                                <Setter Property="CornerRadius"
                                        Value="{StaticResource ControlCornerRadius}" />
                                <Setter Property="Padding"
                                        Value="14,4" />
                                <Setter Property="MinHeight"
                                        Value="36" />
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                        </Style>

                        <!-- 危險動作按鈕樣式 (Danger) -->
                        <Style x:Key="DangerButtonStyle"
                                TargetType="Button"
                                BasedOn="{StaticResource SolidColorButtonBaseStyle}">
                                <Setter Property="Background"
                                        Value="{ThemeResource DangerBrush}" />
                                <Setter Property="BorderBrush"
                                        Value="{ThemeResource DangerBrush}" />
                        </Style>

                        <!-- 成功/確認按鈕樣式 (Success) -->
                        <Style x:Key="SuccessButtonStyle"
                                TargetType="Button"
                                BasedOn="{StaticResource SolidColorButtonBaseStyle}">
                                <Setter Property="Background"
                                        Value="{ThemeResource SuccessBrush}" />
                                <Setter Property="BorderBrush"
                                        Value="{ThemeResource SuccessBrush}" />
                        </Style>

                        <!-- 全域 ComboBox 預設啟用滾輪選項切換 -->
                        <Style TargetType="ComboBox">
                                <Setter
                                        Property="customControls:ComboBoxScrollHelper.EnableWheelScroll"
                                        Value="True" />
                        </Style>

                        <!-- 共用卡片外框：卡片底色、邊框色與 1px 邊框；圓角與內距由各處指定 -->
                        <Style x:Key="CardBorderStyle"
                                TargetType="Border">
                                <Setter Property="Background"
                                        Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush"
                                        Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness"
                                        Value="1" />
                                <Setter Property="CornerRadius"
                                        Value="{StaticResource OverlayCornerRadius}" />
                                <Setter Property="Padding"
                                        Value="{StaticResource CardHeaderPadding}" />
                        </Style>

                        <!-- 區塊卡片 -->
                        <Style x:Key="PanelCardStyle"
                                TargetType="Border"
                                BasedOn="{StaticResource CardBorderStyle}">
                                <Setter Property="Padding"
                                        Value="{StaticResource CardPadding}" />
                        </Style>

                        <!-- 忙碌進度列 -->
                        <Style x:Key="BusyProgressBarStyle"
                                TargetType="ProgressBar">
                                <Setter Property="IsIndeterminate"
                                        Value="True" />
                                <Setter Property="Width"
                                        Value="80" />
                                <Setter Property="Height"
                                        Value="4" />
                        </Style>

                        <!-- 共用多欄表格列樣式：零內距、拉伸對齊並帶底部水平分隔線 -->
                        <Style x:Key="TableListViewItemStyle"
                                TargetType="ListViewItem">
                                <Setter Property="Padding"
                                        Value="0" />
                                <Setter Property="Margin"
                                        Value="0" />
                                <Setter Property="MinHeight"
                                        Value="34" />
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Stretch" />
                                <Setter Property="VerticalContentAlignment"
                                        Value="Stretch" />
                                <Setter Property="BorderBrush"
                                        Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness"
                                        Value="0,0,0,1" />
                                <Setter Property="CornerRadius"
                                        Value="0" />
                        </Style>

                        <!-- 主控台配色（深淺色相同） -->
                        <SolidColorBrush x:Key="ConsoleBackgroundBrush"
                                Color="#0C0C0C" />
                        <SolidColorBrush x:Key="ConsoleForegroundBrush"
                                Color="#00FF66" />
                        <SolidColorBrush x:Key="ConsoleMutedTextBrush"
                                Color="#8B949E" />
                        <FontFamily x:Key="ConsoleFontFamily">Consolas, Cascadia Code, Courier New</FontFamily>

                        <!-- 頁面標題 -->
                        <Style x:Key="PageTitleTextStyle"
                                TargetType="TextBlock">
                                <Setter Property="FontSize"
                                        Value="{StaticResource TitleTextBlockFontSize}" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                                <Setter Property="Foreground"
                                        Value="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Style>

                        <!-- 條列文字 -->
                        <Style x:Key="BulletTextStyle"
                                TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                <Setter Property="Margin"
                                        Value="0,2" />
                                <Setter Property="TextWrapping"
                                        Value="Wrap" />
                        </Style>

                        <!-- 區段標題 -->
                        <Style x:Key="SectionHeaderTextStyle"
                                TargetType="TextBlock">
                                <Setter Property="FontSize"
                                        Value="{StaticResource BodyLargeTextBlockFontSize}" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                                <Setter Property="Foreground"
                                        Value="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Style>

                        <!-- 表格儲存格：右側垂直分隔線 -->
                        <Style x:Key="TableCellBorderStyle"
                                TargetType="Border">
                                <Setter Property="BorderBrush"
                                        Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Setter Property="BorderThickness"
                                        Value="0,0,1,0" />
                        </Style>

                        <!-- 次要說明文字 -->
                        <Style x:Key="SecondaryCaptionTextStyle"
                                TargetType="TextBlock"
                                BasedOn="{StaticResource CaptionTextBlockStyle}">
                                <Setter Property="Foreground"
                                        Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Style>

                        <!-- 對話視窗根版面 -->
                        <Style x:Key="DialogRootGridStyle"
                                TargetType="Grid">
                                <Setter Property="Padding"
                                        Value="{StaticResource DialogPadding}" />
                                <Setter Property="RowSpacing"
                                        Value="12" />
                        </Style>
                </ResourceDictionary>
        </Application.Resources>
</Application>