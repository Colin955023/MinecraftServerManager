<Window
  x:Class="MinecraftServerManager.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:MinecraftServerManager.App.Controls"
  xmlns:local="using:MinecraftServerManager.App"
  xmlns:views="using:MinecraftServerManager.App.Views"
  xmlns:vm="using:MinecraftServerManager.App.ViewModels"
  mc:Ignorable="d">

  <Grid x:Name="RootGrid"
    Background="{ThemeResource WindowBrush}">
    <Grid.ColumnDefinitions>
      <!-- 側邊導覽寬度 240 -->
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- 左側導覽列 -->
    <Border Grid.Column="0"
      Background="{ThemeResource SidebarBrush}"
      BorderBrush="{ThemeResource BorderBrush}"
      BorderThickness="0,0,1,0">
      <Grid Margin="12,18,12,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 頂部標題 -->
        <StackPanel Grid.Row="0"
          Margin="12,4,8,22">
          <TextBlock Text="MINECRAFT"
            FontSize="11"
            FontWeight="Bold"
            Foreground="{ThemeResource TextBrush}" />
          <TextBlock Text="Server Manager"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="{ThemeResource TextBrush}"
            Margin="0,1,0,0" />
        </StackPanel>

        <!-- 主要導覽項目與操作按鈕 -->
        <StackPanel Grid.Row="1"
          Spacing="4">
          <!-- 建立伺服器 -->
          <Button Click="OnNavigateCreateClicked"
            Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal"
              VerticalAlignment="Center"
              Spacing="12">
              <controls:ColorIcon Source="{StaticResource IconCreateServer}"
                Width="18"
                Height="18"
                VerticalAlignment="Center" />
              <TextBlock Text="建立伺服器"
                FontSize="14"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextBrush}" />
            </StackPanel>
          </Button>

          <!-- 管理伺服器 -->
          <Button Click="OnNavigateManageClicked"
            Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal"
              VerticalAlignment="Center"
              Spacing="12">
              <controls:ColorIcon Source="{StaticResource IconManageServer}"
                Width="18"
                Height="18"
                VerticalAlignment="Center" />
              <TextBlock Text="管理伺服器"
                FontSize="14"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextBrush}" />
            </StackPanel>
          </Button>

          <!-- 模組管理 -->
          <Button Click="OnNavigateModsClicked"
            Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal"
              VerticalAlignment="Center"
              Spacing="12">
              <controls:ColorIcon Source="{StaticResource IconMods}"
                Width="18"
                Height="18"
                VerticalAlignment="Center" />
              <TextBlock Text="模組管理"
                FontSize="14"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextBrush}" />
            </StackPanel>
          </Button>

          <!-- 分隔線 -->
          <Border Height="1"
            Background="{ThemeResource BorderBrush}"
            Margin="8,8,8,8" />

          <!-- 匯入伺服器 -->
          <Button Click="OnImportServerClicked"
            Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal"
              VerticalAlignment="Center"
              Spacing="12">
              <controls:ColorIcon Source="{StaticResource IconImport}"
                Width="18"
                Height="18"
                VerticalAlignment="Center" />
              <TextBlock Text="匯入伺服器"
                FontSize="14"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextBrush}" />
            </StackPanel>
          </Button>

          <!-- 開啟資料夾 -->
          <Button Click="OnOpenFolderClicked"
            Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal"
              VerticalAlignment="Center"
              Spacing="12">
              <controls:ColorIcon Source="{StaticResource IconFolder}"
                Width="18"
                Height="18"
                VerticalAlignment="Center" />
              <TextBlock Text="開啟資料夾"
                FontSize="14"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- 底部固定設定項目 -->
        <StackPanel Grid.Row="2">
          <Border Height="1"
            Background="{ThemeResource BorderBrush}"
            Margin="8,8,8,12" />
          <Button Click="OnNavigateAboutClicked"
            Style="{StaticResource NavButtonStyle}">
            <StackPanel Orientation="Horizontal"
              VerticalAlignment="Center"
              Spacing="12">
              <controls:ColorIcon Source="{StaticResource IconAbout}"
                Width="18"
                Height="18"
                VerticalAlignment="Center" />
              <TextBlock Text="關於與設定"
                FontSize="14"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 右側主要內容區與右下角浮動 Toast 容器 -->
    <Grid Grid.Column="1">
      <ContentPresenter x:Name="PageContentHost"
        Margin="28,20,28,20" />
      <StackPanel x:Name="ToastContainer"
        VerticalAlignment="Bottom"
        HorizontalAlignment="Right"
        Margin="0,0,24,24"
        Spacing="8"
        Canvas.ZIndex="1000" />
    </Grid>
  </Grid>
</Window>