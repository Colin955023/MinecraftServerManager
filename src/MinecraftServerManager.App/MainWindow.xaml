<Window
  x:Class="MinecraftServerManager.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar"
      Title="Minecraft 伺服器管理器" />

    <!-- 左側導覽：匯入與開啟資料夾為動作項目，不改變選取 -->
    <NavigationView x:Name="NavView"
      Grid.Row="1"
      PaneDisplayMode="Left"
      OpenPaneLength="240"
      IsBackButtonVisible="Collapsed"
      IsPaneToggleButtonVisible="False"
      IsSettingsVisible="False"
      IsTitleBarAutoPaddingEnabled="False"
      ItemInvoked="OnNavItemInvoked">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="建立伺服器"
          Tag="create">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="{StaticResource IconCreateServer}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="管理伺服器"
          Tag="manage">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="{StaticResource IconManageServer}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="模組管理"
          Tag="mods">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="{StaticResource IconMods}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItemSeparator />
        <NavigationViewItem Content="匯入伺服器"
          Tag="import"
          SelectsOnInvoked="False">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="{StaticResource IconImport}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="開啟資料夾"
          Tag="open_folder"
          SelectsOnInvoked="False">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="{StaticResource IconFolder}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="關於與設定"
          Tag="about_preferences">
          <NavigationViewItem.Icon>
            <FontIcon Glyph="{StaticResource IconAbout}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <!-- 主要內容區與右上角 InfoBar 通知容器 -->
      <Grid>
        <ContentPresenter x:Name="PageContentHost"
          Margin="{StaticResource PageContentMargin}">
          <ContentPresenter.ContentTransitions>
            <TransitionCollection>
              <EntranceThemeTransition FromVerticalOffset="24" />
            </TransitionCollection>
          </ContentPresenter.ContentTransitions>
        </ContentPresenter>
        <StackPanel x:Name="NotificationContainer"
          VerticalAlignment="Top"
          HorizontalAlignment="Right"
          Margin="0,8,24,0"
          Spacing="8"
          Canvas.ZIndex="1000">
          <StackPanel.ChildrenTransitions>
            <TransitionCollection>
              <AddDeleteThemeTransition />
              <RepositionThemeTransition />
            </TransitionCollection>
          </StackPanel.ChildrenTransitions>
        </StackPanel>
      </Grid>
    </NavigationView>
  </Grid>
</Window>