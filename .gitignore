## Minecraft Server Manager - .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# Build / packaging (Nuitka)
build/
dist/
*.dist/
*.build/
*.onefile-build/
*.onefile-dist/
.nuitka/
.nuitka-cache/
*.spec
*.manifest

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Project runtime
config.json
/settings.json
*.log
logs/
temp/
tmp/
cache/

# Binaries
*.exe

# other
*.egg-info
docs/*
!docs/USER_GUIDE.md
!docs/TECHNICAL_OVERVIEW.md
.github/skills
report/*
!report/comprehensive_report.py
