# 強制文字檔的換行字元一致性

# Auto detect text files and normalize line endings to LF
* text=auto

# C# / .NET / Visual Studio：CRLF（Windows 原生 WinUI 3 專案）
*.cs text eol=crlf
*.slnx text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.manifest text eol=crlf
*.xaml text eol=crlf

# PowerShell：CRLF（Windows 標準）
*.ps1 text eol=crlf

# 設定檔：LF
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.config text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
.github/CODEOWNERS text eol=lf

# NuGet 鎖定檔：CRLF（維持 Windows NuGet 工具輸出避免來回變動）
packages.lock.json text eol=crlf

# 網頁：LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf

# 文件：LF
*.md text eol=lf
*.txt text eol=lf

# 二進位檔案（不進行轉換）
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdb binary
*.jar binary
*.zip binary
*.7z binary
*.avif binary
