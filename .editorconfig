# 頂層 EditorConfig 設定
root = true

[*]
indent_style = space
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{csproj,props,targets,xaml,xml}]
indent_size = 2

[*.ps1]
charset = utf-8-bom
indent_size = 4

[*.cs]
# 基本排版格式
indent_size = 4
end_of_line = crlf

# C# 風格
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_prefer_simple_using_statement = true:warning
csharp_style_prefer_readonly_struct_member = true:warning
csharp_style_prefer_switch_expression = true:warning
csharp_style_prefer_pattern_matching = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_extended_property_pattern = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_style_expression_bodied_properties = when_on_single_line:warning
csharp_style_expression_bodied_accessors = when_on_single_line:warning
csharp_style_expression_bodied_constructors = never:warning
csharp_style_expression_bodied_operators = when_on_single_line:warning
csharp_style_expression_bodied_indexers = when_on_single_line:warning
csharp_prefer_static_local_function = true:warning
csharp_style_inlined_variable_declaration = true:warning
csharp_style_deconstructed_variable_declaration = true:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning

# 括號：依 Microsoft 建議，以可讀性優先
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_relational_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_other_binary_operators = always_for_clarity:warning
dotnet_style_parentheses_in_other_operators = never_if_unnecessary:warning

dotnet_style_require_accessibility_modifiers = always:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_explicit_tuple_names = true:warning
dotnet_style_namespace_match_folder = true:warning

# 未使用 / 死碼 / 冗餘程式碼（支援 dotnet format 自動修復）
dotnet_diagnostic.IDE0051.severity = error
dotnet_diagnostic.IDE0052.severity = error
dotnet_diagnostic.IDE0059.severity = error
dotnet_diagnostic.IDE0060.severity = error
dotnet_diagnostic.IDE0079.severity = warning
dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0004.severity = error
dotnet_diagnostic.IDE0071.severity = warning
dotnet_diagnostic.IDE0075.severity = warning
dotnet_diagnostic.IDE0080.severity = warning
dotnet_diagnostic.IDE0110.severity = warning
dotnet_diagnostic.IDE0150.severity = warning

# 命名 / 可維護性
dotnet_diagnostic.IDE0001.severity = warning
dotnet_diagnostic.IDE0002.severity = warning
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE1006.severity = warning

# .NET Code Quality
dotnet_diagnostic.CA1823.severity = error
dotnet_diagnostic.CA1305.severity = error

# 可靠性
dotnet_diagnostic.CA2000.severity = error
dotnet_diagnostic.CA2007.severity = error
dotnet_diagnostic.CA2016.severity = error
dotnet_diagnostic.CA2017.severity = error
dotnet_diagnostic.CA2020.severity = error

# 效能
dotnet_diagnostic.CA1849.severity = error

# 現代語法風格
dotnet_style_prefer_simplified_interpolation = true:warning
csharp_style_prefer_collection_expression = when_types_exact_match:warning
csharp_style_prefer_null_check_over_type_check = true:warning
csharp_style_prefer_utf8_string_literals = true:warning

# 安全性：所有已啟用的 Security 規則視為 error
dotnet_analyzer_diagnostic.category-Security.severity = error

# 專案類型例外（UI 專案與測試專案）
# WinUI 3 UI 需要 SynchronizationContext，且 XAML 標記事件處理器無法由 C# 靜態語法樹探知，排除 IDE0051/IDE0052/IDE0060 避免 dotnet format 誤刪事件處理常式與未使用引數。
[src/MinecraftServerManager.App/**.cs]
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.IDE0051.severity = none
dotnet_diagnostic.IDE0052.severity = none
dotnet_diagnostic.IDE0060.severity = none

# Tests 測試專案排除非必要約束
[tests/**.cs]
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2000.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.xUnit1051.severity = none
