{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "prHourlyLimit": 10,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "labels": [
        "dependencies"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "breaking-change"
      ]
    },
    {
      "groupName": ".NET ecosystem",
      "matchManagers": [
        "nuget"
      ],
      "matchFileNames": [
        "Directory.Packages.props",
        "src/**",
        "tests/**"
      ]
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": [
        "github-actions"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "prConcurrentLimit": 3,
    "vulnerabilityFixStrategy": "lowest"
  },
  "dependencyDashboard": true,
  "prCreation": "not-pending",
  "timezone": "Asia/Taipei"
}